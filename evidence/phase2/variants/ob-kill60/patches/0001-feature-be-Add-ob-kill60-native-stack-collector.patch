+    int signal_method = SIGNAL_METHOD_NONE;
+    int rt_signal_errno = 0;
+    int tgkill_errno = 0;
+    int frame_count = 0;
+    bool truncated = false;
+    bool release_timeout = false;
+    std::array<uintptr_t, kMaxSignalFrames> frames {};
