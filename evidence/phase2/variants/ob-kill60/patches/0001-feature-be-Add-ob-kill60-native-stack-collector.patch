+enum SlotState : int {
+    SLOT_PENDING = 0,
+    SLOT_CAPTURING = 1,
+    SLOT_CAPTURED = 2,
+    SLOT_DONE = 3,
+    SLOT_SIGNAL_FAILED = 4,
+    SLOT_TIMEOUT = 5,
+    SLOT_UNSUPPORTED = 6,
+    SLOT_SIGNAL_BLOCKED = 7,
+    SLOT_SKIPPED_SELF = 8,
+};
+
+enum SignalMethod : int {
+    SIGNAL_METHOD_NONE = 0,
+    SIGNAL_METHOD_RT_TGSIGQUEUEINFO = 1,
+    SIGNAL_METHOD_TGKILL = 2,
+};
+
+struct ThreadCaptureSlot {
+    int64_t tid = 0;
+    std::atomic<int> state {SLOT_PENDING};
+    std::atomic<int> release_requested {0};
+    std::atomic<int64_t> handler_time_ns {0};
