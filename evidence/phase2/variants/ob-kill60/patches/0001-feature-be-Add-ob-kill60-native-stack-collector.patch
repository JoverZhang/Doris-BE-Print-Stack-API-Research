+
+void native_stack_signal_handler(int, siginfo_t* signal_info, void* raw_context) {
+    const uint64_t handler_start_ns = monotonic_ns_for_signal();
+    DumpSession* session = s_active_session.load(std::memory_order_acquire);
+    if (session == nullptr) {
+        return;
+    }
+
+    if (signal_info != nullptr) {
+        const uintptr_t request_id = reinterpret_cast<uintptr_t>(signal_info->si_value.sival_ptr);
+        if (request_id != 0 && request_id != session->request_id) {
+            return;
+        }
+    }
+
+    const int64_t tid = static_cast<int64_t>(syscall(SYS_gettid));
+    ThreadCaptureSlot* slot = find_slot_for_tid(session, tid);
+    if (slot == nullptr) {
+        return;
+    }
+
+    int expected = SLOT_PENDING;
+    if (!slot->state.compare_exchange_strong(expected, SLOT_CAPTURING, std::memory_order_acq_rel)) {
+        return;
+    }
+
+#if defined(__x86_64__)
+    int frame_count = 0;
+    auto* context = reinterpret_cast<unw_context_t*>(raw_context);
+    unw_cursor_t cursor;
+    if (context != nullptr && unw_init_local2(&cursor, context, UNW_INIT_SIGNAL_FRAME) == 0) {
+        do {
+            unw_word_t ip = 0;
+            if (unw_get_reg(&cursor, UNW_REG_IP, &ip) < 0) {
+                break;
+            }
+            if (ip != 0) {
+                slot->frames[static_cast<size_t>(frame_count)] = static_cast<uintptr_t>(ip);
+                ++frame_count;
+            }
+        } while (frame_count < session->max_frames && unw_step(&cursor) > 0);
+    }
+
+    slot->frame_count = frame_count;
+    slot->truncated = frame_count >= session->max_frames;
+    const uint64_t handler_captured_ns = monotonic_ns_for_signal();
+    if (handler_start_ns > 0 && handler_captured_ns >= handler_start_ns) {
+        slot->handler_time_ns.store(static_cast<int64_t>(handler_captured_ns - handler_start_ns),
+                                    std::memory_order_relaxed);
+    }
+    slot->state.store(SLOT_CAPTURED, std::memory_order_release);
+
+    while (slot->release_requested.load(std::memory_order_acquire) == 0) {
+        const uint64_t now_ns = monotonic_ns_for_signal();
+        if (session->handler_deadline_ns > 0 && now_ns >= session->handler_deadline_ns) {
+            slot->release_timeout = true;
+            break;
+        }
+    }
+
+    const uint64_t handler_end_ns = monotonic_ns_for_signal();
+    if (handler_start_ns > 0 && handler_end_ns >= handler_start_ns) {
+        slot->pause_time_ns.store(static_cast<int64_t>(handler_end_ns - handler_start_ns),
+                                  std::memory_order_relaxed);
+    }
+    int captured = SLOT_CAPTURED;
+    slot->state.compare_exchange_strong(captured, SLOT_DONE, std::memory_order_acq_rel);
+#else
+    slot->state.store(SLOT_UNSUPPORTED, std::memory_order_release);
+#endif
+}
+
+void install_signal_handler_once() {
+    std::call_once(s_signal_install_once, [] {
+        if (native_stack_signal_number() <= 0 || native_stack_signal_number() > SIGRTMAX) {
+            LOG(ERROR) << "native stack signal " << native_stack_signal_number()
+                       << " is outside the realtime signal range";
+            return;
+        }
+
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            s_signal_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack signal handler: " << std::strerror(errno);
+        }
+    });
+}
+
+void mark_signal_failure(ThreadCaptureSlot* slot) {
+    slot->state.store(SLOT_SIGNAL_FAILED, std::memory_order_release);
+}
+
+void send_capture_signal(pid_t pid, ThreadCaptureSlot* slot, uintptr_t request_id) {
+    siginfo_t signal_info {};
+    signal_info.si_code = SI_QUEUE;
+    signal_info.si_pid = pid;
+    signal_info.si_uid = getuid();
+    signal_info.si_value.sival_ptr = reinterpret_cast<void*>(request_id);
+
+    const long rt_result = syscall(SYS_rt_tgsigqueueinfo, pid, static_cast<pid_t>(slot->tid),
+                                   native_stack_signal_number(), &signal_info);
+    if (rt_result == 0) {
+        slot->signal_method = SIGNAL_METHOD_RT_TGSIGQUEUEINFO;
+        return;
+    }
+    slot->rt_signal_errno = errno;
+
+    const long tgkill_result =
+            syscall(SYS_tgkill, pid, static_cast<pid_t>(slot->tid), native_stack_signal_number());
+    if (tgkill_result == 0) {
+        slot->signal_method = SIGNAL_METHOD_TGKILL;
+        return;
+    }
+    slot->tgkill_errno = errno;
+    mark_signal_failure(slot);
+}
+
+uint64_t handler_deadline_ns_for_options(const RequestOptions& options) {
+    const uint64_t now = monotonic_ns_for_signal();
+    if (now == 0) {
+        return 0;
+    }
+    return now + static_cast<uint64_t>(options.timeout_ms) * 1000000ULL;
+}
+
+bool collect_thread_frames(ThreadCaptureSlot* slots, size_t slot_count, int max_frames,
+                           const RequestOptions& options,
+                           std::chrono::steady_clock::time_point start) {
+    DumpSession session;
+    session.slots = slots;
+    session.slot_count = slot_count;
+    session.max_frames = max_frames;
+    session.request_id = s_next_request_id.fetch_add(1, std::memory_order_relaxed);
+    if (session.request_id == 0) {
+        session.request_id = s_next_request_id.fetch_add(1, std::memory_order_relaxed);
+    }
+    session.handler_deadline_ns = handler_deadline_ns_for_options(options);
+
+    s_active_session.store(&session, std::memory_order_release);
+    const pid_t pid = getpid();
+    for (size_t i = 0; i < slot_count; ++i) {
+        if (slots[i].state.load(std::memory_order_acquire) != SLOT_PENDING) {
+            continue;
+        }
+        send_capture_signal(pid, &slots[i], session.request_id);
+    }
+
+    const auto deadline = start + std::chrono::milliseconds(options.timeout_ms);
+    while (std::chrono::steady_clock::now() < deadline) {
+        bool all_done = true;
+        for (size_t i = 0; i < slot_count; ++i) {
+            if (!state_finished_phase_one(slots[i].state.load(std::memory_order_acquire))) {
+                all_done = false;
+                break;
+            }
+        }
+        if (all_done) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    for (size_t i = 0; i < slot_count; ++i) {
+        slots[i].release_requested.store(1, std::memory_order_release);
+        int pending = SLOT_PENDING;
+        slots[i].state.compare_exchange_strong(pending, SLOT_TIMEOUT, std::memory_order_acq_rel);
+    }
+
+    const auto release_deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(5);
+    while (std::chrono::steady_clock::now() < release_deadline) {
+        bool all_released = true;
+        for (size_t i = 0; i < slot_count; ++i) {
+            const int state = slots[i].state.load(std::memory_order_acquire);
+            if (state == SLOT_CAPTURING || state == SLOT_CAPTURED) {
+                all_released = false;
+                break;
+            }
+        }
+        if (all_released) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    s_active_session.store(nullptr, std::memory_order_release);
+
+    bool has_unfinished_handler = false;
+    for (size_t i = 0; i < slot_count; ++i) {
+        const int state = slots[i].state.load(std::memory_order_acquire);
+        has_unfinished_handler =
+                has_unfinished_handler || state == SLOT_CAPTURING || state == SLOT_CAPTURED;
+    }
+    return has_unfinished_handler;
+}
+
+std::string signal_method_name(int signal_method) {
+    switch (signal_method) {
+    case SIGNAL_METHOD_RT_TGSIGQUEUEINFO:
+        return "rt_tgsigqueueinfo";
+    case SIGNAL_METHOD_TGKILL:
+        return "tgkill";
+    default:
+        return "none";
+    }
+}
+
+std::string slot_status(const ThreadCaptureSlot& slot) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_CAPTURED:
+    case SLOT_DONE:
+        return "ok";
+    case SLOT_SIGNAL_FAILED:
+        if (slot.rt_signal_errno == ESRCH || slot.tgkill_errno == ESRCH) {
+            return "exited_thread";
+        }
+        return "signal_failed";
+    case SLOT_TIMEOUT:
+    case SLOT_CAPTURING:
+        return "timeout";
+    case SLOT_UNSUPPORTED:
+        return "unsupported_arch";
+    case SLOT_SIGNAL_BLOCKED:
+        return "signal_blocked";
+    case SLOT_SKIPPED_SELF:
+        return "skipped_self";
+    default:
+        return "pending";
+    }
+}
+
+std::string slot_error_reason(const ThreadCaptureSlot& slot) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_CAPTURED:
+    case SLOT_DONE:
+        if (slot.frame_count == 0) {
+            return "libunwind returned no PCs";
+        }
+        if (slot.release_timeout) {
+            return "handler release wait exceeded timeout";
+        }
+        return "";
+    case SLOT_SIGNAL_FAILED: {
+        std::ostringstream out;
+        out << "rt_tgsigqueueinfo failed: "
+            << (slot.rt_signal_errno == 0 ? "not attempted" : std::strerror(slot.rt_signal_errno))
+            << "; tgkill failed: "
+            << (slot.tgkill_errno == 0 ? "not attempted" : std::strerror(slot.tgkill_errno));
+        return out.str();
+    }
+    case SLOT_TIMEOUT:
+        return "thread did not enter native stack signal handler before timeout";
+    case SLOT_CAPTURING:
+        return "thread did not finish native stack signal handler before timeout";
+    case SLOT_UNSUPPORTED:
+        return "ob-kill60 collector supports Linux x86_64 only";
+    case SLOT_SIGNAL_BLOCKED:
+        return "thread blocks signal 60";
+    case SLOT_SKIPPED_SELF:
+        return "coordinator thread is not interrupted by the two-phase collector";
+    default:
+        return "unexpected pending state";
+    }
+}
