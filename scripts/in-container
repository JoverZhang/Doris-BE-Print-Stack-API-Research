#!/usr/bin/env bash
# Reason: a single env for every git and build op against the phase2 worktree.
# Mounting the project root at its host path inside the container keeps git's
# .git pointers resolving the same way on both sides, so no shim is needed.
# Local: thin wrapper around podman run; passes its args to bash inside the
# container (script path + optional script args).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CCACHE_DIR="${CCACHE_DIR:-${ROOT}/.tmp/ccache}"
CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-50G}"

mkdir -p "${CCACHE_DIR}"

exec podman run --rm \
    -v "${ROOT}:${ROOT}" \
    -w "${ROOT}" \
    -e DORIS_THIRDPARTY=/var/local/thirdparty \
    -e PROJECT_ROOT="${ROOT}" \
    -e BUILD_TYPE_UT="${BUILD_TYPE_UT:-}" \
    -e PHASE2_UT_JOBS="${PHASE2_UT_JOBS:-}" \
    -e CCACHE_DIR="${CCACHE_DIR}" \
    -e CCACHE_MAXSIZE="${CCACHE_MAXSIZE}" \
    -e CCACHE_BASEDIR="${ROOT}" \
    -e CCACHE_NOHASHDIR=true \
    docker.io/apache/doris:build-env-ldb-toolchain-latest \
    bash "$@"
