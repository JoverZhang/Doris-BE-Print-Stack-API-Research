+// Reason: snapshot-remote-unwind is the only Round-2 variant whose
+// handler does NOT call libunwind. The handler copies the interrupted
+// thread's ucontext_t plus a bounded slice of its stack into a per-
+// sequence slot and returns. The coordinator then runs libunwind in
+// remote mode (`unw_init_remote`) against the slot's snapshot, in the
+// request thread, where DWARF unwind info lookups via `dl_iterate_phdr`
+// are safe. The PHDR cache override (patches 1+2) is still shipped so
+// the coordinator's `dl_iterate_phdr` walks the cached list rather than
+// holding the loader lock for tens-of-thousands of times across a many-
+// thread dump.
+//
+// The remote API requires the variant-specific `_Ux86_64_*` symbols
+// (not the local-only `_ULx86_64_*` set ck-phdr-unwind and ob-kill60
+// link against). The build-system patch adds the `libunwind-generic` /
+// `libunwind-x86_64` archive and its lzma dependency to the BE link;
+// this TU includes libunwind.h WITHOUT the `UNW_LOCAL_ONLY` define the
+// other two variants use, so the include resolves to the remote API.
+// Spec: docs/phase2-design.md "Variant Mechanics -> snapshot-remote-unwind".
+// Reference: libunwind tests/test-static-link-gen.c (the libunwind test
+// suite's in-process remote-unwind pattern: custom accessors,
+// dwarf_search_unwind_table for find_proc_info, direct memory reads),
+// <ck>'s phdr_cache.cpp (the same lock-free dl_iterate_phdr override
+// pattern this variant inherits via patches 1+2).
+#include <glog/logging.h>
+#include <libunwind.h>
+#include <signal.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/uio.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include <algorithm>
