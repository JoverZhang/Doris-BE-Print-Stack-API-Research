+
+// Reason: the per-thread `CaptureFn` `run_collection` drives. Claims a
+// per-sequence slot, queues the signal, waits for the handler to
+// publish DONE, runs libunwind in remote mode against the slot's
+// snapshot, then disarms the slot. On timeout it drains briefly so a
+// late handler can transition out of WALKING before the slot is
+// reported leaked.
+// Spec: docs/phase2-design.md "Variant Mechanics -> snapshot-remote-unwind".
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:381-384
+//   (sequential per-thread signaling; the libunwind-class variants
+//   inherit this shape from the fp-walk / ck-phdr-unwind template).
+void snapshot_remote_unwind_capture(int64_t tid, const CollectOptions& opts,
+                                    std::chrono::steady_clock::time_point deadline,
+                                    ThreadStack* out) {
+    // 0. Defense-in-depth deadline guard. `run_collection` short-
+    //    circuits expired deadlines before reaching here, but a direct
+    //    caller that skipped the guard would otherwise queue a signal
+    //    the wait loop has no time to receive — creating exactly the
+    //    stale-handler hazard the per-sequence slot was added to defend
+    //    against.
+    if (std::chrono::steady_clock::now() >= deadline) {
+        out->status = "timeout";
+        out->error_reason = "dump deadline expired before signaling this thread";
+        return;
+    }
+
+    // 1. A thread that blocks the collector signal would never run the
+    //    handler. Report `signal_blocked` so the dump distinguishes it
+    //    from a slow thread that should time out.
+    if (is_signal_blocked(tid, native_stack_signal_number())) {
+        out->status = "signal_blocked";
+        out->error_reason = "thread blocks the native stack signal";
+        return;
+    }
+    install_handler_once();
+    if (!g_installed.load(std::memory_order_acquire)) {
+        out->status = "signal_failed";
+        out->error_reason = "native stack signal handler is unavailable";
+        return;
+    }
+
+    // 1a. Refuse to signal if the PHDR cache is not populated. The
+    //     coordinator's `unw_step` reaches `dl_iterate_phdr` to find
+    //     eh_frame for the captured IP; without the populated cache
+    //     the override falls through to the libc function and takes
+    //     the loader lock. The test runner calls `updatePHDRCache()`
+    //     before RUN_ALL_TESTS and `doris_main` calls it after
+    //     MemInfo::init (patch 2), so this is a defense-in-depth
+    //     guard, not the normal path.
+    if (!hasPHDRCache()) {
+        out->status = "phdr_cache_missing";
+        out->error_reason = "PHDR cache not populated; refusing to enter libunwind remote";
+        return;
+    }
+
+    // 2. Claim a per-sequence slot via CAS IDLE -> PENDING. Failure
+    //    means a late handler from seq-N still holds this slot.
+    const uint64_t seq = g_seq.fetch_add(1, std::memory_order_relaxed) + 1;
+    CaptureSlot& slot = slot_for_seq(seq);
+    int expected_state = SLOT_IDLE;
+    if (!slot.state.compare_exchange_strong(expected_state, SLOT_PENDING,
+                                            std::memory_order_acq_rel)) {
+        out->status = "slot_busy";
+        out->error_reason =
+                "snapshot-remote-unwind slot held by a late handler from a prior dump";
+        return;
+    }
+    slot.max_stack_bytes = static_cast<size_t>(opts.max_stack_bytes);
+    slot.stack_base = 0;
+    slot.stack_size = 0;
+    slot.handler_ns.store(0, std::memory_order_relaxed);
+    // Reason: the release on `expected_seq` publishes all the slot
+    // setup above so the handler's acquire load sees a fully
+    // initialized slot.
+    slot.expected_seq.store(seq, std::memory_order_release);
+
+    // 3. Queue the signal with the token in `si_value.sival_ptr`
+    //    (SI_QUEUE, this process).
+    siginfo_t info {};
+    info.si_signo = native_stack_signal_number();
+    info.si_code = SI_QUEUE;
+    info.si_pid = getpid();
+    info.si_uid = getuid();
+    info.si_value.sival_ptr = reinterpret_cast<void*>(static_cast<uintptr_t>(seq));
+    const long rc = syscall(SYS_rt_tgsigqueueinfo, getpid(), static_cast<pid_t>(tid),
+                            native_stack_signal_number(), &info);
+    if (rc != 0) {
+        const int err = errno;
+        slot.expected_seq.store(0, std::memory_order_release);
+        int from = SLOT_PENDING;
+        slot.state.compare_exchange_strong(from, SLOT_IDLE, std::memory_order_acq_rel);
+        out->status = err == ESRCH ? "exited_thread" : "signal_failed";
+        out->error_reason = std::string("rt_tgsigqueueinfo failed: ") + std::strerror(err);
+        return;
+    }
+
+    // 4. Wait for the handler to publish DONE, or for the dump
+    //    deadline.
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (slot.state.load(std::memory_order_acquire) == SLOT_DONE) {
+            break;
+        }
+        // Reason: 200 microseconds polls often enough to keep the next
+        // thread moving without burning a core on a busy yield. Same
+        // cadence as ck-phdr-unwind / ob-kill60.
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+
+    // 5. On success run libunwind remote against the snapshot. On
+    //    timeout drain briefly and disarm.
+    if (slot.state.load(std::memory_order_acquire) == SLOT_DONE) {
+        // 5a. Install snapshot accessors and unwind. The accessors
+        //     read registers from `slot.regs` (passed as `arg` to
+        //     `unw_init_remote`) and stack bytes from `slot.stack_*`
+        //     via the thread-local hand-off.
+        unw_accessors_t accessors {};
+        accessors.find_proc_info = snapshot_find_proc_info;
+        accessors.put_unwind_info = snapshot_put_unwind_info;
+        accessors.get_dyn_info_list_addr = snapshot_get_dyn_info_list_addr;
+        accessors.access_mem = snapshot_access_mem;
+        accessors.access_reg = snapshot_access_reg;
+        accessors.access_fpreg = snapshot_access_fpreg;
+        accessors.resume = snapshot_resume;
+        accessors.get_proc_name = snapshot_get_proc_name;
+        unw_addr_space_t addr_space = unw_create_addr_space(&accessors, 0);
+        if (addr_space == nullptr) {
+            out->status = "unwind_failed";
+            out->error_reason = "unw_create_addr_space returned null";
+        } else {
+            tls_active_slot = &slot;
+            unw_cursor_t cursor;
+            const int init_rc = unw_init_remote(&cursor, addr_space, &slot.regs);
+            if (init_rc == 0) {
+                const int max_frames = static_cast<int>(
+                        std::min<int64_t>(opts.max_frames, kMaxRemoteFrames));
+                int n = 0;
+                out->frames.reserve(static_cast<size_t>(max_frames));
+                do {
+                    if (n >= max_frames) {
+                        break;
+                    }
+                    unw_word_t ip = 0;
+                    if (unw_get_reg(&cursor, UNW_REG_IP, &ip) != 0) {
+                        break;
+                    }
+                    if (ip == 0) {
+                        break;
+                    }
+                    Frame frame;
+                    frame.pc = static_cast<uintptr_t>(ip);
+                    out->frames.push_back(frame);
+                    ++n;
+                } while (unw_step(&cursor) > 0);
+                // Reason: same truncation approximation as the other
+                // variants — over-reports when the chain is exactly
+                // `max_frames` deep, but cheap and correct for the
+                // case 9 / Truncated test.
+                out->truncated = n == max_frames;
+                out->handler_time_ns = slot.handler_ns.load(std::memory_order_relaxed);
+                out->status = "ok";
+            } else {
+                out->status = "unwind_failed";
+                out->error_reason =
+                        std::string("unw_init_remote failed: rc=") + std::to_string(init_rc);
+            }
+            tls_active_slot = nullptr;
+            unw_destroy_addr_space(addr_space);
+        }
+        // Reason: disarm `expected_seq` before releasing the slot to
+        // IDLE so a stale late-handler from this request cannot claim
+        // the next coordinator's PENDING slot through the IDLE ->
+        // PENDING -> store(NEW) window. Mirrors the timeout path
+        // below and matches the codex-driven fix shared by all sibling
+        // variants (commit 2a00713 on phase2-spec-restructure).
+        slot.expected_seq.store(0, std::memory_order_release);
+        slot.state.store(SLOT_IDLE, std::memory_order_release);
+    } else {
+        slot.expected_seq.store(0, std::memory_order_release);
+        // 5b. Drain briefly so a mid-walk handler can finish. The
+        //     handler's post-walk re-check will see `seq != expected_seq`
+        //     and store SLOT_IDLE.
+        const auto drain_deadline = std::chrono::steady_clock::now() +
+                                    std::chrono::milliseconds(kHandlerDrainBudgetMs);
+        while (std::chrono::steady_clock::now() < drain_deadline) {
+            const int s = slot.state.load(std::memory_order_acquire);
+            if (s == SLOT_IDLE || s == SLOT_DONE || s == SLOT_PENDING) {
+                break;
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds(200));
+        }
+        // 5c. If the handler never entered, the state is still PENDING.
+        //     CAS it back to IDLE. If CAS fails the handler just
+        //     entered; it will transition the state on its own.
+        int from_pending = SLOT_PENDING;
+        slot.state.compare_exchange_strong(from_pending, SLOT_IDLE,
+                                           std::memory_order_acq_rel);
+        // 5d. If the handler published DONE during the drain, release
+        //     the slot. We still report timeout because the dump
+        //     deadline already passed.
+        int from_done = SLOT_DONE;
+        slot.state.compare_exchange_strong(from_done, SLOT_IDLE,
+                                           std::memory_order_acq_rel);
+        out->status = "timeout";
+        out->error_reason = "thread did not run the native stack handler before the deadline";
+    }
 }
 
