+// Reason: the slot pointer the active coordinator is unwinding from.
+// Set just before `unw_init_remote` and cleared after
+// `unw_destroy_addr_space`, so `snapshot_access_mem` can read stack
+// words from the slot's buffer without changing the public
+// ucontext-shaped `arg` libunwind passes around.
+// Local: snapshot-remote-unwind-specific TLS hand-off.
+thread_local CaptureSlot* tls_active_slot = nullptr;
+
+// Reason: libunwind asks `access_mem` for one word of "target" memory.
+// In remote-mode-against-same-process we can satisfy stack reads from
+// the captured snapshot (so a snapshot whose target thread is long
+// gone still walks) AND fall through to a live in-process read for
+// non-stack addresses (eh_frame / unwind tables / DSO data — those
+// pages still belong to the coordinator's own process and are
+// trivially safe to dereference). Live reads are how the local
+// libunwind path resolves these too.
+// Reference: libunwind tests/test-static-link-gen.c shows the same
+// "stack from snapshot, code from live process" pattern; coredump
+// helpers in libunwind-coredump.a serve the same role for a real
+// coredump's segments.
+int snapshot_access_mem(unw_addr_space_t /*as*/, unw_word_t addr, unw_word_t* valp,
+                        int write, void* arg) {
+    if (write != 0) {
+        return -UNW_EREADONLYREG;
+    }
+    if (valp == nullptr || arg == nullptr) {
+        return -UNW_EINVAL;
+    }
+    // `arg` is the ucontext_t pointer we passed to `unw_init_remote`,
+    // not the slot. We instead pass the slot pointer through
+    // `tls_active_slot`, which the coordinator sets before calling
+    // libunwind. This keeps the public ucontext shape untouched and
+    // lets `access_mem` serve stack words from the snapshot.
+    const CaptureSlot* slot = tls_active_slot;
+    const uintptr_t a = static_cast<uintptr_t>(addr);
+    if (slot != nullptr && slot->stack_size > 0) {
+        const uintptr_t snap_lo = slot->stack_base;
+        const uintptr_t snap_hi = slot->stack_base + slot->stack_size;
+        if (a >= snap_lo && a + sizeof(unw_word_t) <= snap_hi) {
+            unw_word_t word = 0;
+            const size_t off = static_cast<size_t>(a - snap_lo);
+            std::memcpy(&word, slot->stack_bytes + off, sizeof(word));
+            *valp = word;
+            return 0;
+        }
+        // Reason: an address at or above the captured RSP that falls
+        // OUTSIDE the snapshot's tail is a stack address whose live
+        // value has been mutated by the still-running target thread
+        // since the snapshot was taken. Falling through to a live
+        // read would serve libunwind a value inconsistent with the
+        // captured frame; that breaks `unw_step` non-determinism
+        // (KnownChainResolved flakes intermittently with libunwind
+        // walking into "extra" frames that were never on the
+        // captured stack). Fail closed here: libunwind interprets
+        // -UNW_EINVAL as "memory access failed", terminates the
+        // walk, and reports the frames it found so far. This
+        // converts the silent inconsistency into a clean truncation
+        // at the snapshot boundary.
+        // Local: snapshot-remote-unwind-specific consistency guard.
+        if (a >= snap_lo) {
+            return -UNW_EINVAL;
+        }
+    }
+    // Below the captured RSP: code/eh_frame/data in our own DSO
+    // segments, safe to read live. mincore guards against an
+    // out-of-range address.
+    if (!page_is_mapped(a)) {
+        return -UNW_EINVAL;
+    }
+    unw_word_t word = 0;
+    std::memcpy(&word, reinterpret_cast<const void*>(a), sizeof(word));
+    *valp = word;
+    return 0;
+}
