 #include "service/http/action/native_stack.h"
 
-// Reason: the per-variant collect step. The common build ships this stub;
-// each variant patch (fp-walk, ck-phdr-unwind, ...) rewrites only this file
-// with its real collector, so every other file in the seam stays put.
-// Spec: docs/phase2-design.md "Common API" -> stub collect().
 namespace doris::native_stack {
 namespace {
 
-// Reason: the stub proves the response shape and the single-dump gate
-// without real signaling — every live thread reports `ok` with no frames.
-// `run_collection` owns the gate, tid selection, and aggregation, so the
-// stub only fills status.
-void stub_capture(int64_t /*tid*/, const CollectOptions& /*opts*/,
-                  std::chrono::steady_clock::time_point /*deadline*/, ThreadStack* out) {
-    out->status = "ok";
+// Reason: caps the coordinator's unwind walk. A runaway `unw_step` chain
+// would otherwise build an unbounded `out->frames` vector. Sized to the
+// CollectOptions::max_frames upper bound.
+// Local: snapshot-remote-unwind-specific cap.
+constexpr int kMaxRemoteFrames = 1024;
+
+// Reason: the slot ring size. Per-sequence slots prevent a late handler
+// at seq=K from clobbering the next dump's writes at seq=K+1. N=4
+// matches fp-walk / ck-phdr-unwind / ob-kill60 so the four variants'
+// contention envelopes stay comparable.
+// Local: snapshot-remote-unwind-specific bound; mirrors siblings.
+constexpr int kSlotRingSize = 4;
+
+// Reason: handler-drain budget on the timeout path; bounded so a stuck
+// handler does not extend the whole dump's wall clock.
+// Local: snapshot-remote-unwind-specific cadence; mirrors siblings.
+constexpr int64_t kHandlerDrainBudgetMs = 50;
+
+// Reason: hard ceiling on the stack bytes the handler will copy. Sized
+// generously so case 9 (`Truncated`, deep recursion to 32 frames) and
+// case 8 (`KnownChainResolved`, 4-level chain at -O0) both fit even
+// with the test's max_stack_bytes raised to 1 MiB. The handler still
+// caps each copy at min(opts.max_stack_bytes, kMaxStackBytes), so a
+// caller that requests less gets less; the ceiling is here so the
+// slot's stack buffer has a fixed size known at compile time.
+// Local: snapshot-remote-unwind-specific buffer size.
+constexpr size_t kMaxStackBytes = 1 << 20; // 1 MiB
+
+// Reason: SIGRTMIN+6 is the same realtime signal the other variants
+// queue, so the test binary's `SignalBlocked` case (case 10) blocks
+// one number across the suite.
+int native_stack_signal_number() {
+    return SIGRTMIN + 6;
+}
+
+int64_t monotonic_ns() {
+    timespec ts {};
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return 0;
+    }
+    return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + static_cast<int64_t>(ts.tv_nsec);
+}
+
+// Reason: the slot's state machine. Same shape as fp-walk / ck-phdr-
+// unwind / ob-kill60, so the late-handler safety contract is the same:
+// a coordinator can only re-arm a slot in IDLE, so a slot held by a
+// late WALKING handler is never re-armed under it. (For snapshot-
+// remote-unwind the handler's WALKING phase is brief — it only copies
+// registers + stack bytes — but the contract still applies because the
+// coordinator runs libunwind AFTER the handler has published DONE.)
+// Local: snapshot-remote-unwind-specific state machine; mirrors siblings.
+enum SlotState : int {
+    SLOT_IDLE = 0,
+    SLOT_PENDING = 1,
+    SLOT_WALKING = 2,
+    SLOT_DONE = 3,
+};
+
+// Reason: one snapshot capture slot. The handler writes the captured
+// ucontext_t into `regs` and up to `kMaxStackBytes` of the interrupted
+// thread's stack into `stack_bytes`. The coordinator reads from these
+// fields to feed libunwind's remote-mode accessors after the handler
+// has returned. Frame storage is the coordinator's local
+// `out->frames`, not the slot — keeping the slot purely "what the
+// handler captured" means an extension to richer captured state
+// (FPU regs, signal mask, etc.) does not bloat the slot's frame
+// array. Slots live for the process lifetime so a late handler that
+// reaches the write step never dereferences a dangling pointer.
+// Spec: docs/phase2-design.md "Variant Mechanics -> snapshot-remote-unwind".
+// Reference: libunwind tests use a `struct { ucontext_t ctx; uint8_t
+// stack[]; }` shape; this layout transcribes the same idea.
+struct CaptureSlot {
+    // Reason: request token. A handler whose `seq` does not match this
+    // value drops at entry, mirroring CK / OB / fp-walk's check.
+    std::atomic<uint64_t> expected_seq {0};
+    // Reason: slot state machine field. See SlotState above.
+    std::atomic<int> state {SLOT_IDLE};
+    // Reason: requested stack-byte cap published by the coordinator
+    // before queueing the signal; read by the handler to bound its
+    // copy. `kMaxStackBytes` is the absolute ceiling regardless of
+    // this value.
+    size_t max_stack_bytes = 0;
+    // Reason: the captured registers. On x86_64 `unw_tdep_context_t`
+    // is `ucontext_t`, so this slot's `regs` doubles as the
+    // `unw_context_t` libunwind reads from in remote mode.
+    // Reference: thirdparty libunwind/include/libunwind-x86_64.h
+    //   `typedef ucontext_t unw_tdep_context_t;`.
+    ucontext_t regs {};
+    // Reason: the base of the captured stack range. The handler reads
+    // RSP from the interrupted ucontext and copies `[RSP, RSP+n)`
+    // here, recording the count in `stack_size`.
+    uintptr_t stack_base = 0;
+    size_t stack_size = 0;
+    // Reason: the captured stack bytes themselves. `access_mem` in the
+    // coordinator serves any address in `[stack_base, stack_base +
+    // stack_size)` from this buffer, returning -EINVAL outside the
+    // window so libunwind falls through to its own DWARF chase.
+    uint8_t stack_bytes[kMaxStackBytes] {};
+    // Reason: handler wall time. Reported as `handler_time_ns` in the
+    // per-thread JSON entry.
+    std::atomic<int64_t> handler_ns {0};
+};
+
+// Reason: the per-sequence slot ring. A coordinator arming at seq=K
+// targets `g_slots[(K-1) % N]`; seqs K and K+1 cannot collide.
+// Local: snapshot-remote-unwind-specific storage; see kSlotRingSize.
+CaptureSlot g_slots[kSlotRingSize];
+
+// Reason: monotonic sequence number that rides in the signal payload
+// as the dump's request token. Same role as ck-phdr-unwind's `g_seq`
+// and OB's `req_id`.
+std::atomic<uint64_t> g_seq {0};
+
+std::once_flag g_install_once;
+std::atomic<bool> g_installed {false};
+
+CaptureSlot& slot_for_seq(uint64_t seq) {
+    return g_slots[(seq - 1) % kSlotRingSize];
+}
+
+bool parse_hex_u64(const std::string& value, uint64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uint64_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: a thread that blocks the collector signal would never run the
+// handler. Report it as `signal_blocked` so the dump distinguishes it
+// from a slow thread that should time out.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:294-326
+//   (CK's `isSignalBlocked` reads `SigBlk:` from /proc the same way).
+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
+
+// Reason: `mincore` reports whether a page is resident; if it is, it is
+// also mapped. The handler uses this as a defense against an unmapped
+// or guard-page stack frame: a coordinator running with an absurd
+// `max_stack_bytes` against a thread parked just above a guard page
+// would otherwise SIGSEGV inside `memcpy`. fp-walk uses the same
+// check for the same reason on its RBP walk; we re-use it here to
+// gate the first page of the copy. Subsequent pages within the stack
+// are assumed contiguous (stack growth is well-defined on x86_64).
+// Local: snapshot-remote-unwind-specific safety check; mirrors fp-walk's
+// page-mapping guard.
+// Reference: mincore(2); fp-walk's `page_is_mapped` helper.
+bool page_is_mapped(uintptr_t addr) {
+    const long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        return false;
+    }
+    const uintptr_t page_start = addr & ~(static_cast<uintptr_t>(page_size) - 1);
+    unsigned char vec = 0;
+    if (mincore(reinterpret_cast<void*>(page_start), static_cast<size_t>(page_size), &vec) != 0) {
+        return false;
+    }
+    return (vec & 1) != 0;
+}
+
+// Reason: the realtime-signal handler. It validates the sender and the
+// request token, transitions the slot from PENDING to WALKING, copies
+// the interrupted thread's ucontext_t and a bounded slice of its stack
+// into the slot, records handler time, then publishes DONE or releases
+// the slot if the dump moved on. NO libunwind calls happen here — that
+// is the variant's defining feature; the coordinator runs libunwind in
+// remote mode against the snapshot after the handler returns.
+//
+// The CAS into WALKING is the safety hand-off: a coordinator can never
+// re-arm a slot whose state is WALKING, so the handler's mid-copy
+// stack writes cannot land in the next dump's payload. For snapshot-
+// remote-unwind the WALKING window is short (a memcpy of at most
+// `max_stack_bytes` plus a structure copy), so contention against
+// the next dump's arming should be rarer than in the libunwind-in-
+// handler variants — but the contract still applies.
+//
+// Spec: docs/phase2-design.md "Variant Mechanics -> snapshot-remote-unwind".
+// Reference: <ck>/src/Common/StackTrace.cpp:470-498 (the same errno
+// save/restore + ucontext snapshot pattern, in CK's case for an in-
+// handler StackTrace constructor; here we copy the ucontext for a
+// later remote unwind).
+//
+// The stack-byte copy uses `process_vm_readv` to bypass ASAN. See
+// step 5 below for the full reasoning.
+void native_stack_signal_handler(int /*sig*/, siginfo_t* info, void* raw_context) {
+    const int saved_errno = errno;
+
+    // 1. Ignore any signal this process did not queue for a dump.
+    if (info == nullptr || info->si_code != SI_QUEUE || info->si_pid != getpid()) {
+        errno = saved_errno;
+        return;
+    }
+    // 2. Drop a handler whose request token no longer matches the live dump.
+    const uint64_t seq = reinterpret_cast<uintptr_t>(info->si_value.sival_ptr);
+    if (seq == 0) {
+        errno = saved_errno;
+        return;
+    }
+    CaptureSlot& slot = slot_for_seq(seq);
+    if (seq != slot.expected_seq.load(std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+    // 3. Claim the slot for WALKING. Fail closed if the coordinator
+    //    already transitioned it away (e.g. timeout drove PENDING -> IDLE).
+    int expected_state = SLOT_PENDING;
+    if (!slot.state.compare_exchange_strong(expected_state, SLOT_WALKING,
+                                            std::memory_order_acq_rel)) {
+        errno = saved_errno;
+        return;
+    }
+
+    const int64_t start_ns = monotonic_ns();
+
+    // 4. Copy the interrupted thread's ucontext_t into the slot. On
+    //    x86_64 libunwind's `unw_tdep_context_t` IS `ucontext_t`, so
+    //    this snapshot doubles as the `unw_context_t` the coordinator
+    //    feeds to `unw_init_remote`.
+    auto* signal_context = static_cast<const ucontext_t*>(raw_context);
+    if (signal_context != nullptr) {
+        std::memcpy(&slot.regs, signal_context, sizeof(ucontext_t));
+    }
+
+    // 5. Copy a bounded slice of the interrupted thread's stack into
+    //    the slot via `process_vm_readv` (self -> self). The
+    //    interrupted RSP is the lowest address libunwind will read
+    //    during the walk (DWARF CFI references frames at progressively
+    //    higher addresses); copy [RSP, RSP+max) up to `max_stack_bytes`,
+    //    gated by `mincore`.
+    //
+    //    Why process_vm_readv instead of a plain memcpy? Under ASAN
+    //    every cross-thread stack read trips the stack-buffer-underflow
+    //    redzone the compiler inserted between the target thread's
+    //    local variables (the marker chain in the case 8 test has
+    //    `ref.tmp` objects surrounded by `f1`/`f3` redzones; the
+    //    snapshot copy spans them by design). `__attribute__((no_sanitize
+    //    ("address")))` on this handler is not enough — Doris's vendored
+    //    `inline_memcpy` from glibc-compatibility/memcpy/memcpy_x86_64.cpp
+    //    is compiled with ASAN instrumentation regardless of the caller's
+    //    attribute. process_vm_readv does the copy entirely in the
+    //    kernel, so ASAN's userspace shadow has no place to intercept;
+    //    the same trick perf and gdb use. The kernel checks per-page
+    //    that the source is readable, so a guard page mid-copy returns
+    //    a short read rather than SIGSEGV.
+    // Reference: process_vm_readv(2); kernel does the page-by-page
+    // safety check, so the same defense as fp-walk's mincore + page-
+    // at-a-time copy is folded into the syscall itself.
+#if defined(__x86_64__)
+    const uintptr_t rsp =
+            signal_context != nullptr
+                    ? static_cast<uintptr_t>(signal_context->uc_mcontext.gregs[REG_RSP])
+                    : 0;
+    const size_t cap = std::min(slot.max_stack_bytes, kMaxStackBytes);
+    if (rsp != 0 && cap > 0 && page_is_mapped(rsp)) {
+        struct iovec local_iov {};
+        local_iov.iov_base = slot.stack_bytes;
+        local_iov.iov_len = cap;
+        struct iovec remote_iov {};
+        remote_iov.iov_base = reinterpret_cast<void*>(rsp);
+        remote_iov.iov_len = cap;
+        const ssize_t copied = syscall(SYS_process_vm_readv, getpid(), &local_iov, 1,
+                                       &remote_iov, 1, static_cast<unsigned long>(0));
+        if (copied > 0) {
+            slot.stack_base = rsp;
+            slot.stack_size = static_cast<size_t>(copied);
+        }
+    }
+#endif
+
+    const int64_t end_ns = monotonic_ns();
+    if (start_ns > 0 && end_ns >= start_ns) {
+        slot.handler_ns.store(end_ns - start_ns, std::memory_order_relaxed);
+    }
+
+    // 6. Publish DONE if the dump still wants us; otherwise release the
+    //    slot. Either way the state leaves WALKING so the coordinator's
+    //    drain loop can break.
+    if (seq == slot.expected_seq.load(std::memory_order_acquire)) {
+        slot.state.store(SLOT_DONE, std::memory_order_release);
+    } else {
+        slot.state.store(SLOT_IDLE, std::memory_order_release);
+    }
+    errno = saved_errno;
+}
+
+void install_handler_once() {
+    std::call_once(g_install_once, [] {
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            g_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack signal handler: " << std::strerror(errno);
+        }
+    });
+}
+
+// Reason: libunwind asks `access_reg` for the value of one register
+// while unwinding. The arg pointer is the `void*` we passed to
+// `unw_init_remote` (a `ucontext_t*` pointing at the slot's captured
+// registers). On x86_64 the mcontext gregs[] is the canonical register
+// layout libunwind already expects via `unw_tdep_context_t`. The
+// regnum-to-gregs[] mapping follows the libunwind upstream mapping
+// from <libunwind-x86_64.h> (UNW_X86_64_R<N>) to <sys/ucontext.h>
+// REG_R<N>.
+// Reference: libunwind/src/x86_64/Gglobal.c dwarf_to_unw_regnum_map.
+int snapshot_access_reg(unw_addr_space_t /*as*/, unw_regnum_t regnum, unw_word_t* valp,
+                        int write, void* arg) {
+    if (write != 0) {
+        // We never resume; refuse writes.
+        return -UNW_EREADONLYREG;
+    }
+    if (valp == nullptr || arg == nullptr) {
+        return -UNW_EINVAL;
+    }
+    const auto* ctx = static_cast<const ucontext_t*>(arg);
+    const auto& gregs = ctx->uc_mcontext.gregs;
+    switch (regnum) {
+    case UNW_X86_64_RAX: *valp = static_cast<unw_word_t>(gregs[REG_RAX]); return 0;
+    case UNW_X86_64_RDX: *valp = static_cast<unw_word_t>(gregs[REG_RDX]); return 0;
+    case UNW_X86_64_RCX: *valp = static_cast<unw_word_t>(gregs[REG_RCX]); return 0;
+    case UNW_X86_64_RBX: *valp = static_cast<unw_word_t>(gregs[REG_RBX]); return 0;
+    case UNW_X86_64_RSI: *valp = static_cast<unw_word_t>(gregs[REG_RSI]); return 0;
