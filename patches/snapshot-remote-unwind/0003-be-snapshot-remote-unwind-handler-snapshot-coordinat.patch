+// Reason: the dyn_info_list is for procedures registered at runtime
+// via `_U_dyn_register` (JIT'd code). Doris does not JIT eh_frame
+// entries; returning UNW_ESUCCESS with a zero address means "no
+// dynamically registered procedures", which is the correct answer for
+// every Doris thread.
+int snapshot_get_dyn_info_list_addr(unw_addr_space_t /*as*/, unw_word_t* dilap,
+                                    void* /*arg*/) {
+    if (dilap != nullptr) {
+        *dilap = 0;
+    }
+    return 0;
+}
