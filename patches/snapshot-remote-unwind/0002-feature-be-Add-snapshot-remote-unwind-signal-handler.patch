+// This file is derived from
+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.h
+// and ob_signal_handlers.{h,cpp} and modified by Doris for the
+// snapshot-remote-unwind native stack collector. Diverges from ob-kill60
+// because this design forbids libunwind work inside the worker handler;
+// the handler copies registers + a stack slice and returns.
+
+#pragma once
+
+#include <signal.h>
+#include <ucontext.h>
+
+#include <cstdint>
+
+namespace doris::srunwind {
+
+// Reason: MP_SIG (multi-purpose signal) is the realtime-adjacent signal the
+// coordinator sends to interrupt one worker thread at a time. Reuses
+// OceanBase's SIGURG choice because POSIX leaves the default action as
+// "ignore" and Doris BE does not use SIGURG elsewhere. Same value as Phase
+// C ob-kill60 but a separate symbol so the two variants are independently
+// auditable.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:25
+constexpr int kMpSig = SIGURG;
+
+// Reason: maximum stack bytes the handler memcpy's per dump. Phase 2 plan
+// pinned 8 KiB as the default; the buffer is sized once at file scope so
+// no allocation happens in the signal handler.
+// Reference: docs/phase2-plan.md:99
+constexpr int kMaxSnapshotStackBytes = 8192;
+
+// Reason: shared context the coordinator hands to one worker handler in
+// turn. Mirrors OceanBase ObSigHandlerCtx in shape (lock_ + req_id_ +
+// fd_[2] + fd2_[2]) so the two-phase pipe coordination is identical;
+// the payload differs because this variant captures a ucontext_t +
+// stack bytes rather than libunwind PCs.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:111-127
+struct SrunwindSigHandlerCtx {
+    SrunwindSigHandlerCtx() = default;
+
+    // Reason: TAS spin-lock the coordinator holds for the whole per-thread
+    // exchange so concurrent HTTP requests serialize on the shared ctx.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:97-107
+    void lock();
+    void unlock();
+    bool try_lock();
+
+    // Reason: req_id is the anti-spoof token the coordinator stamps into
+    // si_value.sival_ptr; the handler rejects any signal whose req_id
+    // does not match. Lock during the swap so the handler observes a
+    // coherent value.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:90-95
+    void atomic_set_req_id(int64_t req_id);
+
+    // fd_[0/1] = worker -> coordinator (prepare-ack + exit-ack).
+    // fd2_[0/1]= coordinator -> worker (process-done signal).
+    // Lifecycle: pipe2(O_CLOEXEC) per request, closed by the coordinator.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:120-121
+    int fd_[2] = {-1, -1};
+    int fd2_[2] = {-1, -1};
+
+    // Reason: snapshot payload the worker handler fills in. ucontext_t
+    // is captured verbatim from sa_sigaction's third argument so the
+    // coordinator can read every general-purpose register without a
+    // libunwind round-trip on the worker side. stack_buf_ holds up to
+    // kMaxSnapshotStackBytes starting at stack_base_; the coordinator
+    // uses this for unw_init_remote's memory accessor.
+    ucontext_t ucontext_ = {};
+    bool ucontext_valid_ = false;
+
+    uintptr_t stack_base_ = 0;
+    int64_t stack_bytes_ = 0;
+    bool stack_truncated_ = false;
+    unsigned char stack_buf_[kMaxSnapshotStackBytes] = {};
+
+    // Reason: handler-side validation bounds the coordinator passed in
+    // (per-tid [stack] VMA from /proc/self/task/<tid>/maps). The handler
+    // clamps the memcpy to [stack_low_, stack_high_) so the read never
+    // crosses a guard page.
+    uintptr_t stack_low_ = 0;
+    uintptr_t stack_high_ = 0;
+
+    // Reason: tid of the thread currently being interrupted so the worker
+    // handler can ignore stray signals delivered to the wrong thread.
+    int64_t target_tid_ = 0;
+
+    int64_t lock_ = 0;
+    int64_t req_id_ = 0;
+};
+
+// Reason: single shared instance — the coordinator processes one worker
+// at a time under the spin-lock, exactly as OceanBase does.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:109
+extern SrunwindSigHandlerCtx g_sig_handler_ctx_;
+
+// Reason: top-level signal dispatcher; routes MP_SIG to the per-request
+// snapshot capture path and drops every other signal. Anti-spoof check
+// on req_id and target_tid. Async-signal-safe: copies the ucontext_t and
+// up to kMaxSnapshotStackBytes from the interrupted %rsp into ctx, then
+// returns. No libunwind, no allocation, no locking inside the handler.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:103-120
+extern "C" void srunwind_signal_handler(int sig, siginfo_t* si, void* context);
+
+// Reason: register srunwind_signal_handler for MP_SIG only. Doris already
+// owns SIGSEGV/SIGABRT/SIGBUS/SIGFPE/SIGILL/SIGTERM via
+// doris::signal::InstallFailureSignalHandler, so we narrow the OB
+// SIG_SET to MP_SIG to avoid stomping the failure handler.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:73-86
+int install_srunwind_signal_handler();
+
+} // namespace doris::srunwind
