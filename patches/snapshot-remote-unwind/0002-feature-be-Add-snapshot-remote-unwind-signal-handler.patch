+// This file is derived from
+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.cpp
+// and ob_signal_handlers.cpp, modified by Doris for the
+// snapshot-remote-unwind native stack collector.
+
+#include "common/srunwind_signal_handler.h"
+
+#include <errno.h>
+#include <sys/syscall.h>
+#include <sys/uio.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace doris::srunwind {
+
+SrunwindSigHandlerCtx g_sig_handler_ctx_;
+
+// Reason: TAS spin-loop with PAUSE / YIELD hint, signal-safe (no
+// allocation, no futex). The coordinator holds this for the whole
+// per-thread exchange. Arch-gated because __builtin_ia32_pause is
+// x86-only and Doris BE compiles for both x86_64 and aarch64 (see Phase
+// C lesson on multi-arch CPU hints).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:97-102
+void SrunwindSigHandlerCtx::lock() {
+    while (__atomic_test_and_set(&lock_, __ATOMIC_ACQ_REL)) {
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#elif defined(__aarch64__)
+        asm volatile("yield");
+#endif
+    }
+}
+
+void SrunwindSigHandlerCtx::unlock() {
+    __atomic_clear(&lock_, __ATOMIC_RELEASE);
+}
+
+// Reason: non-blocking try_lock so the HTTP coordinator can report busy
+// when another dump is in flight, mirroring OB's spin policy but without
+// blocking the HTTP thread indefinitely.
+bool SrunwindSigHandlerCtx::try_lock() {
+    return !__atomic_test_and_set(&lock_, __ATOMIC_ACQ_REL);
+}
+
+// Reason: stamp the anti-spoof token under the lock so the worker handler
+// always observes a coherent req_id.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:90-95
+void SrunwindSigHandlerCtx::atomic_set_req_id(int64_t req_id) {
+    lock();
+    req_id_ = req_id;
+    unlock();
+}
+
+namespace {
+
+// Reason: signal-safe stack memcpy that never faults. process_vm_readv is
+// a Linux syscall (async-signal-safe) that returns -1 on a bad page
+// instead of raising SIGSEGV inside the handler. Reads in one iovec call.
+// Clamps to [ctx.stack_low_, ctx.stack_high_) so we never cross a guard
+// page even if the kernel just grew the stack.
+ssize_t safe_read_stack(SrunwindSigHandlerCtx* ctx, uintptr_t rsp, void* dst,
+                        size_t want_bytes) {
+    if (rsp == 0 || dst == nullptr || want_bytes == 0) {
+        return 0;
+    }
+    if (ctx->stack_low_ != 0 && ctx->stack_high_ != 0) {
+        if (rsp < ctx->stack_low_ || rsp >= ctx->stack_high_) {
+            return -1;
+        }
+        const uintptr_t available = ctx->stack_high_ - rsp;
+        if (want_bytes > available) {
+            want_bytes = static_cast<size_t>(available);
+        }
+    }
+    struct iovec local {};
+    struct iovec remote {};
+    local.iov_base = dst;
+    local.iov_len = want_bytes;
+    remote.iov_base = reinterpret_cast<void*>(rsp);
+    remote.iov_len = want_bytes;
+    return ::process_vm_readv(::getpid(), &local, 1, &remote, 1, 0);
+}
+
+// Reason: write a fixed-size ack down the worker->coordinator pipe with
+// EINTR retry. Async-signal-safe because ::write is on the safe list.
+bool safe_write_ack(int fd, int ack) {
+    while (true) {
+        ssize_t n = ::write(fd, &ack, sizeof(ack));
+        if (n == static_cast<ssize_t>(sizeof(ack))) {
+            return true;
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        return false;
+    }
+}
+
+// Reason: blocking read of one int from the coordinator->worker pipe with
+// EINTR retry. Bounded by the coordinator's timeout — if the coordinator
+// times out it closes fd2_, the read returns 0, and the worker exits.
+bool safe_read_ack(int fd, int* ack) {
+    while (true) {
+        ssize_t n = ::read(fd, ack, sizeof(*ack));
+        if (n == static_cast<ssize_t>(sizeof(*ack))) {
+            return true;
+        }
+        if (n == 0) {
+            return false; // pipe closed by coordinator timeout
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        return false;
+    }
+}
+
+} // namespace
+
+// Reason: top-level signal dispatcher. Mirrors OB's two-phase exchange
+// (prepare-ack on fd_[1], wait on fd2_[0], exit-ack on fd_[1]) but the
+// "prepare" payload is a register + stack snapshot rather than a
+// libunwind PC list. No libunwind is called on the worker side — that is
+// the defining property of the snapshot-remote-unwind variant per
+// docs/phase2-plan.md:67-71.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:103-120
+extern "C" void srunwind_signal_handler(int sig, siginfo_t* si, void* context) {
+    if (sig != kMpSig || si == nullptr || context == nullptr) {
+        return;
+    }
+
+    // 1. Anti-spoof: reject any sival_ptr that does not match the current
+    //    req_id. Mirrors OB ob_signal_handler:113-115.
+    int64_t req_id = reinterpret_cast<int64_t>(si->si_value.sival_ptr);
+    auto& ctx = g_sig_handler_ctx_;
+    if (ctx.req_id_ != req_id || req_id == 0) {
+        return;
+    }
+
+    // 2. Drop signals delivered to the wrong tid (a stray MP_SIG from an
+    //    earlier request that re-fires after the coordinator advanced).
+    int64_t self_tid = static_cast<int64_t>(syscall(SYS_gettid));
+    if (ctx.target_tid_ != self_tid) {
+        return;
+    }
+
+    int saved_errno = errno;
+    int prepare_rc = 0;
+
+    // 3. Snapshot ucontext_t verbatim — this is the full register file the
+    //    coordinator hands to libunwind via unw_init_remote. Memcpy is
+    //    fine because struct ucontext_t is POD on every Linux libc.
+    std::memcpy(&ctx.ucontext_, context, sizeof(ctx.ucontext_));
+    ctx.ucontext_valid_ = true;
+
+    // 4. memcpy up to kMaxSnapshotStackBytes from %rsp into ctx.stack_buf_.
+    //    The handler does NOT walk frames; the coordinator will. On x86_64
+    //    %rsp comes out of gregs[REG_RSP]; on non-x86_64 we record an
+    //    empty stack and the coordinator's remote unwind will short-circuit.
+#if defined(__x86_64__)
+    auto* uc = static_cast<ucontext_t*>(context);
+    ctx.stack_base_ = static_cast<uintptr_t>(uc->uc_mcontext.gregs[REG_RSP]);
+#else
+    ctx.stack_base_ = 0;
+#endif
+    ctx.stack_bytes_ = 0;
+    ctx.stack_truncated_ = false;
+
+    if (ctx.stack_base_ != 0) {
+        ssize_t got = safe_read_stack(&ctx, ctx.stack_base_, ctx.stack_buf_,
+                                       sizeof(ctx.stack_buf_));
+        if (got > 0) {
+            ctx.stack_bytes_ = got;
+            // Reason: the available range above the base is
+            // [stack_base_, stack_high_); if the kernel grew the stack
+            // beyond our 8 KiB cap we record truncated so the coordinator
+            // can report it without re-checking the bounds itself.
+            if (ctx.stack_high_ != 0 &&
+                ctx.stack_high_ - ctx.stack_base_ > static_cast<uintptr_t>(got)) {
+                ctx.stack_truncated_ = true;
+            }
+        } else {
+            prepare_rc = -1;
+        }
+    }
+
+    // 5. Notify the coordinator that prepare is done by writing the ack.
+    //    Mirrors OB ob_signal_worker.cpp:358-360. On write failure the
+    //    coordinator will time out on its own poll.
+    safe_write_ack(ctx.fd_[1], prepare_rc);
+
+    // 6. Wait for the coordinator's process-done write on fd2_, then post
+    //    the exit-ack. Bounded by the coordinator's timeout — if the
+    //    coordinator times out it closes ctx.fd2_[0] (read returns 0) and
+    //    we exit cleanly.
+    //    Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:362-385
+    int peer_ack = 0;
+    safe_read_ack(ctx.fd2_[0], &peer_ack);
+    safe_write_ack(ctx.fd_[1], peer_ack);
+
+    errno = saved_errno;
+}
+
+// Reason: install srunwind_signal_handler for MP_SIG only. Doris BE
+// already installs a failure handler for SIGSEGV/SIGABRT/SIGBUS/SIGFPE/
+// SIGILL/SIGTERM via doris::signal::InstallFailureSignalHandler at
+// be/src/common/signal_handler.h, so we MUST NOT widen SIG_SET to those.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:73-86
+int install_srunwind_signal_handler() {
+    struct sigaction sa {};
+    sa.sa_flags = SA_SIGINFO | SA_RESTART | SA_NODEFER | SA_ONSTACK;
+    sa.sa_sigaction = srunwind_signal_handler;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(kMpSig, &sa, nullptr) == -1) {
+        return -1;
+    }
+    return 0;
+}
+
+} // namespace doris::srunwind
