+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.cpp
+// (ObProcMaps::load_maps) and modified by Doris for the
+// snapshot-remote-unwind native stack collector.
+
+#include "common/srunwind_proc_maps.h"
+
+#include <fstream>
+#include <sstream>
+
+namespace doris::srunwind {
+
+namespace {
+
+// Reason: cheap left-trim used for the path column which fgets-style
+// readers leave with leading spaces from the fixed-column layout of
+// /proc/self/maps.
+std::string trim_left_spaces(std::string value) {
+    const size_t first = value.find_first_not_of(' ');
+    if (first == std::string::npos) {
+        return "";
+    }
+    return value.substr(first);
+}
+
+// Reason: stoull-on-hex helper kept local to the proc_maps parser; the
+// freeform Doris collector had the same helper inline.
+bool parse_hex_uintptr(const std::string& value, uintptr_t* parsed) {
+    if (value.empty()) {
+        return false;
+    }
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uintptr_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: shared parser for /proc/self/maps and /proc/self/task/<tid>/maps.
+// Keep ALL mappings (readable bit recorded on the struct) so the
+// coordinator can both compute DSO offsets and validate stack-pointer
+// ranges; the OB pattern filters non-executable rows away inside the
+// cache, which would lose the stack VMA we need here.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:62-86
+std::vector<MemoryMap> load_memory_maps_for(const std::string& path) {
+    std::vector<MemoryMap> maps;
+    std::ifstream input(path);
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream iss(line);
+        std::string range;
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> range >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+
+        const size_t dash = range.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+
+        MemoryMap map;
+        if (!parse_hex_uintptr(range.substr(0, dash), &map.start) ||
+            !parse_hex_uintptr(range.substr(dash + 1), &map.end) ||
+            !parse_hex_uintptr(offset_hex, &map.offset) || map.start >= map.end) {
+            continue;
+        }
+
+        map.readable = !perms.empty() && perms[0] == 'r';
+        std::string map_path;
+        std::getline(iss, map_path);
+        map.path = trim_left_spaces(map_path);
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+} // namespace
+
+// Reason: refresh the cached process-wide layout. Coordinator-only —
+// called once per request before each per-thread snapshot pass.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:52-88
+void SrunwindProcMaps::load_maps() {
+    _maps = load_memory_maps_for("/proc/self/maps");
+}
+
+// Reason: linear scan keyed on PC; the cache is small (~few hundred rows
+// even with jemalloc + a handful of dlopens) so linear is cheaper than
+// sort+binary-search and avoids a transient allocation.
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
+
+// Reason: locate the [stack] VMA for one thread so the handler's 8 KiB
+// memcpy can be clamped. Per-thread file open rather than per-request:
+// the stack VMA changes when the kernel grows it, so the coordinator
+// always refreshes before signalling.
+bool load_thread_stack_bounds(int64_t tid, uintptr_t* stack_low, uintptr_t* stack_high) {
+    const std::vector<MemoryMap> maps =
+            load_memory_maps_for("/proc/self/task/" + std::to_string(tid) + "/maps");
+    for (const MemoryMap& map : maps) {
+        if (map.path == "[stack]" && map.readable) {
+            *stack_low = map.start;
+            *stack_high = map.end;
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace doris::srunwind
