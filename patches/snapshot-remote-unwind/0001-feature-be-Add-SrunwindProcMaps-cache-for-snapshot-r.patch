+// This file is derived from
+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.h
+// (class ObProcMaps) and modified by Doris for the snapshot-remote-unwind
+// native stack collector. Duplicated rather than shared with ob-kill60 so
+// each variant branch stays self-contained per docs/phase2-plan.md.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace doris::srunwind {
+
+// Reason: typed memory map row the coordinator scans to compute DSO offsets
+// and to validate stack pointer ranges captured by the signal handler. Stays
+// in coordinator-only code (the handler does not touch this struct).
+struct MemoryMap {
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    uintptr_t offset = 0;
+    bool readable = false;
+    std::string path;
+};
+
+// Reason: caches /proc/self/maps so the coordinator can compute DSO offsets
+// and resolve stack VMA bounds without re-reading the file per request.
+// Mirrors the OceanBase ObProcMaps singleton shape Phase C uses for
+// ob-kill60; duplicated here so the snapshot-remote-unwind variant stays
+// isolated.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:87-107
+class SrunwindProcMaps {
+public:
+    static SrunwindProcMaps& get_instance() {
+        static SrunwindProcMaps the_one;
+        return the_one;
+    }
+
+    // Reason: re-parse /proc/self/maps; called from the HTTP coordinator
+    // before each dump so dlopen()'d shared objects are visible in DSO
+    // offsets and stack-VMA lookups. Coordinator-only — never invoked from
+    // the signal handler.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:52-88
+    void load_maps();
+
+    const std::vector<MemoryMap>& maps() const { return _maps; }
+
+private:
+    SrunwindProcMaps() = default;
+
+    std::vector<MemoryMap> _maps;
+};
+
+// Reason: locate the executable mapping that contains PC so the coordinator
+// can compute (dso_path, dso_offset) for each frame.
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc);
+
+// Reason: find the stack VMA for a given tid by parsing
+// /proc/self/task/<tid>/maps once per dump. Used to clamp the handler's
+// 8 KiB stack copy so it never reads past the thread's stack page.
+bool load_thread_stack_bounds(int64_t tid, uintptr_t* stack_low, uintptr_t* stack_high);
+
+} // namespace doris::srunwind
