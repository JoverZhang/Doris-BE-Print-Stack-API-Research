+// This file is derived from
+// https://github.com/oceanbase/obstack/blob/master/src/main.cpp
+// (the _UPT_accessors-based remote unwind path) and the libunwind
+// remote-unwind API. Modified by Doris for the snapshot-remote-unwind
+// native stack collector — the accessors read from an in-memory snapshot
+// (ucontext_t + stack bytes) instead of /proc/<tid> via ptrace.
+
+#pragma once
+
+#ifndef UNW_LOCAL_ONLY
+#define UNW_LOCAL_ONLY 1
+#endif
+#include <libunwind.h>
+
+#include <cstdint>
+
+#include "common/srunwind_proc_maps.h"
+#include "common/srunwind_signal_handler.h"
+
+namespace doris::srunwind {
+
+// Reason: per-thread input the coordinator hands the accessors. The
+// snapshot pointer addresses ctx storage that the coordinator already
+// copied out from g_sig_handler_ctx_ so subsequent worker captures can
+// reuse the shared ctx buffer. maps is the coordinator's snapshot of
+// /proc/self/maps, used by access_mem to validate non-stack reads.
+struct RemoteUnwindCookie {
+    const ucontext_t* ucontext = nullptr;
+    const unsigned char* stack_buf = nullptr;
+    uintptr_t stack_base = 0;
+    int64_t stack_bytes = 0;
+    const std::vector<MemoryMap>* maps = nullptr;
+};
+
+// Reason: build an address space whose accessors read from the snapshot.
+// Coordinator creates one address space per request and tears it down at
+// the end. The accessors delegate find_proc_info / put_unwind_info /
+// get_dyn_info_list_addr to libunwind's local address space accessors so
+// the snapshot's DWARF unwind info is read out of the binary's .eh_frame
+// without re-implementing the ELF reader. access_mem / access_reg read
+// from the snapshot.
+// Reference: <obstack>/src/main.cpp:354-363 (unw_create_addr_space shape)
+unw_addr_space_t create_snapshot_addr_space();
+
+// Reason: destroy the addr space at the end of the request — mirrors
+// obstack's DEFER(unw_destroy_addr_space).
+// Reference: <obstack>/src/main.cpp:362
+void destroy_snapshot_addr_space(unw_addr_space_t as);
+
+// Reason: walk one snapshot's frames into `frames`. Returns the number of
+// frames written. `truncated` is set to true when the walk hit max_frames
+// before unw_step returned 0/error.
+// Reference: <obstack>/src/main.cpp:413-423 (unw_init_remote + unw_step loop)
+int unwind_snapshot(unw_addr_space_t as, RemoteUnwindCookie* cookie, uintptr_t* frames,
+                    int max_frames, bool* truncated);
+
+} // namespace doris::srunwind
