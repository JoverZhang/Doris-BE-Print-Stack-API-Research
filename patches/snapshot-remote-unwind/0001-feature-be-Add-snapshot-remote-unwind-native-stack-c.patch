+int remote_access_mem(unw_addr_space_t, unw_word_t address, unw_word_t* value, int write,
+                      void* arg) {
+    if (write != 0 || value == nullptr) {
+        return -UNW_EINVAL;
+    }
+    auto* context = static_cast<RemoteUnwindContext*>(arg);
+    if (context == nullptr || context->slot == nullptr || context->maps == nullptr) {
+        return -UNW_EINVAL;
+    }
+
+    const uintptr_t target = static_cast<uintptr_t>(address);
+    if (slot_contains_copied_stack_word(*context->slot, target)) {
+        const uintptr_t offset = target - context->slot->copied_stack_base;
+        std::memcpy(value, context->slot->stack_copy + offset, sizeof(*value));
+        return 0;
+    }
+    if (slot_stack_mapping_contains(*context->slot, target, sizeof(*value))) {
+        return -UNW_EBADFRAME;
+    }
+    if (!address_is_readable(*context->maps, target, sizeof(*value))) {
+        return -UNW_EBADFRAME;
+    }
+    std::memcpy(value, reinterpret_cast<const void*>(target), sizeof(*value));
+    return 0;
+}
