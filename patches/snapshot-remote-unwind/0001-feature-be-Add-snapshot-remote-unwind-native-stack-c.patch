+bool parse_hex_uintptr(const std::string& value, uintptr_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size() ||
+            result > static_cast<unsigned long long>(std::numeric_limits<uintptr_t>::max())) {
+            return false;
+        }
+        *parsed = static_cast<uintptr_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+bool parse_hex_u64(const std::string& value, uint64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uint64_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
