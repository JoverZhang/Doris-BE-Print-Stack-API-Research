-// Reason: returns stable JSON without collecting PCs so reviewers see the response shape.
-EasyJson collect_stub_stacks(const RequestOptions& options, int64_t elapsed) {
+bool slot_contains_copied_stack_word(const ThreadCaptureSlot& slot, uintptr_t address) {
+    if (slot.copied_stack_bytes < sizeof(unw_word_t) || address < slot.copied_stack_base) {
+        return false;
+    }
+    const uintptr_t offset = address - slot.copied_stack_base;
+    return offset <= slot.copied_stack_bytes - sizeof(unw_word_t);
+}
+
+bool read_copied_stack_uintptr(const ThreadCaptureSlot& slot, uintptr_t address, uintptr_t* value) {
+    if (value == nullptr || !slot_contains_copied_stack_word(slot, address)) {
+        return false;
+    }
+    const uintptr_t offset = address - slot.copied_stack_base;
+    std::memcpy(value, slot.stack_copy + offset, sizeof(*value));
+    return true;
+}
+
+bool slot_stack_mapping_contains(const ThreadCaptureSlot& slot, uintptr_t address, size_t size) {
+    if (!slot.stack_bounds_valid || size == 0 || address < slot.stack_low ||
+        address >= slot.stack_high) {
+        return false;
+    }
+    return slot.stack_high - address >= size;
+}
+
+ThreadCaptureSlot* slot_from_signal_info(siginfo_t* info, DumpSession* session) {
+    if (info != nullptr && info->si_code == SI_QUEUE && info->si_value.sival_ptr != nullptr) {
+        auto* slot = static_cast<ThreadCaptureSlot*>(info->si_value.sival_ptr);
+        if (slot >= session->slots && slot < session->slots + session->slot_count) {
+            return slot;
+        }
+    }
+
+    ThreadCaptureSlot* fallback = s_tgkill_fallback_slot.load(std::memory_order_acquire);
+    if (fallback == nullptr || fallback < session->slots ||
+        fallback >= session->slots + session->slot_count) {
+        return nullptr;
+    }
+    const int64_t tid = static_cast<int64_t>(syscall(SYS_gettid));
+    if (fallback->tid != tid) {
+        return nullptr;
+    }
+    return fallback;
+}
+
+void copy_interrupted_stack(ThreadCaptureSlot* slot) {
+    slot->copied_stack_base = slot->registers.rsp;
+    slot->copied_stack_bytes = 0;
+    slot->stack_truncated = false;
+
+    if (slot->stack_copy == nullptr || slot->stack_capacity == 0 || !slot->stack_bounds_valid ||
+        slot->registers.rsp < slot->stack_low || slot->registers.rsp >= slot->stack_high) {
+        return;
+    }
+
+    const uintptr_t available = slot->stack_high - slot->registers.rsp;
+    const size_t bytes_to_copy = static_cast<size_t>(
+            std::min<uintptr_t>(available, static_cast<uintptr_t>(slot->stack_capacity)));
+    const auto* src = reinterpret_cast<const uint8_t*>(slot->registers.rsp);
+    for (size_t i = 0; i < bytes_to_copy; ++i) {
+        slot->stack_copy[i] = src[i];
+    }
+    slot->copied_stack_bytes = bytes_to_copy;
+    slot->stack_truncated = available > bytes_to_copy;
+}
+
+void native_stack_signal_handler(int, siginfo_t* info, void* raw_context) {
+    DumpSession* session = s_active_session.load(std::memory_order_acquire);
+    if (session == nullptr) {
+        return;
+    }
+
+    ThreadCaptureSlot* slot = slot_from_signal_info(info, session);
+    if (slot == nullptr) {
+        return;
+    }
+
+    session->active_handlers.fetch_add(1, std::memory_order_acq_rel);
+    int expected = SLOT_PENDING;
+    if (!slot->state.compare_exchange_strong(expected, SLOT_COPYING, std::memory_order_acq_rel)) {
+        session->active_handlers.fetch_sub(1, std::memory_order_acq_rel);
+        return;
+    }
+
+#if defined(__x86_64__)
+    auto* context = static_cast<ucontext_t*>(raw_context);
+    slot->registers.rax = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RAX]);
+    slot->registers.rdx = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RDX]);
+    slot->registers.rcx = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RCX]);
+    slot->registers.rbx = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RBX]);
+    slot->registers.rsi = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RSI]);
+    slot->registers.rdi = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RDI]);
+    slot->registers.rbp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RBP]);
+    slot->registers.rsp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RSP]);
+    slot->registers.r8 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R8]);
+    slot->registers.r9 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R9]);
+    slot->registers.r10 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R10]);
+    slot->registers.r11 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R11]);
+    slot->registers.r12 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R12]);
+    slot->registers.r13 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R13]);
+    slot->registers.r14 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R14]);
+    slot->registers.r15 = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_R15]);
+    slot->registers.rip = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RIP]);
+    copy_interrupted_stack(slot);
+    slot->state.store(SLOT_SNAPSHOT_DONE, std::memory_order_release);
+#else
+    slot->state.store(SLOT_UNSUPPORTED, std::memory_order_release);
+#endif
+
+    session->active_handlers.fetch_sub(1, std::memory_order_acq_rel);
+}
+
+void install_signal_handler_once() {
+    std::call_once(s_signal_install_once, [] {
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            s_signal_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack snapshot signal handler: "
+                       << std::strerror(errno);
+        }
+    });
+}
+
+void mark_signal_failure(ThreadCaptureSlot* slot, int error_number) {
+    slot->signal_errno = error_number;
+    slot->state.store(SLOT_SIGNAL_FAILED, std::memory_order_release);
+}
+
+bool send_realtime_signal(pid_t pid, ThreadCaptureSlot* slot, int signal_number,
+                          int* error_number) {
+#ifdef SYS_rt_tgsigqueueinfo
+    siginfo_t info {};
+    info.si_signo = signal_number;
+    info.si_code = SI_QUEUE;
+    info.si_pid = pid;
+    info.si_uid = geteuid();
+    info.si_value.sival_ptr = slot;
+    if (syscall(SYS_rt_tgsigqueueinfo, pid, static_cast<pid_t>(slot->tid), signal_number, &info) ==
+        0) {
+        slot->signal_method.store(SIGNAL_METHOD_RT_TGSIGQUEUEINFO, std::memory_order_release);
+        return true;
+    }
+    *error_number = errno;
+    return false;
+#else
+    *error_number = ENOSYS;
+    return false;
+#endif
+}
+
+bool send_tgkill_signal(pid_t pid, ThreadCaptureSlot* slot, int signal_number, int* error_number) {
+    s_tgkill_fallback_slot.store(slot, std::memory_order_release);
+    if (syscall(SYS_tgkill, pid, static_cast<pid_t>(slot->tid), signal_number) == 0) {
+        slot->signal_method.store(SIGNAL_METHOD_TGKILL, std::memory_order_release);
+        return true;
+    }
+    *error_number = errno;
+    s_tgkill_fallback_slot.store(nullptr, std::memory_order_release);
+    return false;
+}
+
+void wait_for_slot(ThreadCaptureSlot* slot, std::chrono::steady_clock::time_point deadline) {
+    while (std::chrono::steady_clock::now() < deadline) {
+        const int state = slot->state.load(std::memory_order_acquire);
+        if (state != SLOT_PENDING && state != SLOT_COPYING) {
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+}
+
+void collect_thread_snapshots(ThreadCaptureSlot* slots, size_t slot_count,
+                              const RequestOptions& options,
+                              std::chrono::steady_clock::time_point start) {
+    DumpSession session;
+    session.slots = slots;
+    session.slot_count = slot_count;
+
+    s_active_session.store(&session, std::memory_order_release);
+    const pid_t pid = getpid();
+    const int signal_number = native_stack_signal_number();
+    const auto deadline = start + std::chrono::milliseconds(options.timeout_ms);
+
+    for (size_t i = 0; i < slot_count; ++i) {
+        if (slots[i].state.load(std::memory_order_acquire) != SLOT_PENDING) {
+            continue;
+        }
+
+        int rt_errno = 0;
+        if (send_realtime_signal(pid, &slots[i], signal_number, &rt_errno)) {
+            continue;
+        }
+
+        int tgkill_errno = 0;
+        if (!send_tgkill_signal(pid, &slots[i], signal_number, &tgkill_errno)) {
+            mark_signal_failure(&slots[i], tgkill_errno != 0 ? tgkill_errno : rt_errno);
+            continue;
+        }
+        wait_for_slot(&slots[i], deadline);
+        s_tgkill_fallback_slot.store(nullptr, std::memory_order_release);
+    }
+
+    while (std::chrono::steady_clock::now() < deadline) {
+        bool all_done = true;
+        for (size_t i = 0; i < slot_count; ++i) {
+            const int state = slots[i].state.load(std::memory_order_acquire);
+            if (state == SLOT_PENDING || state == SLOT_COPYING) {
+                all_done = false;
+                break;
+            }
+        }
+        if (all_done) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    s_active_session.store(nullptr, std::memory_order_release);
+    s_tgkill_fallback_slot.store(nullptr, std::memory_order_release);
+    const auto handler_grace_deadline =
+            std::chrono::steady_clock::now() + std::chrono::milliseconds(10);
+    while (session.active_handlers.load(std::memory_order_acquire) > 0 &&
+           std::chrono::steady_clock::now() < handler_grace_deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    for (size_t i = 0; i < slot_count; ++i) {
+        int expected = SLOT_PENDING;
+        if (slots[i].state.compare_exchange_strong(expected, SLOT_TIMEOUT,
+                                                   std::memory_order_acq_rel)) {
+            continue;
+        }
+        expected = SLOT_COPYING;
+        slots[i].state.compare_exchange_strong(expected, SLOT_TIMEOUT, std::memory_order_acq_rel);
+    }
+}
+
