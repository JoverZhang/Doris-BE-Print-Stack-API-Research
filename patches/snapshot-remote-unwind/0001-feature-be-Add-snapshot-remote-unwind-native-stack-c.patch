+std::vector<MemoryMap> load_memory_maps_for(const std::string& path) {
+    std::vector<MemoryMap> maps;
+    std::ifstream input(path);
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream iss(line);
+        std::string range;
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> range >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+        const size_t dash = range.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+
+        MemoryMap map;
+        if (!parse_hex_uintptr(range.substr(0, dash), &map.start) ||
+            !parse_hex_uintptr(range.substr(dash + 1), &map.end) ||
+            !parse_hex_uintptr(offset_hex, &map.offset) || map.start >= map.end) {
+            continue;
+        }
+
+        map.readable = !perms.empty() && perms[0] == 'r';
+        std::string map_path;
+        std::getline(iss, map_path);
+        map.path = trim_left_spaces(map_path);
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+std::vector<MemoryMap> load_memory_maps() {
+    return load_memory_maps_for("/proc/self/maps");
+}
+
+bool load_thread_stack_bounds(int64_t tid, uintptr_t* stack_low, uintptr_t* stack_high) {
+    const std::vector<MemoryMap> maps =
+            load_memory_maps_for("/proc/self/task/" + std::to_string(tid) + "/maps");
+    for (const MemoryMap& map : maps) {
+        if (map.path == "[stack]" && map.readable) {
+            *stack_low = map.start;
+            *stack_high = map.end;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
+
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
+
+bool range_in_map(const MemoryMap& map, uintptr_t address, size_t size) {
+    if (size == 0 || address < map.start || address >= map.end) {
+        return false;
+    }
+    const uintptr_t bytes_left = map.end - address;
+    return bytes_left >= size;
+}
+
+bool address_is_readable(const std::vector<MemoryMap>& maps, uintptr_t address, size_t size) {
+    for (const MemoryMap& map : maps) {
+        if (map.readable && range_in_map(map, address, size)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+std::string hex_uintptr(uintptr_t value) {
+    std::ostringstream out;
+    out << "0x" << std::hex << value;
+    return out.str();
+}
