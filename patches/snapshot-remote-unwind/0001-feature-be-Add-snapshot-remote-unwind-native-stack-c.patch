+std::string slot_signal_method_name(const ThreadCaptureSlot& slot) {
+    switch (slot.signal_method.load(std::memory_order_acquire)) {
+    case SIGNAL_METHOD_RT_TGSIGQUEUEINFO:
+        return "rt_tgsigqueueinfo";
+    case SIGNAL_METHOD_TGKILL:
+        return "tgkill";
+    default:
+        return "";
+    }
+}
+
+std::string slot_status(const ThreadCaptureSlot& slot, const UnwindResult& unwind) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_SNAPSHOT_DONE:
+        return unwind.frames.empty() ? "unwind_failed" : "ok";
+    case SLOT_SIGNAL_FAILED:
+        return slot.signal_errno == ESRCH ? "exited_thread" : "signal_failed";
+    case SLOT_TIMEOUT:
+        return "timeout";
+    case SLOT_UNSUPPORTED:
+        return "unsupported_arch";
+    case SLOT_SIGNAL_BLOCKED:
+        return "signal_blocked";
+    default:
+        return "pending";
+    }
+}
+
+std::string slot_error_reason(const ThreadCaptureSlot& slot, const UnwindResult& unwind) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_SNAPSHOT_DONE:
+        if (!unwind.error_reason.empty()) {
+            return unwind.error_reason;
+        }
+        if (!slot.stack_bounds_valid) {
+            return "thread stack bounds unavailable; copied no stack bytes";
+        }
+        if (slot.copied_stack_bytes == 0 && slot.stack_capacity > 0) {
+            return "interrupted stack pointer was outside discovered stack bounds";
+        }
+        return "";
+    case SLOT_SIGNAL_FAILED:
+        return std::string("signal delivery failed: ") + std::strerror(slot.signal_errno);
+    case SLOT_TIMEOUT:
+        return "thread did not run native stack snapshot handler before timeout";
+    case SLOT_UNSUPPORTED:
+        return "snapshot remote unwind collector supports Linux x86_64 only";
+    case SLOT_SIGNAL_BLOCKED:
+        return "thread blocks the native stack signal";
+    default:
+        return "unexpected pending state";
+    }
+}
