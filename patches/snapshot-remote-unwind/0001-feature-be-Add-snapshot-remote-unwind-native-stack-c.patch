+UnwindResult unwind_snapshot_frame_pointer(const ThreadCaptureSlot& slot, int max_frames,
+                                           const std::vector<MemoryMap>& maps) {
+    UnwindResult result;
+    result.method = "snapshot-frame-pointer";
+    if (slot.state.load(std::memory_order_acquire) != SLOT_SNAPSHOT_DONE) {
+        return result;
+    }
+    if (max_frames <= 0) {
+        return result;
+    }
+
+    if (slot.registers.rip != 0) {
+        result.frames.emplace_back(slot.registers.rip);
+    }
+    if (static_cast<int>(result.frames.size()) >= max_frames) {
+        result.truncated = true;
+        return result;
+    }
+
+    uintptr_t rbp = slot.registers.rbp;
+    if (rbp == 0) {
+        result.error_reason = "captured frame pointer is zero";
+        return result;
+    }
+    if ((rbp & (sizeof(uintptr_t) - 1)) != 0) {
+        result.error_reason = "captured frame pointer is unaligned";
+        return result;
+    }
+
+    while (static_cast<int>(result.frames.size()) < max_frames) {
+        uintptr_t next_rbp = 0;
+        uintptr_t return_address = 0;
+        if (!read_copied_stack_uintptr(slot, rbp, &next_rbp) ||
+            !read_copied_stack_uintptr(slot, rbp + sizeof(uintptr_t), &return_address)) {
+            result.error_reason = "frame pointer chain left copied stack snapshot";
+            break;
+        }
+        if (return_address == 0) {
+            break;
+        }
+        if (find_map_for_pc(maps, return_address) == nullptr) {
+            result.error_reason = "frame pointer return address is outside mapped objects";
+            break;
+        }
+        if (!result.frames.empty() && result.frames.back() == return_address) {
+            result.error_reason = "frame pointer unwind stopped on repeated PC";
+            break;
+        }
+        result.frames.emplace_back(return_address);
+
+        if (next_rbp == 0) {
+            break;
+        }
+        if (next_rbp <= rbp) {
+            result.error_reason = "frame pointer chain is not monotonic";
+            break;
+        }
+        if ((next_rbp & (sizeof(uintptr_t) - 1)) != 0) {
+            result.error_reason = "next frame pointer is unaligned";
+            break;
+        }
+        rbp = next_rbp;
+    }
+
+    result.truncated = static_cast<int>(result.frames.size()) >= max_frames;
+    if (result.error_reason.empty() && result.frames.size() == 1) {
+        result.error_reason = "frame pointer unwind stopped after the interrupted PC";
+    }
+    return result;
+}
+
+UnwindResult unwind_snapshot(unw_addr_space_t address_space, const unw_accessors_t* local_accessors,
+                             const ThreadCaptureSlot& slot, int max_frames,
+                             const std::vector<MemoryMap>& maps) {
+    UnwindResult result;
+    result.method = "libunwind-remote";
+    if (slot.state.load(std::memory_order_acquire) != SLOT_SNAPSHOT_DONE) {
+        return result;
+    }
+    if (max_frames <= 0) {
+        return result;
+    }
+
+    RemoteUnwindContext context;
+    context.slot = &slot;
+    context.maps = &maps;
+    context.local_accessors = local_accessors;
+
+    unw_cursor_t cursor;
+    int rc = unw_init_remote(&cursor, address_space, &context);
+    if (rc < 0) {
+        result.unwind_rc = rc;
+        result.error_reason = std::string("unw_init_remote failed: ") + unw_strerror(rc);
+        if (slot.registers.rip != 0) {
+            result.frames.emplace_back(slot.registers.rip);
+        }
+        return result;
+    }
+
+    uintptr_t previous_ip = 0;
+    uintptr_t previous_sp = 0;
+    while (static_cast<int64_t>(result.frames.size()) < max_frames) {
+        unw_word_t ip = 0;
+        rc = unw_get_reg(&cursor, UNW_REG_IP, &ip);
+        if (rc < 0) {
+            result.unwind_rc = rc;
+            result.error_reason = std::string("unw_get_reg(IP) failed: ") + unw_strerror(rc);
+            break;
+        }
+        if (ip == 0) {
+            break;
+        }
+
+        unw_word_t sp = 0;
+        const int sp_rc = unw_get_reg(&cursor, UNW_REG_SP, &sp);
+        if (ip == previous_ip && sp_rc >= 0 && sp == previous_sp) {
+            result.error_reason = "remote unwind stopped on repeated IP/SP";
+            break;
+        }
+        previous_ip = static_cast<uintptr_t>(ip);
+        previous_sp = sp_rc >= 0 ? static_cast<uintptr_t>(sp) : 0;
+        result.frames.emplace_back(static_cast<uintptr_t>(ip));
+
+        rc = unw_step(&cursor);
+        if (rc > 0) {
+            continue;
+        }
+        if (rc < 0) {
+            result.unwind_rc = rc;
+            if (result.error_reason.empty()) {
+                result.error_reason = std::string("unw_step failed: ") + unw_strerror(rc);
+            }
+        }
+        break;
+    }
+
+    result.truncated = static_cast<int64_t>(result.frames.size()) >= max_frames;
+    if (result.error_reason.empty() && result.frames.size() == 1) {
+        result.error_reason = "remote unwind stopped after the interrupted PC";
+    }
+    return result;
+}
