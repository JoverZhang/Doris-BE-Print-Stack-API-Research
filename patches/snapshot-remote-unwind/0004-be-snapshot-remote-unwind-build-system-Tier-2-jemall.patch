From bd1ba3db099a57b50ec928dd7d4eaaa5a43b93a6 Mon Sep 17 00:00:00 2001
From: mira <mira@example.invalid>
Date: Mon, 1 Jun 2026 00:24:12 +0800
Subject: [PATCH 4/4] (be) snapshot-remote-unwind build-system Tier 2 jemalloc
 rebuild hook + libunwind-generic link

Two changes:

1. Tier 2 prerequisite: add the same
   `build-jemalloc-prof-libunwind.sh` helper and
   `SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC` opt-in flag the other
   two libunwind variants ship. The script + flag is
   re-shipped per-variant by intent this round (the libunwind
   variants share the jemalloc rebuild dependency but their
   collector TUs diverge); a follow-up consolidation refactor
   into common is its own task after all three libunwind
   variants pass.

2. snapshot-remote-unwind-specific delta: link the BE against
   `libunwind-x86_64.a` (a.k.a. `libunwind-generic.a`) in
   addition to the local-only `libunwind.a`. Without the
   generic archive the remote symbols
   (`_Ux86_64_create_addr_space`, `_Ux86_64_init_remote`,
   `_Ux86_64_destroy_addr_space`,
   `_Ux86_64_dwarf_find_proc_info`,
   `_Ux86_64_dwarf_put_unwind_info`) do not resolve at link
   time. `liblzma.a` (which `libunwind-x86_64.a`
   references for XZ-compressed .debug_frame sections) is
   already in `COMMON_THIRDPARTY` via
   `add_thirdparty(lzma LIB64)` lower in the same file, so
   the WL_START_GROUP/--end-group wrapping around
   COMMON_THIRDPARTY resolves the lzma deps cleanly. The
   pre-verify probe (build-facts.md) confirmed this; the
   probe TU links 0 warnings with this set of archives in
   the same group.

Tier 1 keeps profiling OFF and leaves
SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC OFF; the prebuilt jemalloc
with libgcc backtracer is safe under this round's gate. Tier 2
(deferred per docs/phase2-acceptance.md) toggles the flag and
runs the script first; the build-facts.md in the variant's
evidence directory records the verification recipe.

Reference: <ck>'s contrib/jemalloc-cmake configures jemalloc with
--enable-prof-libunwind; thirdparty libunwind-x86_64.a (`nm`
confirms the four required `_Ux86_64_*` remote-mode symbols
are exported); pre-verify probe in
evidence/phase2/variants/snapshot-remote-unwind/build-facts.md.
Spec: docs/phase2-acceptance.md "Tier 2: Compatibility".
---
 be/CMakeLists.txt                         |  7 +++
 be/cmake/build-jemalloc-prof-libunwind.sh | 73 +++++++++++++++++++++++
 be/cmake/thirdparty.cmake                 | 47 ++++++++++++++-
 3 files changed, 126 insertions(+), 1 deletion(-)
 create mode 100755 be/cmake/build-jemalloc-prof-libunwind.sh

diff --git a/be/CMakeLists.txt b/be/CMakeLists.txt
index a55f01fd527..24367a79e4e 100644
--- a/be/CMakeLists.txt
+++ b/be/CMakeLists.txt
@@ -677,6 +677,13 @@ set(DORIS_DEPENDENCIES
 
 if (USE_UNWIND)
     set(DORIS_DEPENDENCIES ${DORIS_DEPENDENCIES} libunwind)
+    # Reason: snapshot-remote-unwind's coordinator pulls remote-mode symbols
+    # (`_Ux86_64_*`) only from `libunwind-x86_64.a` / `libunwind-generic.a`.
+    # The local archive in COMMON_THIRDPARTY only exposes the local-only
+    # `_ULx86_64_*` symbols. lzma (added below by COMMON_THIRDPARTY) is
+    # already inside the WL_START_GROUP that wraps both, so undefined
+    # `lzma_*` references in libunwind-x86_64.a resolve cleanly.
+    set(DORIS_DEPENDENCIES ${DORIS_DEPENDENCIES} libunwind_generic)
 endif()
 
 set(DORIS_DEPENDENCIES ${DORIS_DEPENDENCIES} orc)
diff --git a/be/cmake/build-jemalloc-prof-libunwind.sh b/be/cmake/build-jemalloc-prof-libunwind.sh
new file mode 100755
index 00000000000..11bb9ec3c3f
--- /dev/null
+++ b/be/cmake/build-jemalloc-prof-libunwind.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+# Reason: build jemalloc with --enable-prof-libunwind inside the worktree
+# (not in thirdparty), so heap profiling uses libunwind instead of libgcc.
+# This is the Tier 2 prerequisite for every variant whose handler unwinds
+# via libunwind AND overrides dl_iterate_phdr (ck-phdr-unwind, ob-kill60,
+# snapshot-remote-unwind). The prebuilt thirdparty jemalloc ships with the
+# libgcc backtracer, which re-enters dl_iterate_phdr through _Unwind_Backtrace
+# -> _Unwind_Find_FDE and deadlocks against the override under profiling
+# load (jemalloc/jemalloc#2504). Tier 1 leaves profiling off, so the
+# prebuilt jemalloc is safe under this round's gate; Tier 2 requires
+# running this script first, then re-running the BE build with
+# CK_PHDR_UNWIND_LOCAL_JEMALLOC=ON.
+# Reference: <ck>'s contrib/jemalloc-cmake configures jemalloc with the
+# same --enable-prof-libunwind flag.
+# Spec: docs/phase2-acceptance.md "Tier 2: Compatibility" -> jemalloc
+#       profiling on, then off.
+# Local: per-variant build helper; not invoked from the default Tier 1
+#        path. Run manually before a Tier 2 evaluation.
+set -euo pipefail
+
+# Tunables. JEMALLOC_VERSION matches the thirdparty pin
+# (thirdparty/vars.sh JEMALLOC_VERSION).
+JEMALLOC_VERSION="${JEMALLOC_VERSION:-5.3.0}"
+JEMALLOC_URL="${JEMALLOC_URL:-https://github.com/jemalloc/jemalloc/releases/download/${JEMALLOC_VERSION}/jemalloc-${JEMALLOC_VERSION}.tar.bz2}"
+TP_INSTALL="${DORIS_THIRDPARTY:-/var/local/thirdparty}/installed"
+SRC_DIR="${SRC_DIR:-.tmp/jemalloc-prof-libunwind-src}"
+BUILD_DIR="${BUILD_DIR:-.tmp/jemalloc-prof-libunwind-build}"
+OUT_LIB_DIR="${OUT_LIB_DIR:-.tmp/jemalloc-prof-libunwind}"
+
+mkdir -p "${SRC_DIR}" "${BUILD_DIR}" "${OUT_LIB_DIR}"
+
+# 1. Fetch and unpack jemalloc source if not already present.
+if [[ ! -f "${SRC_DIR}/jemalloc-${JEMALLOC_VERSION}/configure" ]]; then
+    echo "Fetching jemalloc-${JEMALLOC_VERSION} from ${JEMALLOC_URL}"
+    curl -fsSL "${JEMALLOC_URL}" -o "${SRC_DIR}/jemalloc.tar.bz2"
+    tar -xjf "${SRC_DIR}/jemalloc.tar.bz2" -C "${SRC_DIR}"
+fi
+
+# 2. Configure with --enable-prof-libunwind, pointing at the thirdparty
+#    libunwind headers + archive. The same flag values as the upstream
+#    thirdparty/build-thirdparty.sh build_jemalloc_doris() function:
+#    --with-jemalloc-prefix=je, --enable-prof, --disable-cxx,
+#    --disable-libdl, --disable-shared, --with-install-suffix=_doris.
+#    Adding --enable-prof-libunwind is the only material delta.
+cd "${SRC_DIR}/jemalloc-${JEMALLOC_VERSION}"
+CFLAGS="${CFLAGS:--O3 -fno-omit-frame-pointer}" \
+CPPFLAGS="-I${TP_INSTALL}/include" \
+LDFLAGS="-L${TP_INSTALL}/lib64" \
+./configure \
+    --prefix="${PWD}/../../${OUT_LIB_DIR}/install" \
+    --with-install-suffix="_doris" \
+    --with-jemalloc-prefix=je \
+    --enable-prof \
+    --enable-prof-libunwind \
+    --disable-cxx \
+    --disable-libdl \
+    --disable-shared
+
+# 3. Build and install into OUT_LIB_DIR.
+make -j "$(nproc)"
+make install
+
+# 4. Verify the backtrace method by reading config.log.
+if grep -q "^backtrace_method = 'libunwind'" config.log; then
+    echo "backtrace_method = 'libunwind' confirmed"
+else
+    echo "ERROR: backtrace_method != libunwind in config.log; libunwind detection failed" >&2
+    grep -E "backtrace_method|libunwind" config.log >&2 || true
+    exit 1
+fi
+
+echo "Local jemalloc with --enable-prof-libunwind built at ${OUT_LIB_DIR}/install"
+echo "Re-run cmake with -DCK_PHDR_UNWIND_LOCAL_JEMALLOC=ON to link against it."
diff --git a/be/cmake/thirdparty.cmake b/be/cmake/thirdparty.cmake
index 1dba907307d..f795e20dcba 100644
--- a/be/cmake/thirdparty.cmake
+++ b/be/cmake/thirdparty.cmake
@@ -80,13 +80,58 @@ add_thirdparty(crypto)
 add_thirdparty(openssl LIBNAME "lib/libssl.a")
 add_thirdparty(leveldb)
 if (USE_JEMALLOC)
-    add_thirdparty(jemalloc LIBNAME "lib/libjemalloc_doris.a")
+    # Reason: Tier 2 evaluations for libunwind variants need a jemalloc whose
+    # heap-profile backtracer uses libunwind, not libgcc. The prebuilt
+    # thirdparty jemalloc uses libgcc's _Unwind_Backtrace, which re-enters
+    # dl_iterate_phdr through _Unwind_Find_FDE and deadlocks against the
+    # lock-free override. The opt-in flag SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC
+    # swaps in a locally-built libjemalloc_doris.a configured with
+    # --enable-prof-libunwind (build it first via
+    # `be/cmake/build-jemalloc-prof-libunwind.sh`). Tier 1 keeps profiling
+    # OFF, so the prebuilt thirdparty jemalloc is safe under this round's
+    # gate and the flag defaults to OFF.
+    # Spec: docs/phase2-acceptance.md "Tier 2: Compatibility".
+    # Reference: <ck> contrib/jemalloc-cmake configures jemalloc with the
+    # same --enable-prof-libunwind flag.
+    option(SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC
+           "Link the locally-built jemalloc with --enable-prof-libunwind" OFF)
+    if (SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC)
+        set(_local_jemalloc_lib
+            "${CMAKE_SOURCE_DIR}/.tmp/jemalloc-prof-libunwind/install/lib/libjemalloc_doris.a")
+        if (NOT EXISTS "${_local_jemalloc_lib}")
+            message(FATAL_ERROR
+                "SNAPSHOT_REMOTE_UNWIND_LOCAL_JEMALLOC=ON but ${_local_jemalloc_lib} is missing;"
+                " run be/cmake/build-jemalloc-prof-libunwind.sh first.")
+        endif()
+        add_library(jemalloc STATIC IMPORTED)
+        set_target_properties(jemalloc PROPERTIES IMPORTED_LOCATION "${_local_jemalloc_lib}")
+        message(STATUS "Linking locally-built jemalloc with --enable-prof-libunwind: ${_local_jemalloc_lib}")
+    else()
+        add_thirdparty(jemalloc LIBNAME "lib/libjemalloc_doris.a")
+    endif()
 else()
     add_thirdparty(tcmalloc WHOLELIBPATH ${GPERFTOOLS_HOME}/lib/libtcmalloc.a NOTADD)
 endif()
 
 if (USE_UNWIND)
     add_thirdparty(libunwind LIBNAME "lib64/libunwind.a")
+    # Reason: snapshot-remote-unwind's coordinator calls libunwind's REMOTE
+    # API (`unw_create_addr_space`, `unw_init_remote`, `unw_destroy_addr_space`,
+    # plus `_Ux86_64_dwarf_find_proc_info`). The local-only `libunwind.a`
+    # archive only exports `_ULx86_64_*` symbols; the remote `_Ux86_64_*`
+    # symbols live in `libunwind-x86_64.a` (a.k.a. `libunwind-generic.a`),
+    # which the linked archive also references against `liblzma.a`
+    # (already added below via `lzma LIB64`). Adding it here as a separate
+    # IMPORTED target keeps the local archive in place for any code path
+    # that uses local-mode unwind (e.g. boost::stacktrace) while making
+    # the remote symbols resolvable for the snapshot-remote-unwind
+    # collector.
+    # Spec: docs/phase2-design.md "Variant Mechanics -> snapshot-remote-unwind".
+    # Reference: thirdparty libunwind/lib64/libunwind-x86_64.a (`nm` confirms
+    # `_Ux86_64_create_addr_space`, `_Ux86_64_init_remote`,
+    # `_Ux86_64_destroy_addr_space`, `_Ux86_64_dwarf_find_proc_info` are all
+    # exported); `liblzma.a` satisfies its `lzma_*` references.
+    add_thirdparty(libunwind_generic LIBNAME "lib64/libunwind-x86_64.a")
 endif()
 
 add_thirdparty(grpc++_reflection LIB64)
