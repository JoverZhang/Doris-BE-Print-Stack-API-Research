+std::string outcome_reason(const ThreadResult& r) {
+    switch (r.outcome) {
+    case ThreadOutcome::OK:
+        return r.frame_count == 0 ? "remote unwind returned no PCs" : "";
+    case ThreadOutcome::SKIPPED_SELF:
+        return "coordinator thread is not interrupted by the two-phase collector";
+    case ThreadOutcome::SIGNAL_FAILED: {
