-// Reason: enumerates BE threads from /proc/self/task as the canonical tid set.
-std::vector<int64_t> list_thread_ids() {
+// Reason: enumerate /proc/self/task via SYS_getdents64 mirroring OB's
+// iter_task. Avoids the opendir+readdir allocation pair, matching the
+// ob-kill60 coordinator's allocation-light pattern.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:99-141
+std::vector<int64_t> list_thread_ids(int64_t self_tid) {
+    struct linux_dirent64 {
+        ino64_t d_ino;
+        off64_t d_off;
+        unsigned short d_reclen;
+        unsigned char d_type;
+        char d_name[];
+    };
+
     std::vector<int64_t> tids;
-    std::error_code ec;
-    for (const auto& entry : std::filesystem::directory_iterator("/proc/self/task", ec)) {
-        int64_t tid = 0;
-        if (parse_i64(entry.path().filename().string(), &tid) && tid > 0) {
-            tids.emplace_back(tid);
-        }
-    }
-    if (ec) {
-        LOG(WARNING) << "failed to list /proc/self/task: " << ec.message();
+    int fd = ::open("/proc/self/task/", O_DIRECTORY | O_RDONLY);
+    if (fd == -1) {
+        return tids;
     }
+
+    char buf[4096];
+    ssize_t nread = 0;
+    do {
+        nread = syscall(SYS_getdents64, fd, buf, sizeof(buf));
+        if (nread <= 0) {
+            break;
+        }
+        ssize_t offset = 0;
+        while (offset < nread) {
+            auto* dirent = reinterpret_cast<linux_dirent64*>(buf + offset);
+            if (std::strcmp(dirent->d_name, ".") != 0 &&
+                std::strcmp(dirent->d_name, "..") != 0) {
+                int64_t tid = std::atoll(dirent->d_name);
+                if (tid > 0 && tid != self_tid) {
+                    tids.push_back(tid);
+                }
+            }
+            offset += dirent->d_reclen;
+        }
+    } while (nread > 0);
+
+    ::close(fd);
     std::sort(tids.begin(), tids.end());
     return tids;
 }
 
