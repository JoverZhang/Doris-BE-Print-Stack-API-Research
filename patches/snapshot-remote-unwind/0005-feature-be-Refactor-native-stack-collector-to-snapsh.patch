+// Reason: thin wrapper around rt_tgsigqueueinfo so call sites read like
+// "send capture signal" not "syscall(SYS_rt_tgsigqueueinfo, ...)". OB
+// only ships this path; no tgkill fallback because tgkill cannot carry
+// the anti-spoof req_id token in si_value.sival_ptr.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:304-310
+bool send_capture_signal(pid_t pid, int64_t tid, int64_t req_id, ThreadResult* result) {
+    siginfo_t si {};
+    si.si_code = SI_QUEUE;
+    si.si_value.sival_ptr = reinterpret_cast<void*>(req_id);
+    long rc = syscall(SYS_rt_tgsigqueueinfo, pid, static_cast<pid_t>(tid),
+                      srunwind::kMpSig, &si);
+    if (rc == 0) {
+        return true;
+    }
+    result->signal_errno = errno;
+    return false;
+}
+
+// Reason: poll the read end for `timeout_ms` and consume one int ack.
+// Mirrors OB wait_readable + read.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:78-92
+bool wait_ack(int read_fd, int timeout_ms, int* ack) {
+    struct pollfd pfd {};
+    pfd.fd = read_fd;
+    pfd.events = POLLIN;
+    while (true) {
+        int r = ::poll(&pfd, 1, timeout_ms);
+        if (r > 0 && (pfd.revents & POLLIN)) {
+            ssize_t n = ::read(read_fd, ack, sizeof(*ack));
+            return n == static_cast<ssize_t>(sizeof(*ack));
+        }
+        if (r == 0) {
+            return false; // timeout
+        }
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        return false;
+    }
+}
+
+// Reason: drive one worker through the two-phase exchange and pull the
+// snapshot out of the shared ctx. Mirrors OB task_process. The
+// coordinator holds srunwind::g_sig_handler_ctx_.lock() for the whole
+// call; the worker handler memcpy's its ucontext_t + stack slice into
+// the same ctx, posts prepare-ack, waits for process-done.
+//
+// Divergence from ob-kill60: the "processor" body that runs between
+// prepare-ack and process-done copies a register+stack snapshot rather
+// than a libunwind PC list. The actual frame walk happens AFTER the
+// per-thread series finishes, on the coordinator side, using the
+// snapshot remote-unwind accessors.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:280-347
+void task_process_one(pid_t pid, int64_t tid, int timeout_ms,
+                      ucontext_t* out_ucontext, unsigned char* out_stack_buf,
+                      uintptr_t* out_stack_base, int64_t* out_stack_bytes,
+                      bool* out_stack_truncated, ThreadResult* result) {
+    auto& ctx = srunwind::g_sig_handler_ctx_;
+    auto start = std::chrono::steady_clock::now();
+
+    // 1. Refresh stack bounds. The kernel grows the stack on demand, so a
+    //    bound from minutes ago is stale; refreshing each call clamps the
+    //    handler memcpy to the live VMA.
+    if (!srunwind::load_thread_stack_bounds(tid, &ctx.stack_low_, &ctx.stack_high_)) {
+        result->outcome = ThreadOutcome::STACK_BOUNDS_FAILED;
+        result->elapsed_us = elapsed_us(start);
+        return;
+    }
+
+    // 2. Stamp req_id and target_tid under the lock so the handler
+    //    observes coherent values. atomic_set_req_id mirrors OB :294.
+    int64_t req_id = s_req_id_counter.fetch_add(1, std::memory_order_acq_rel) + 1;
+    if (req_id == 0) {
+        req_id = s_req_id_counter.fetch_add(1, std::memory_order_acq_rel) + 1;
+    }
+    ctx.atomic_set_req_id(req_id);
+    ctx.target_tid_ = tid;
+    ctx.ucontext_valid_ = false;
+    ctx.stack_bytes_ = 0;
+    ctx.stack_base_ = 0;
+    ctx.stack_truncated_ = false;
+
+    // 3. Open per-request pipes (the worker handler reads fd2_[0] and
+    //    writes fd_[1]; the coordinator does the inverse).
+    //    Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:287-292
+    if (::pipe2(ctx.fd_, O_CLOEXEC) != 0 || ::pipe2(ctx.fd2_, O_CLOEXEC) != 0) {
+        result->signal_errno = errno;
+        if (ctx.fd_[0] != -1) ::close(ctx.fd_[0]);
+        if (ctx.fd_[1] != -1) ::close(ctx.fd_[1]);
+        if (ctx.fd2_[0] != -1) ::close(ctx.fd2_[0]);
+        if (ctx.fd2_[1] != -1) ::close(ctx.fd2_[1]);
+        ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+        ctx.atomic_set_req_id(0);
+        result->elapsed_us = elapsed_us(start);
+        return;
+    }
+
+    // 4. Send MP_SIG carrying req_id in sival_ptr (OB :304-309).
+    if (!send_capture_signal(pid, tid, req_id, result)) {
+        ::close(ctx.fd_[0]); ::close(ctx.fd_[1]);
+        ::close(ctx.fd2_[0]); ::close(ctx.fd2_[1]);
+        ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+        ctx.atomic_set_req_id(0);
+        result->elapsed_us = elapsed_us(start);
+        return;
+    }
+
+    // 5. Wait prepare-ack on fd_[0]. Worker has filled ctx.ucontext_ +
+    //    ctx.stack_buf_ by the time the ack arrives.
+    int ack = 0;
+    bool got_ack = wait_ack(ctx.fd_[0], timeout_ms, &ack);
+    if (got_ack) {
+        // 6. Copy snapshot OUT of the shared ctx into per-thread storage
+        //    before signalling the next worker. ucontext_t is sizeof
+        //    ~1 KiB on Linux/glibc; stack_buf is up to 8 KiB.
+        std::memcpy(out_ucontext, &ctx.ucontext_, sizeof(*out_ucontext));
+        std::memcpy(out_stack_buf, ctx.stack_buf_, sizeof(ctx.stack_buf_));
+        *out_stack_base = ctx.stack_base_;
+        *out_stack_bytes = ctx.stack_bytes_;
+        *out_stack_truncated = ctx.stack_truncated_;
+        result->copied_stack_bytes = ctx.stack_bytes_;
+        result->stack_truncated = ctx.stack_truncated_;
+        result->outcome = ctx.ucontext_valid_ ? ThreadOutcome::OK
+                                              : ThreadOutcome::UNSUPPORTED_ARCH;
+
+        // 7. Notify worker that processing is done (OB :330-332).
+        int peer_ack = ack;
+        ssize_t w = ::write(ctx.fd2_[1], &peer_ack, sizeof(peer_ack));
+        static_cast<void>(w);
+
+        // 8. Wait exit-ack so the worker has cleanly left the handler
+        //    before we close the pipes (OB :334-343).
+        int exit_ack = 0;
+        wait_ack(ctx.fd_[0], timeout_ms, &exit_ack);
+    } else {
+        result->outcome = ThreadOutcome::TIMEOUT;
+    }
+
+    ::close(ctx.fd_[0]); ::close(ctx.fd_[1]);
+    ::close(ctx.fd2_[0]); ::close(ctx.fd2_[1]);
+    ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+    ctx.atomic_set_req_id(0);
+    result->elapsed_us = elapsed_us(start);
+}
