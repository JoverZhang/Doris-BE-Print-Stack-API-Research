+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Reason: the shared collection seam. Every Phase 2 variant routes through
+// it; tests call these free functions directly, without forging an
+// HttpRequest. A free-function shape keeps `collect` per-variant and makes
+// the response shape, gate, and parsing testable in-process.
+// Spec: docs/phase2-design.md "Common API".
+namespace doris::native_stack {
+
+// Reason: one captured frame. The handler writes raw `pc`; resolve_dsos()
+// later adds `dso`/`dso_offset` from /proc/self/maps. No symbol fields —
+// symbolization is offline.
+struct Frame {
+    uintptr_t pc = 0;
+    std::string dso;          // empty until resolved, or if pc is unmapped.
+    uint64_t dso_offset = 0;
+    bool dso_resolved = false;
+};
+
+struct ThreadStack {
+    int64_t tid = 0;
+    // Reason: shared status vocabulary lets the orchestrator aggregate
+    // ok/partial/timeout without knowing variant-specific failure modes.
+    // Values: ok, timeout, signal_blocked, missing_tid, ...
+    std::string status;
+    bool truncated = false;
+    // Reason: handler walk time. <0 is the "not measured" sentinel (the stub).
+    int64_t handler_time_ns = -1;
+    std::string error_reason;  // empty when there is none.
+    std::vector<Frame> frames;
+};
+
+struct NativeStackReport {
+    std::string collector;  // "stub", "fp-walk", ...
+    // Reason: aggregated status across threads. `partial` means some threads
+    // returned frames and others did not; the per-thread `status` carries
+    // the detail.
+    std::string status;
+    int64_t timeout_ms = 0;
+    int64_t max_frames = 0;
+    int64_t max_stack_bytes = 0;
+    int64_t elapsed_ms = 0;
+    std::optional<int64_t> target_tid;
+    std::string error_reason;  // root-level reason (bad_request, contended timeout).
+    std::vector<ThreadStack> threads;
+};
+
+struct CollectOptions {
+    std::optional<int64_t> target_tid;  // dump one thread instead of all.
+    int64_t timeout_ms = 100;           // 1..60000.
+    int64_t max_frames = 64;            // 1..1024.
+    int64_t max_stack_bytes = 8192;     // 1..1048576.
+};
+
+// Reason: the only place `bad_request` is decided. Returns false and sets
+// *error_reason on invalid input, leaving *out untouched. Absent params take
+// their defaults.
+// Spec: docs/phase2-design.md "Common API" -> Request parameters.
+bool parse_collect_options(const std::map<std::string, std::string>& params, CollectOptions* out,
+                           std::string* error_reason);
+
+// Reason: the per-variant injection point. Given a live tid and the dump
+// deadline, fill *out (status, frames, handler_time_ns). The stub returns
+// "ok" with no frames; fp-walk does the signal + RBP walk.
+// Spec: docs/phase2-design.md "Common API" -> Mechanics.
+using CaptureFn = void (*)(int64_t tid, const CollectOptions& opts,
+                           std::chrono::steady_clock::time_point deadline, ThreadStack* out);
+
+// Reason: variant-agnostic orchestration. Each variant's
+// collect_native_stacks() composes this with its own capture; common owns
+// the single-dump gate, tid selection from /proc/self/task, the
+// unresponsive-tid test hook, and status aggregation, so only `capture`
+// differs across variants.
+// Spec: docs/phase2-design.md "Common API" -> Mechanics.
+NativeStackReport run_collection(const CollectOptions& opts, const char* collector_name,
+                                 CaptureFn capture);
+
+// Reason: the per-variant entry. Link-time indirection: the common build
+// ships a stub in native_stack_collect.cpp; each variant patch rewrites
+// only that one file.
+// Spec: docs/phase2-design.md "Common API".
+NativeStackReport collect_native_stacks(const CollectOptions& opts);
+
+// Reason: fills `dso`/`dso_offset` on every frame from /proc/self/maps. Runs
+// in the request thread (no signaling), so the in-handler path stays
+// async-signal-safe.
+void resolve_dsos(NativeStackReport* report);
+
+// Reason: writes the agreed JSON contract. Split from collection so tests
+// can assert on either the typed report or the JSON.
+// Spec: docs/phase2-design.md "Common API" -> Response shape.
+std::string serialize(const NativeStackReport& report);
+
+// --- Test-only hooks. They exercise the timeout and partial paths without
+// real signaling. Defined in common so every variant inherits them.
+// Spec: docs/phase2-test-plan.md "Test-only hooks in common".
+
+// Reason: mark one tid unresponsive — run_collection reports it `timeout`
+// without calling capture. Pass 0 to clear. Used by Timeout and
+// PartialResults.
+void set_unresponsive_tid_for_test(int64_t tid);
+
