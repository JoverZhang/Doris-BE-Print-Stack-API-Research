+
+#include "service/http/action/native_stack_action.h"
+
+#include <glog/logging.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <exception>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "service/http/http_channel.h"
+#include "service/http/http_headers.h"
+#include "service/http/http_request.h"
+#include "service/http/http_status.h"
+#include "util/easy_json.h"
+
+namespace doris {
+namespace {
+
+constexpr char kJsonContentType[] = "application/json";
+constexpr int64_t kDefaultTimeoutMs = 100;
+constexpr int64_t kDefaultMaxFrames = 64;
+constexpr int64_t kDefaultMaxStackBytes = 8192;
+
+std::atomic<bool> s_dump_running {false};
+
+class ScopedDumpSlot {
+public:
+    ScopedDumpSlot() {
+        bool expected = false;
+        _owns = s_dump_running.compare_exchange_strong(expected, true);
+    }
+
+    ~ScopedDumpSlot() {
+        if (_owns) {
+            s_dump_running.store(false);
+        }
+    }
+
+    bool owns() const { return _owns; }
+
+private:
+    bool _owns = false;
+};
+
+struct RequestOptions {
+    int64_t timeout_ms = kDefaultTimeoutMs;
+    int64_t max_frames = kDefaultMaxFrames;
+    int64_t max_stack_bytes = kDefaultMaxStackBytes;
+    int64_t test_sleep_ms = 0;
+    std::optional<int64_t> target_tid;
+};
+
+int64_t elapsed_ms(std::chrono::steady_clock::time_point start) {
+    return static_cast<int64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                        std::chrono::steady_clock::now() - start)
+                                        .count());
+}
+
+bool parse_i64(const std::string& value, int64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        int64_t result = static_cast<int64_t>(std::stoll(value, &consumed, 10));
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = result;
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+bool parse_optional_i64(const HttpRequest* req, const std::string& key, int64_t default_value,
+                        int64_t min_value, int64_t max_value, int64_t* parsed,
+                        std::string* error_reason) {
+    const std::string& raw = req->param(key);
+    if (raw.empty()) {
+        *parsed = default_value;
+        return true;
+    }
+
+    int64_t result = 0;
+    if (!parse_i64(raw, &result) || result < min_value || result > max_value) {
+        *error_reason = "invalid " + key;
+        return false;
+    }
+    *parsed = result;
+    return true;
+}
+
+bool parse_options(const HttpRequest* req, RequestOptions* options, std::string* error_reason) {
+    if (!parse_optional_i64(req, "timeout_ms", kDefaultTimeoutMs, 1, 60000, &options->timeout_ms,
+                            error_reason)) {
+        return false;
+    }
+    if (!parse_optional_i64(req, "max_frames", kDefaultMaxFrames, 1, 1024, &options->max_frames,
+                            error_reason)) {
+        return false;
+    }
+    if (!parse_optional_i64(req, "max_stack_bytes", kDefaultMaxStackBytes, 0, 1048576,
+                            &options->max_stack_bytes, error_reason)) {
+        return false;
+    }
+    if (!parse_optional_i64(req, "test_sleep_ms", 0, 0, 60000, &options->test_sleep_ms,
+                            error_reason)) {
+        return false;
+    }
+
+    const std::string& raw_tid = req->param("tid");
+    if (!raw_tid.empty()) {
+        int64_t tid = 0;
+        if (!parse_i64(raw_tid, &tid) || tid <= 0) {
+            *error_reason = "invalid tid";
+            return false;
+        }
+        options->target_tid = tid;
+    }
+    return true;
+}
+
+std::vector<int64_t> list_thread_ids() {
+    std::vector<int64_t> tids;
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator("/proc/self/task", ec)) {
+        int64_t tid = 0;
+        if (parse_i64(entry.path().filename().string(), &tid) && tid > 0) {
+            tids.emplace_back(tid);
+        }
+    }
+    if (ec) {
+        LOG(WARNING) << "failed to list /proc/self/task: " << ec.message();
+    }
+    std::sort(tids.begin(), tids.end());
+    return tids;
+}
+
+void fill_common_fields(EasyJson* root, const std::string& status, const RequestOptions& options,
+                        int64_t elapsed) {
+    (*root)["status"] = status;
+    (*root)["collector"] = "stub";
+    (*root)["timeout_ms"] = options.timeout_ms;
+    (*root)["max_frames_per_thread"] = options.max_frames;
+    (*root)["max_copied_stack_bytes"] = options.max_stack_bytes;
+    (*root)["elapsed_ms"] = elapsed;
+    if (options.target_tid.has_value()) {
+        (*root)["target_tid"] = options.target_tid.value();
+    }
+    root->Set("threads", EasyJson::kArray);
+}
+
+void append_stub_thread(EasyJson* threads, int64_t tid, const std::string& status,
+                        const std::string& error_reason) {
+    EasyJson thread = threads->PushBack(EasyJson::kObject);
+    thread["tid"] = tid;
+    thread["status"] = status;
+    thread["truncated"] = false;
+    if (!error_reason.empty()) {
+        thread["error_reason"] = error_reason;
+    }
+    thread.Set("frames", EasyJson::kArray);
+}
+
+EasyJson make_error_response(const std::string& status, const RequestOptions& options,
+                             int64_t elapsed, const std::string& error_reason) {
+    EasyJson root;
+    fill_common_fields(&root, status, options, elapsed);
+    root["error_reason"] = error_reason;
+    return root;
+}
+
+EasyJson collect_stub_stacks(const RequestOptions& options, int64_t elapsed) {
+    std::vector<int64_t> tids = list_thread_ids();
+    EasyJson root;
+    if (options.target_tid.has_value() &&
+        !std::binary_search(tids.begin(), tids.end(), options.target_tid.value())) {
+        fill_common_fields(&root, "missing_tid", options, elapsed);
+        EasyJson threads = root.Get("threads");
+        append_stub_thread(&threads, options.target_tid.value(), "missing_tid",
+                           "target tid is not present in /proc/self/task");
+        return root;
+    }
+
+    fill_common_fields(&root, "ok", options, elapsed);
+    EasyJson threads = root.Get("threads");
+    if (options.target_tid.has_value()) {
+        append_stub_thread(&threads, options.target_tid.value(), "ok", "stub collector has no PCs");
+        return root;
+    }
+
+    for (int64_t tid : tids) {
+        append_stub_thread(&threads, tid, "ok", "stub collector has no PCs");
+    }
+    return root;
+}
+
+} // namespace
+
+NativeStackAction::NativeStackAction(ExecEnv* exec_env, TPrivilegeHier::type hier,
+                                     TPrivilegeType::type type)
+        : HttpHandlerWithAuth(exec_env, hier, type) {}
+
+void NativeStackAction::handle(HttpRequest* req) {
+    req->add_output_header(HttpHeaders::CONTENT_TYPE, kJsonContentType);
+
+    const auto start = std::chrono::steady_clock::now();
+    RequestOptions options;
+    std::string error_reason;
+    if (!parse_options(req, &options, &error_reason)) {
+        HttpChannel::send_reply(
+                req, HttpStatus::BAD_REQUEST,
+                make_error_response("bad_request", options, elapsed_ms(start), error_reason)
+                        .ToString());
+        return;
+    }
+
+    ScopedDumpSlot slot;
+    if (!slot.owns()) {
+        HttpChannel::send_reply(req, HttpStatus::OK,
+                                make_error_response("busy", options, elapsed_ms(start),
+                                                    "another native stack dump is already running")
+                                        .ToString());
+        return;
+    }
+
+    if (options.test_sleep_ms > 0) {
+        std::this_thread::sleep_for(
+                std::chrono::milliseconds(std::min(options.test_sleep_ms, options.timeout_ms)));
+        if (options.test_sleep_ms > options.timeout_ms) {
+            HttpChannel::send_reply(req, HttpStatus::OK,
+                                    make_error_response("timeout", options, elapsed_ms(start),
+                                                        "test sleep exceeded timeout")
+                                            .ToString());
+            return;
+        }
+    }
+
+    EasyJson response = collect_stub_stacks(options, elapsed_ms(start));
+    HttpChannel::send_reply(req, HttpStatus::OK, response.ToString());
+}
+
+} // namespace doris
