+#include <chrono>
+#include <cstdint>
+
+#include "service/http/action/native_stack.h"
+
+// Reason: the per-variant collect step. The common build ships this stub;
+// each variant patch (fp-walk, ck-phdr-unwind, ...) rewrites only this file
+// with its real collector, so every other file in the seam stays put.
+// Spec: docs/phase2-design.md "Common API" -> stub collect().
+namespace doris::native_stack {
+namespace {
+
+// Reason: the stub proves the response shape and the single-dump gate
+// without real signaling — every live thread reports `ok` with no frames.
+// `run_collection` owns the gate, tid selection, and aggregation, so the
+// stub only fills status.
+void stub_capture(int64_t /*tid*/, const CollectOptions& /*opts*/,
+                  std::chrono::steady_clock::time_point /*deadline*/, ThreadStack* out) {
+    out->status = "ok";
+}
+
+} // namespace
+
+NativeStackReport collect_native_stacks(const CollectOptions& opts) {
+    return run_collection(opts, "stub", stub_capture);
+}
+
+// Reason: stub side of the fp-walk RBP-safety test hook. The test gates
+// every call on `collector_is_stub()` and skips, so the stub's return
+// value is never inspected. Defining it here keeps the test file
+// linkable on the common build, where no fp-walk-specific code exists.
+// Local: test hook.
+bool rbp_can_read_for_test(uintptr_t /*initial_rbp*/, uintptr_t /*rbp*/,
+                           uintptr_t /*max_stack_bytes*/) {
+    return false;
+}
+
+// Reason: stub side of the fp-walk handler-pause hook. The stub has no
+// signal handler to pause; the late-handler corruption test gates on
+// `collector_is_stub()` and skips, so this no-op only exists to keep
+// the test file linkable on the common build.
+// Local: test hook.
+void pause_handler_for_tid_for_test(int64_t /*tid*/) {}
+
+} // namespace doris::native_stack
