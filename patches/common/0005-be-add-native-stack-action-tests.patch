+// Reason: tests call the common free functions directly, not through an
+// HttpRequest. This file ships in patches/common/, so every variant carries
+// it. Contract and stability cases run on the stub and on a real collector;
+// correctness and boundary cases start with `if (collector_is_stub())
+// GTEST_SKIP();` so they run only on a real collector.
+// Spec: docs/phase2-test-plan.md.
+namespace doris::native_stack {
+namespace {
+
+int64_t self_tid() {
+    return static_cast<int64_t>(syscall(SYS_gettid));
+}
+
+// Reason: the realtime signal fp-walk uses. Centralized so the SignalBlocked
+// case blocks the same number the collector sends.
+int native_stack_signal() {
+    return SIGRTMIN + 6;
+}
+
+// Reason: round-trip helper. EasyJson builds; tests parse back with
+// rapidjson so the assertions don't depend on the builder's API.
+rapidjson::Document parse_report(const NativeStackReport& report) {
+    const std::string body = serialize(report);
+    rapidjson::Document doc;
+    doc.Parse(body.c_str());
+    return doc;
+}
+
+// Reason: walks the JSON recursively and fails if any symbol-like key
+// appears. The contract carries raw PCs only — symbolization is offline.
+void expect_no_symbol_keys(const rapidjson::Value& value) {
+    static const std::set<std::string> kForbidden = {"function", "func",      "file", "line",
+                                                     "symbol",   "demangled", "name"};
+    if (value.IsObject()) {
+        for (auto it = value.MemberBegin(); it != value.MemberEnd(); ++it) {
+            EXPECT_EQ(kForbidden.count(it->name.GetString()), 0U)
+                    << "symbol-like key leaked: " << it->name.GetString();
+            expect_no_symbol_keys(it->value);
+        }
+    } else if (value.IsArray()) {
+        for (const auto& element : value.GetArray()) {
+            expect_no_symbol_keys(element);
+        }
+    }
+}
+
+// Reason: true on the common build's stub collector. Correctness and
+// boundary cases skip on it because they need real frames.
+bool collector_is_stub() {
+    return collect_native_stacks(CollectOptions {}).collector == "stub";
+}
+
+// Reason: one parsed /proc/self/maps row. Mirrors the fields the test
+// needs to verify the dso_offset formula against the same map the
+// collector resolved from.
+// Local: test-only struct.
+struct DsoSegment {
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    uint64_t offset = 0;
+    std::string path;
+};
+
+// Reason: find the /proc/self/maps row that contains `pc` and whose
+// pathname matches `dso`. Returns the segment so case 8 can compute the
+// load base (`start - offset`) and check `base + dso_offset == pc`. Uses
+// substring match so a basename-only `dso` still finds the absolute path.
+// Local: test helper for case 8's formula check.
+bool find_dso_segment(uintptr_t pc, const std::string& dso, DsoSegment* out) {
+    std::ifstream maps("/proc/self/maps");
+    std::string line;
+    while (std::getline(maps, line)) {
+        const auto dash = line.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+        const auto space_after_range = line.find(' ', dash);
+        if (space_after_range == std::string::npos) {
+            continue;
+        }
+        uintptr_t start = 0;
+        uintptr_t end = 0;
+        try {
+            start = std::stoull(line.substr(0, dash), nullptr, 16);
+            end = std::stoull(line.substr(dash + 1, space_after_range - dash - 1), nullptr, 16);
+        } catch (...) {
+            continue;
+        }
+        if (pc < start || pc >= end) {
+            continue;
+        }
+        // The pathname is the last whitespace-separated field. The offset
+        // is the 3rd field overall.
+        std::istringstream iss(line.substr(space_after_range + 1));
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+        std::string path;
+        std::getline(iss, path);
+        const auto first = path.find_first_not_of(' ');
+        if (first == std::string::npos) {
+            continue;
+        }
+        path = path.substr(first);
+        if (path.find(dso) == std::string::npos && dso.find(path) == std::string::npos) {
+            continue;
+        }
+        uint64_t offset = 0;
+        try {
+            offset = std::stoull(offset_hex, nullptr, 16);
+        } catch (...) {
+            continue;
+        }
+        out->start = start;
+        out->end = end;
+        out->offset = offset;
+        out->path = std::move(path);
+        return true;
+    }
+    return false;
+}
