+// Reason: a worker parked on a condition variable that publishes its tid.
+// Cheap fixture for cases that need a live, targetable thread but no real
+// stack content.
+// Local: test-only fixture.
+class ParkedThread {
+public:
+    ParkedThread() {
+        _thread = std::thread([this] {
+            _tid.store(self_tid(), std::memory_order_release);
+            std::unique_lock<std::mutex> lock(_mutex);
+            _cv.wait(lock, [this] { return _release; });
+        });
+        while (_tid.load(std::memory_order_acquire) == 0) {
+            std::this_thread::yield();
+        }
+    }
+    ParkedThread(const ParkedThread&) = delete;
+    ParkedThread& operator=(const ParkedThread&) = delete;
+    ~ParkedThread() {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _release = true;
+        }
+        _cv.notify_all();
+        if (_thread.joinable()) {
+            _thread.join();
+        }
+    }
+    int64_t tid() const { return _tid.load(std::memory_order_acquire); }
+
+private:
+    std::thread _thread;
+    std::atomic<int64_t> _tid {0};
+    std::mutex _mutex;
+    std::condition_variable _cv;
+    bool _release = false;
+};
+
+// Reason: a worker busy-spinning in a non-trivial frame, so it has a real
+// walkable RBP chain at the point the handler interrupts it.
+// Local: test-only fixture.
+class SpinThread {
+public:
+    SpinThread() {
+        _thread = std::thread([this] {
+            _tid.store(self_tid(), std::memory_order_release);
+            while (!_stop.load(std::memory_order_acquire)) {
+                volatile int sink = 0;
+                (void)sink;
+            }
+        });
+        while (_tid.load(std::memory_order_acquire) == 0) {
+            std::this_thread::yield();
+        }
+    }
+    SpinThread(const SpinThread&) = delete;
+    SpinThread& operator=(const SpinThread&) = delete;
+    ~SpinThread() {
+        _stop.store(true, std::memory_order_release);
+        if (_thread.joinable()) {
+            _thread.join();
+        }
+    }
+    int64_t tid() const { return _tid.load(std::memory_order_acquire); }
+
+private:
+    std::thread _thread;
+    std::atomic<int64_t> _tid {0};
+    std::atomic<bool> _stop {false};
+};
+
+// Reason: a worker that descends a known four-level call chain and busy-spins
+// at the bottom, recording each caller's return PC. The walked frames, from
+// the spin outward, are those addresses in reverse, so KnownChainResolved
+// can check them in order. `noinline` and the trailing asm keep each frame
+// distinct and on the stack at -O0.
+// Local: test-only fixture.
+class MarkerChain {
+public:
+    MarkerChain() {
+        _thread = std::thread([this] { level_a(); });
+        while (_tid.load(std::memory_order_acquire) == 0) {
+            std::this_thread::yield();
+        }
+    }
+    MarkerChain(const MarkerChain&) = delete;
+    MarkerChain& operator=(const MarkerChain&) = delete;
+    ~MarkerChain() {
+        _stop.store(true, std::memory_order_release);
+        if (_thread.joinable()) {
+            _thread.join();
+        }
+    }
+    int64_t tid() const { return _tid.load(std::memory_order_acquire); }
+    // Reason: return addresses in call order — level_a's caller first,
+    // spin's caller last. KnownChainResolved walks them in reverse.
+    const std::vector<uintptr_t>& returns() const { return _returns; }
+
+private:
+    __attribute__((noinline)) void spin() {
+        _returns.push_back(reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+        _tid.store(self_tid(), std::memory_order_release);
+        while (!_stop.load(std::memory_order_acquire)) {
+            volatile int sink = 0;
+            (void)sink;
+        }
+    }
+    __attribute__((noinline)) void level_c() {
+        _returns.push_back(reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+        spin();
+        asm volatile("");
+    }
+    __attribute__((noinline)) void level_b() {
+        _returns.push_back(reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+        level_c();
+        asm volatile("");
+    }
+    __attribute__((noinline)) void level_a() {
+        _returns.push_back(reinterpret_cast<uintptr_t>(__builtin_return_address(0)));
+        level_b();
+        asm volatile("");
+    }
+    std::thread _thread;
+    std::atomic<int64_t> _tid {0};
+    std::atomic<bool> _stop {false};
+    std::vector<uintptr_t> _returns;
+};
+
+// Reason: a worker that recurses to a fixed depth and busy-spins at the
+// bottom, leaving a deep walkable chain. Used to exercise the max_frames
+// truncation bound.
+// Local: test-only fixture.
+class RecursiveSpinThread {
+public:
+    explicit RecursiveSpinThread(int depth) {
+        _thread = std::thread([this, depth] { recurse(depth); });
+        while (_tid.load(std::memory_order_acquire) == 0) {
+            std::this_thread::yield();
+        }
+    }
+    RecursiveSpinThread(const RecursiveSpinThread&) = delete;
+    RecursiveSpinThread& operator=(const RecursiveSpinThread&) = delete;
+    ~RecursiveSpinThread() {
+        _stop.store(true, std::memory_order_release);
+        if (_thread.joinable()) {
+            _thread.join();
+        }
+    }
+    int64_t tid() const { return _tid.load(std::memory_order_acquire); }
+
+private:
+    __attribute__((noinline)) void recurse(int depth) {
+        if (depth > 0) {
+            recurse(depth - 1);
+            asm volatile("");
+            return;
+        }
+        _tid.store(self_tid(), std::memory_order_release);
+        while (!_stop.load(std::memory_order_acquire)) {
+            volatile int sink = 0;
+            (void)sink;
+        }
+    }
+    std::thread _thread;
+    std::atomic<int64_t> _tid {0};
+    std::atomic<bool> _stop {false};
+};
+
+} // namespace
+
+class NativeStackActionTest : public ::testing::Test {
+protected:
+    void TearDown() override { set_unresponsive_tid_for_test(0); }
+};
+
+// Reason: [case 1] catches drift in the JSON contract. Required root and
+// per-thread keys are present. An all-thread dump carries no target_tid.
+// Frame objects hold only pc, dso, dso_offset. No symbol-like key leaks.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #1 Schema.
+TEST_F(NativeStackActionTest, Schema) {
+    // 1. Run the full pipeline.
+    CollectOptions opts;
+    NativeStackReport report = collect_native_stacks(opts);
+    resolve_dsos(&report);
+    rapidjson::Document doc = parse_report(report);
+
+    // 2. JSON parses to a root object.
+    ASSERT_FALSE(doc.HasParseError());
+    ASSERT_TRUE(doc.IsObject());
+
+    // 3. Required root keys present; target_tid absent on an all-thread dump.
+    for (const char* key : {"collector", "status", "timeout_ms", "max_frames_per_thread",
+                            "max_copied_stack_bytes", "elapsed_ms", "threads"}) {
+        ASSERT_TRUE(doc.HasMember(key)) << "missing root key: " << key;
+    }
+    EXPECT_TRUE(doc["collector"].IsString());
+    EXPECT_FALSE(std::string(doc["collector"].GetString()).empty());
+    EXPECT_TRUE(doc["threads"].IsArray());
+    EXPECT_FALSE(doc.HasMember("target_tid"));
+
+    // 4. Each thread carries required keys; each frame carries only pc/dso/dso_offset.
+    for (const auto& thread : doc["threads"].GetArray()) {
+        ASSERT_TRUE(thread.IsObject());
+        for (const char* key : {"tid", "status", "truncated", "frames"}) {
+            ASSERT_TRUE(thread.HasMember(key)) << "missing thread key: " << key;
+        }
+        EXPECT_TRUE(thread["frames"].IsArray());
+        for (const auto& frame : thread["frames"].GetArray()) {
+            ASSERT_TRUE(frame.IsObject());
+            ASSERT_TRUE(frame.HasMember("pc"));
+            ASSERT_TRUE(frame.HasMember("dso"));
+            ASSERT_TRUE(frame.HasMember("dso_offset"));
+            EXPECT_EQ(frame.MemberCount(), 3U) << "frame carries unexpected members";
+        }
+    }
+
+    // 5. No symbol-like key appears anywhere.
+    expect_no_symbol_keys(doc);
+}
+
+// Reason: [case 2] a targeted dump returns exactly one thread entry, with
+// tid matching the request and root target_tid carrying the same value.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #2 ShapeOneTid.
+TEST_F(NativeStackActionTest, ShapeOneTid) {
+    // 1. Park a worker so its tid is live and targetable.
+    ParkedThread worker;
+    CollectOptions opts;
+    opts.target_tid = worker.tid();
+
+    // 2. Collect targeting that one tid.
+    NativeStackReport report = collect_native_stacks(opts);
+    resolve_dsos(&report);
+    rapidjson::Document doc = parse_report(report);
+
+    // 3. Exactly one thread entry, with the requested tid.
+    ASSERT_FALSE(doc.HasParseError());
+    ASSERT_TRUE(doc["threads"].IsArray());
+    ASSERT_EQ(doc["threads"].Size(), 1U);
+    EXPECT_EQ(doc["threads"][0]["tid"].GetInt64(), worker.tid());
+
+    // 4. Root target_tid carries the requested tid.
+    ASSERT_TRUE(doc.HasMember("target_tid"));
+    EXPECT_EQ(doc["target_tid"].GetInt64(), worker.tid());
+}
+
+// Reason: [case 3] requesting a tid that is not present returns
+// missing_tid with an error reason and no frames.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #3 MissingTid.
+TEST_F(NativeStackActionTest, MissingTid) {
+    // 1. Request a tid far above any pid_max so the lookup must fail.
+    CollectOptions opts;
+    opts.target_tid = static_cast<int64_t>(1) << 40;
+    NativeStackReport report = collect_native_stacks(opts);
+
+    // 2. Status is missing_tid with a non-empty reason and no frames.
+    EXPECT_EQ(report.status, "missing_tid");
+    EXPECT_FALSE(report.error_reason.empty());
+    for (const auto& thread : report.threads) {
+        EXPECT_TRUE(thread.frames.empty());
+    }
+
+    // 3. JSON surface carries the same status.
+    rapidjson::Document doc = parse_report(report);
+    ASSERT_FALSE(doc.HasParseError());
+    EXPECT_STREQ(doc["status"].GetString(), "missing_tid");
+}
+
+// Reason: [case 4] parse_collect_options is the only bad_request choke
+// point. Each bad input is rejected with a reason; no collection runs.
+// A valid request parses to the carried values.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #4 BadRequest.
+TEST_F(NativeStackActionTest, BadRequest) {
+    // 1. A helper that asserts the params are rejected with a non-empty reason.
+    auto rejected = [](std::map<std::string, std::string> params) {
+        CollectOptions opts;
+        std::string reason;
+        EXPECT_FALSE(parse_collect_options(params, &opts, &reason));
+        EXPECT_FALSE(reason.empty());
+    };
+
+    // 2. Every bad input shape is rejected.
+    rejected({{"tid", "0"}});
+    rejected({{"tid", "-5"}});
+    rejected({{"tid", "12x"}});
+    rejected({{"timeout_ms", "0"}});
+    rejected({{"timeout_ms", "60001"}});
+    rejected({{"timeout_ms", "abc"}});
+    rejected({{"max_frames", "0"}});
+
+    // 3. A valid request parses, with the supplied values carried through.
+    CollectOptions opts;
+    std::string reason;
+    EXPECT_TRUE(
+            parse_collect_options({{"timeout_ms", "50"}, {"max_frames", "32"}}, &opts, &reason));
+    EXPECT_EQ(opts.timeout_ms, 50);
+    EXPECT_EQ(opts.max_frames, 32);
+}
+
+// Reason: [case 5] a second dump that contends on the single-dump gate
+// returns timeout with no threads; once the lock is released, the next
+// dump succeeds. The contended collect runs on another thread to avoid
+// re-locking a non-recursive mutex on the holder thread.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #5 ContendedDumpReturnsTimeout.
+TEST_F(NativeStackActionTest, ContendedDumpReturnsTimeout) {
+    NativeStackReport contended;
+    {
+        // 1. Hold the dump gate.
+        DumpLockGuard guard = hold_dump_lock_for_test();
+
+        // 2. A concurrent collect with a small timeout returns timeout.
+        std::thread collector([&contended] {
+            CollectOptions opts;
+            opts.timeout_ms = 20;
+            contended = collect_native_stacks(opts);
+        });
+        collector.join();
+        EXPECT_EQ(contended.status, "timeout");
+        EXPECT_TRUE(contended.threads.empty());
+    }
+
+    // 3. Release the gate; the next collect succeeds.
+    NativeStackReport after = collect_native_stacks(CollectOptions {});
+    EXPECT_NE(after.status, "timeout");
+}
+
+// Reason: [case 6] the unresponsive-tid hook reports the marked tid as
+// `timeout` without calling capture; clearing the hook restores normal
+// collection.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #6 Timeout.
+TEST_F(NativeStackActionTest, Timeout) {
+    // 1. Mark a present tid (this thread) unresponsive.
+    const int64_t target = self_tid();
+    set_unresponsive_tid_for_test(target);
+
+    // 2. A collect targeting that tid reports timeout per-thread and overall.
+    CollectOptions opts;
+    opts.target_tid = target;
+    opts.timeout_ms = 20;
+    NativeStackReport report = collect_native_stacks(opts);
+    ASSERT_EQ(report.threads.size(), 1U);
+    EXPECT_EQ(report.threads[0].status, "timeout");
+    EXPECT_EQ(report.status, "timeout");
+
+    // 3. Clear the hook; the next dump succeeds.
+    set_unresponsive_tid_for_test(0);
+    NativeStackReport after = collect_native_stacks(CollectOptions {});
+    EXPECT_NE(after.status, "timeout");
+}
+
+// Reason: [case 7] every active worker thread returns at least one
+// non-zero pc, proving the per-variant capture actually walked.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #7 NonZeroPcPerActiveThread.
+TEST_F(NativeStackActionTest, NonZeroPcPerActiveThread) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. Spawn K busy-spinning workers; record their tids.
+    constexpr int kWorkers = 4;
+    std::vector<std::unique_ptr<SpinThread>> workers;
+    std::set<int64_t> worker_tids;
+    for (int i = 0; i < kWorkers; ++i) {
+        workers.push_back(std::make_unique<SpinThread>());
+        worker_tids.insert(workers.back()->tid());
+    }
+
+    // 2. Dump all threads; assert each worker has an `ok` status with at
+    //    least one non-zero pc.
+    NativeStackReport report = collect_native_stacks(CollectOptions {});
+    int seen = 0;
+    for (const auto& thread : report.threads) {
+        if (worker_tids.count(thread.tid) == 0) {
+            continue;
+        }
+        ++seen;
+        EXPECT_EQ(thread.status, "ok") << "tid " << thread.tid;
+        ASSERT_FALSE(thread.frames.empty()) << "tid " << thread.tid;
+        bool any_nonzero = false;
+        for (const auto& frame : thread.frames) {
+            any_nonzero = any_nonzero || frame.pc != 0;
+        }
+        EXPECT_TRUE(any_nonzero) << "tid " << thread.tid;
+    }
+
+    // 3. Every worker was visited.
+    EXPECT_EQ(seen, kWorkers);
+}
+
+// Reason: [case 8] a known call chain parks at its deepest frame; the
+// dump's walked frames contain the recorded return addresses as a
+// contiguous subsequence in caller order, beginning within the first two
+// walked frames (the test plan targets frames[1..4]; -O0 + ASan
+// sometimes interposes one extra frame between the RIP and the recorded
+// chain). Every walked frame resolves to a mapped DSO, and dso_offset
+// matches the formula `segment_base + offset == pc`. handler_time_ns is
+// present and non-negative.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #8 KnownChainResolved.
+TEST_F(NativeStackActionTest, KnownChainResolved) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. Park the marker chain so its return addresses are recorded.
+    MarkerChain chain;
+    CollectOptions opts;
+    opts.target_tid = chain.tid();
+
+    // 2. Collect and resolve DSOs.
+    NativeStackReport report = collect_native_stacks(opts);
+    resolve_dsos(&report);
+
+    // 3. Basic shape: one thread, ok status, at least 5 frames, non-zero PC0,
+    //    handler time present.
+    ASSERT_EQ(report.threads.size(), 1U);
+    const ThreadStack& thread = report.threads[0];
+    ASSERT_EQ(thread.status, "ok");
+    ASSERT_GE(thread.frames.size(), 5U);
+    EXPECT_NE(thread.frames[0].pc, 0U);
+    EXPECT_GE(thread.handler_time_ns, 0);
+
+    // 4. The four recorded return addresses appear in the walked frames
+    //    as a contiguous subsequence in caller order (spin's caller, then
+    //    level_c's, level_b's, level_a's). The subsequence MUST start
+    //    within the first three walked frames — anything later means the
+    //    walk inserted unexplained intermediate frames. The test plan
+    //    targets frames[1..4]; with -O0 + ASan the walk sometimes
+    //    interposes one extra frame before the chain begins, so we accept
+    //    frames[1..4] OR frames[2..5] but reject any larger offset.
+    const std::vector<uintptr_t>& returns = chain.returns();
+    ASSERT_EQ(returns.size(), 4U);
+    std::vector<uintptr_t> pcs;
+    pcs.reserve(thread.frames.size());
+    for (const Frame& frame : thread.frames) {
+        pcs.push_back(frame.pc);
+    }
+    auto chain_start = std::find(pcs.begin(), pcs.end(), returns.back());
+    ASSERT_NE(chain_start, pcs.end()) << "spin's recorded return not in walked frames";
+    const auto chain_offset = static_cast<size_t>(chain_start - pcs.begin());
+    EXPECT_GE(chain_offset, 1U) << "chain found at frame[0] — RIP should sit before it";
+    EXPECT_LE(chain_offset, 2U)
+            << "chain found at frame[" << chain_offset
+            << "] — walk inserted too many frames before the recorded chain";
+    ASSERT_LE(chain_offset + returns.size(), pcs.size());
+    for (size_t i = 0; i < returns.size(); ++i) {
+        EXPECT_EQ(pcs[chain_offset + i], returns[returns.size() - 1 - i])
+                << "chain frame " << i << " mismatch (offset " << chain_offset << ")";
+    }
+
+    // 5. Every walked frame resolves to a mapped DSO and the dso_offset
+    //    formula `segment_base + dso_offset == pc` holds, where
+    //    segment_base is `map.start - map.offset` for the /proc/self/maps
+    //    row that contains pc and matches dso.
+    for (const Frame& frame : thread.frames) {
+        EXPECT_TRUE(frame.dso_resolved) << "pc " << std::hex << frame.pc << " unresolved";
+        ASSERT_FALSE(frame.dso.empty());
+        DsoSegment segment;
+        ASSERT_TRUE(find_dso_segment(frame.pc, frame.dso, &segment))
+                << "no /proc/self/maps row matched pc=" << std::hex << frame.pc
+                << " dso=" << frame.dso;
+        const uintptr_t segment_base = segment.start - segment.offset;
+        EXPECT_EQ(segment_base + frame.dso_offset, frame.pc)
+                << "dso_offset formula failed: base=" << std::hex << segment_base
+                << " offset=" << frame.dso_offset << " pc=" << frame.pc;
+    }
+}
+
+// Reason: [case 9] a chain deeper than N truncates at max_frames N with
+// `truncated = true`; a generous N does not truncate.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #9 Truncated.
+TEST_F(NativeStackActionTest, Truncated) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. A deep chain capped at max_frames = 4 truncates at the cap.
+    RecursiveSpinThread worker(32);
+    CollectOptions bounded;
+    bounded.target_tid = worker.tid();
+    bounded.max_frames = 4;
+    NativeStackReport report = collect_native_stacks(bounded);
+    ASSERT_EQ(report.threads.size(), 1U);
+    EXPECT_EQ(report.threads[0].frames.size(), 4U);
+    EXPECT_TRUE(report.threads[0].truncated);
+
+    // 2. Control: a generous cap on the same chain returns truncated = false.
+    CollectOptions generous;
+    generous.target_tid = worker.tid();
+    generous.max_frames = 256;
+    generous.max_stack_bytes = 1048576;
+    NativeStackReport control = collect_native_stacks(generous);
+    ASSERT_EQ(control.threads.size(), 1U);
+    EXPECT_FALSE(control.threads[0].truncated);
+    EXPECT_GT(control.threads[0].frames.size(), 4U);
+}
+
+// Reason: [case 10] a thread that blocks SIGRTMIN+6 with pthread_sigmask
+// is reported `signal_blocked`, distinct from `timeout`. This is the only
+// way the harness distinguishes "thread cannot be signalled" from "thread
+// did not respond in time".
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #10 SignalBlocked.
+TEST_F(NativeStackActionTest, SignalBlocked) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. Spawn a worker that blocks the collector signal and parks.
+    std::atomic<int64_t> tid {0};
+    std::atomic<bool> stop {false};
+    std::thread worker([&tid, &stop] {
+        sigset_t set;
+        sigemptyset(&set);
+        sigaddset(&set, native_stack_signal());
+        pthread_sigmask(SIG_BLOCK, &set, nullptr);
+        tid.store(self_tid(), std::memory_order_release);
+        while (!stop.load(std::memory_order_acquire)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+    });
+    while (tid.load(std::memory_order_acquire) == 0) {
+        std::this_thread::yield();
+    }
+
+    // 2. Collect targeting that worker.
+    CollectOptions opts;
+    opts.target_tid = tid.load(std::memory_order_acquire);
+    NativeStackReport report = collect_native_stacks(opts);
+
+    // 3. Cleanup.
+    stop.store(true, std::memory_order_release);
+    worker.join();
+
+    // 4. The per-thread status is signal_blocked, not timeout.
+    ASSERT_EQ(report.threads.size(), 1U);
+    EXPECT_EQ(report.threads[0].status, "signal_blocked");
+}
+
+// Reason: [case 11] responsive parked threads plus one unresponsive — the
+// responsive ones carry frames, the unresponsive one is `timeout`, the
+// overall status is `partial`, and the process stays healthy.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #11 PartialResults.
+TEST_F(NativeStackActionTest, PartialResults) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. Spawn two responsive workers plus one tagged as unresponsive.
+    SpinThread responsive_a;
+    SpinThread responsive_b;
+    ParkedThread unresponsive;
+    set_unresponsive_tid_for_test(unresponsive.tid());
+
+    // 2. Dump all threads.
+    NativeStackReport report = collect_native_stacks(CollectOptions {});
+
+    // 3. Overall status is partial.
+    EXPECT_EQ(report.status, "partial");
+
+    // 4. The unresponsive worker is `timeout`; each responsive worker has frames.
+    for (const auto& thread : report.threads) {
+        if (thread.tid == unresponsive.tid()) {
+            EXPECT_EQ(thread.status, "timeout");
+        } else if (thread.tid == responsive_a.tid() || thread.tid == responsive_b.tid()) {
+            EXPECT_EQ(thread.status, "ok");
+            EXPECT_FALSE(thread.frames.empty());
+        }
+    }
+}
+
+// Reason: [case 12] two sequential dumps of the same tid must not
+// misattribute their results or leak data from dump 1 into dump 2. With
+// fp-walk's per-sequence slot ring, two sequential dumps land in
+// distinct slots (seq=K and seq=K+1 map to different ring entries), so
+// the shared-slot hazard does not exist. Case 15 stresses the late
+// handler path under load; deterministic use-after-free detection is the
+// TSan deepening under Tier 2.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #12 LateResponderDoesNotCorruptNextDump.
+TEST_F(NativeStackActionTest, LateResponderDoesNotCorruptNextDump) {
+    if (collector_is_stub()) {
+        GTEST_SKIP();
+    }
+
+    // 1. Park a worker.
+    ParkedThread worker;
+    CollectOptions opts;
+    opts.target_tid = worker.tid();
+
+    // 2. Two sequential dumps targeting the same tid.
+    NativeStackReport first = collect_native_stacks(opts);
+    NativeStackReport second = collect_native_stacks(opts);
+
+    // 3. The second dump returns a single thread entry with the correct tid
+    //    — i.e. dump 1's handler did not poison the slot for dump 2.
+    ASSERT_EQ(second.threads.size(), 1U);
+    EXPECT_EQ(second.threads[0].tid, worker.tid());
+}
+
+// Reason: [case 13] repeated all-thread dumps with live workers each
+// return within a wall-clock bound and leave workers joinable. This is the
+// "no crash, no stuck" stability gate.
+// Spec: docs/phase2-test-plan.md "Tier 1 cases" -> #13 DumpLoopNoCrashNoStuck.
+TEST_F(NativeStackActionTest, DumpLoopNoCrashNoStuck) {
+    // 1. Spawn two long-lived workers.
+    SpinThread worker_a;
+    ParkedThread worker_b;
+
+    // 2. Loop N dumps; each returns with a non-empty status.
+    constexpr int kIterations = 200;
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < kIterations; ++i) {
+        NativeStackReport report = collect_native_stacks(CollectOptions {});
+        ASSERT_FALSE(report.status.empty());
+    }
+
+    // 3. The loop finishes within a wall-clock bound.
+    const auto elapsed = std::chrono::steady_clock::now() - start;
+    EXPECT_LT(std::chrono::duration_cast<std::chrono::seconds>(elapsed).count(), 60);
+}
