+namespace {
+
+// Reason: a worker that starts with the collector signal blocked, exposes
+// `release()` to unblock the mask, and lingers briefly so any signal
+// already queued during the blocked window is delivered while the thread
+// still exists. Case 15 uses this to bait a real late handler.
+// Local: test-only fixture for case 15.
+class BlockedReleasable {
+public:
+    BlockedReleasable() {
+        _thread = std::thread([this] {
+            sigset_t set;
+            sigemptyset(&set);
+            sigaddset(&set, native_stack_signal());
+            pthread_sigmask(SIG_BLOCK, &set, nullptr);
+            _tid.store(self_tid(), std::memory_order_release);
+            {
+                std::unique_lock<std::mutex> lock(_mutex);
+                _cv.wait(lock, [this] { return _release; });
+            }
+            pthread_sigmask(SIG_UNBLOCK, &set, nullptr);
+            // Linger so a queued late signal is delivered to this tid
+            // before the thread exits.
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            {
+                std::unique_lock<std::mutex> lock(_mutex);
+                _cv.wait(lock, [this] { return _stop; });
+            }
+        });
+        while (_tid.load(std::memory_order_acquire) == 0) {
+            std::this_thread::yield();
+        }
+    }
+    BlockedReleasable(const BlockedReleasable&) = delete;
+    BlockedReleasable& operator=(const BlockedReleasable&) = delete;
+    ~BlockedReleasable() {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _release = true;
+            _stop = true;
+        }
+        _cv.notify_all();
+        if (_thread.joinable()) {
+            _thread.join();
+        }
+    }
+    int64_t tid() const { return _tid.load(std::memory_order_acquire); }
+    void release() {
+        {
+            std::lock_guard<std::mutex> lock(_mutex);
+            _release = true;
+        }
+        _cv.notify_all();
+        // Wait for the worker to unblock its mask before returning, so the
+        // caller knows the queued signal can now be delivered.
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+
+private:
+    std::thread _thread;
+    std::atomic<int64_t> _tid {0};
+    std::mutex _mutex;
+    std::condition_variable _cv;
+    bool _release = false;
+    bool _stop = false;
+};
+
+} // namespace
