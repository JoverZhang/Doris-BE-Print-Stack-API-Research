+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+// The native-stack collection seam shared by every Phase 2 variant. Tests call
+// these free functions directly, without forging an HttpRequest. The thin
+// NativeStackAction HTTP handler is the only other caller.
+// Reason: a free-function seam keeps the per-variant step (collect) isolated and
+// makes the response shape, gate, and parsing testable in-process.
+// Reference: docs/phase2-design.md "Common API".
+namespace doris::native_stack {
+
+// One captured frame. `pc` is the raw runtime instruction pointer, used only for
+// in-process correlation. `dso`/`dso_offset` are filled by resolve_dsos() and are
+// what offline tools symbolize. No symbol fields ever live here.
+struct Frame {
+    uintptr_t pc = 0;
+    std::string dso; // empty until resolved, or if pc is unmapped
+    uint64_t dso_offset = 0;
+    bool dso_resolved = false;
+};
+
+struct ThreadStack {
+    int64_t tid = 0;
+    std::string status; // "ok","timeout","signal_blocked","missing_tid",...
+    bool truncated = false;
+    int64_t handler_time_ns = -1; // <0 means not measured (e.g. the stub)
+    std::string error_reason;     // empty when there is none
+    std::vector<Frame> frames;
+};
+
+struct NativeStackReport {
+    std::string collector; // "stub","fp-walk",...
+    std::string status;    // "ok","partial","timeout","missing_tid","bad_request"
+    int64_t timeout_ms = 0;
+    int64_t max_frames = 0;
+    int64_t max_stack_bytes = 0;
+    int64_t elapsed_ms = 0;
+    std::optional<int64_t> target_tid;
+    std::string error_reason; // root-level reason (bad_request, contended timeout)
+    std::vector<ThreadStack> threads;
+};
+
+struct CollectOptions {
+    std::optional<int64_t> target_tid; // dump one thread instead of all
+    int64_t timeout_ms = 100;          // 1..60000
+    int64_t max_frames = 64;           // 1..1024
+    int64_t max_stack_bytes = 8192;    // 1..1048576
+};
+
+// Parse and validate query params. This is the only place `bad_request` is
+// decided: returns false and sets *error_reason on invalid input, leaving *out
+// untouched. Absent params take their defaults.
+bool parse_collect_options(const std::map<std::string, std::string>& params, CollectOptions* out,
+                           std::string* error_reason);
+
+// Per-thread capture callback: the only per-variant step. Given a live tid and
+// the dump deadline, fill *out (status, frames, handler_time_ns). The stub
+// returns "ok" with no frames; fp-walk does the signal + RBP walk.
+using CaptureFn = void (*)(int64_t tid, const CollectOptions& opts,
+                           std::chrono::steady_clock::time_point deadline, ThreadStack* out);
+
+// Variant-agnostic orchestration: take the single-dump gate bounded by
+// `timeout_ms` (else `timeout`), select tids from /proc/self/task (else
+// `missing_tid`), run `capture` per live thread honoring the unresponsive-tid
+// test hook, and aggregate ok/partial/timeout. Each variant's
+// collect_native_stacks() composes this with its own capture.
+NativeStackReport run_collection(const CollectOptions& opts, const char* collector_name,
+                                 CaptureFn capture);
+
+// The per-variant entry point. The common build ships a stub in
+// native_stack_collect.cpp; the fp-walk patch rewrites only that file.
+NativeStackReport collect_native_stacks(const CollectOptions& opts);
+
+// Fill dso/dso_offset on every frame from /proc/self/maps.
+void resolve_dsos(NativeStackReport* report);
+
+// Serialize the report to the agreed JSON contract.
+std::string serialize(const NativeStackReport& report);
+
+// --- test-only hooks (exercise the timeout/partial/contended paths without real
+// signaling). Defined in common so every variant inherits them. ---
+
+// Mark one tid as unresponsive: run_collection reports it `timeout` without
+// calling capture. Pass 0 to clear.
+void set_unresponsive_tid_for_test(int64_t tid);
+
+// Holds the single-dump gate for as long as it is alive, so a concurrent
+// collect hits the bounded-wait timeout deterministically.
+class DumpLockGuard {
+public:
+    explicit DumpLockGuard(std::unique_lock<std::timed_mutex> lock);
+    DumpLockGuard(DumpLockGuard&&) noexcept = default;
+    DumpLockGuard(const DumpLockGuard&) = delete;
+    DumpLockGuard& operator=(const DumpLockGuard&) = delete;
+    ~DumpLockGuard();
+
+private:
+    std::unique_lock<std::timed_mutex> _lock;
+};
+DumpLockGuard hold_dump_lock_for_test();
+
+} // namespace doris::native_stack
