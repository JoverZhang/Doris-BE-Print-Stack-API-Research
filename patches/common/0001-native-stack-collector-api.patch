+// The variant-agnostic half of the native-stack seam: the gate, tid selection,
+// status aggregation, DSO resolution, and JSON. The only per-variant step
+// (collect) lives in native_stack_collect.cpp.
+// Reference: docs/phase2-design.md "Common API".
+namespace doris::native_stack {
+namespace {
+
+// Reason: a timed_mutex allows one in-flight dump; a contended request returns
+// `timeout` after a bounded wait instead of blocking (CK) or spinning (OB).
+// Reference: docs/phase2-design.md "Common API" -> Mechanics.
+std::timed_mutex s_dump_mutex;
+
+// Reason: test hook. run_collection reports this tid `timeout` without calling
+// capture, so the timeout and partial paths run without real signaling.
+std::atomic<int64_t> s_unresponsive_tid {0};
+
+int64_t elapsed_ms(std::chrono::steady_clock::time_point start) {
+    return static_cast<int64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                        std::chrono::steady_clock::now() - start)
+                                        .count());
+}
+
+// Reason: parses one signed integer and rejects trailing garbage.
+bool parse_i64(const std::string& value, int64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        int64_t result = static_cast<int64_t>(std::stoll(value, &consumed, 10));
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = result;
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: applies the default when the param is absent or empty and bounds-checks
+// otherwise. The single choke point for rejecting out-of-range input.
+bool parse_bounded(const std::map<std::string, std::string>& params, const std::string& key,
+                   int64_t default_value, int64_t min_value, int64_t max_value, int64_t* out,
+                   std::string* error_reason) {
+    auto it = params.find(key);
+    if (it == params.end() || it->second.empty()) {
+        *out = default_value;
+        return true;
+    }
+    int64_t result = 0;
+    if (!parse_i64(it->second, &result) || result < min_value || result > max_value) {
+        *error_reason = "invalid " + key;
+        return false;
+    }
+    *out = result;
+    return true;
+}
+
+// Reason: enumerates BE threads from /proc/self/task as the canonical tid set, so
+// a test binary can dump its own threads in-process.
+// Reference: docs/phase2-design.md "Common API" -> Mechanics.
+std::vector<int64_t> list_thread_ids() {
+    std::vector<int64_t> tids;
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator("/proc/self/task", ec)) {
+        int64_t tid = 0;
+        if (parse_i64(entry.path().filename().string(), &tid) && tid > 0) {
+            tids.emplace_back(tid);
+        }
+    }
+    if (ec) {
+        LOG(WARNING) << "failed to list /proc/self/task: " << ec.message();
+    }
+    std::sort(tids.begin(), tids.end());
+    return tids;
+}
+
+// One /proc/self/maps row, used by resolve_dsos to map a pc to its DSO.
+struct MemoryMap {
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    uint64_t offset = 0;
+    std::string path;
+};
+
+std::string trim_left_spaces(std::string value) {
+    const size_t first = value.find_first_not_of(' ');
+    if (first == std::string::npos) {
+        return "";
+    }
+    return value.substr(first);
+}
+
+// Reason: parses one unsigned hex field from /proc/self/maps and rejects garbage.
+bool parse_hex_u64(const std::string& value, uint64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uint64_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: reads the process map once so resolve_dsos can locate each pc.
+std::vector<MemoryMap> load_memory_maps() {
+    std::vector<MemoryMap> maps;
+    std::ifstream input("/proc/self/maps");
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream iss(line);
+        std::string range;
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> range >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+        const size_t dash = range.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+
+        uint64_t start = 0;
+        uint64_t end = 0;
+        uint64_t offset = 0;
+        if (!parse_hex_u64(range.substr(0, dash), &start) ||
+            !parse_hex_u64(range.substr(dash + 1), &end) || !parse_hex_u64(offset_hex, &offset) ||
+            start >= end) {
+            continue;
+        }
+
+        MemoryMap map;
+        map.start = static_cast<uintptr_t>(start);
+        map.end = static_cast<uintptr_t>(end);
+        map.offset = offset;
+        std::string path;
+        std::getline(iss, path);
+        map.path = trim_left_spaces(path);
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
+
+std::string hex_u64(uint64_t value) {
+    std::ostringstream out;
+    out << "0x" << std::hex << value;
+    return out.str();
+}
+
+} // namespace
+
+bool parse_collect_options(const std::map<std::string, std::string>& params, CollectOptions* out,
+                           std::string* error_reason) {
+    // Reason: the only place `bad_request` is decided. On any rejection *out is
+    // left untouched and *error_reason carries the cause.
+    CollectOptions parsed;
+    if (!parse_bounded(params, "timeout_ms", 100, 1, 60000, &parsed.timeout_ms, error_reason) ||
+        !parse_bounded(params, "max_frames", 64, 1, 1024, &parsed.max_frames, error_reason) ||
+        !parse_bounded(params, "max_stack_bytes", 8192, 1, 1048576, &parsed.max_stack_bytes,
+                       error_reason)) {
+        return false;
+    }
+    auto it = params.find("tid");
+    if (it != params.end() && !it->second.empty()) {
+        int64_t tid = 0;
+        if (!parse_i64(it->second, &tid) || tid <= 0) {
+            *error_reason = "invalid tid";
+            return false;
+        }
+        parsed.target_tid = tid;
+    }
+    *out = parsed;
+    return true;
+}
+
+NativeStackReport run_collection(const CollectOptions& opts, const char* collector_name,
+                                 CaptureFn capture) {
+    const auto start = std::chrono::steady_clock::now();
+    NativeStackReport report;
+    report.collector = collector_name;
+    report.timeout_ms = opts.timeout_ms;
+    report.max_frames = opts.max_frames;
+    report.max_stack_bytes = opts.max_stack_bytes;
+    report.target_tid = opts.target_tid;
+
+    // 1. Take the single-dump gate bounded by timeout_ms; a contended request
+    //    returns `timeout` instead of blocking.
+    std::unique_lock<std::timed_mutex> lock(s_dump_mutex, std::defer_lock);
+    if (!lock.try_lock_for(std::chrono::milliseconds(opts.timeout_ms))) {
+        report.status = "timeout";
+        report.error_reason = "another native stack dump is in progress";
+        report.elapsed_ms = elapsed_ms(start);
+        return report;
+    }
+
+    // 2. Select target tids from /proc/self/task; a requested tid that is gone is
+    //    `missing_tid`.
+    std::vector<int64_t> tids = list_thread_ids();
+    if (opts.target_tid.has_value()) {
+        if (!std::binary_search(tids.begin(), tids.end(), opts.target_tid.value())) {
+            report.status = "missing_tid";
+            report.error_reason = "target tid is not present in /proc/self/task";
+            ThreadStack ts;
+            ts.tid = opts.target_tid.value();
+            ts.status = "missing_tid";
+            ts.error_reason = report.error_reason;
+            report.threads.push_back(std::move(ts));
+            report.elapsed_ms = elapsed_ms(start);
+            return report;
+        }
+        tids = {opts.target_tid.value()};
+    }
+
+    // 3. Capture each thread. The unresponsive-tid hook forces `timeout` without
+    //    calling capture, so the timeout and partial paths are testable.
+    const auto deadline = start + std::chrono::milliseconds(opts.timeout_ms);
+    const int64_t unresponsive = s_unresponsive_tid.load(std::memory_order_acquire);
+    int ok_count = 0;
+    int fail_count = 0;
+    bool all_failures_timeout = true;
+    for (int64_t tid : tids) {
+        ThreadStack ts;
+        ts.tid = tid;
+        if (unresponsive != 0 && tid == unresponsive) {
+            ts.status = "timeout";
+            ts.error_reason = "thread marked unresponsive for test";
+        } else {
+            capture(tid, opts, deadline, &ts);
+        }
+        if (ts.status == "ok") {
+            ++ok_count;
+        } else {
+            ++fail_count;
+            if (ts.status != "timeout") {
+                all_failures_timeout = false;
+            }
+        }
+        report.threads.push_back(std::move(ts));
+    }
+
+    // 4. Aggregate: all ok -> ok; some ok -> partial; none ok with every failure a
+    //    timeout -> timeout; otherwise partial.
+    if (fail_count == 0) {
+        report.status = "ok";
+    } else if (ok_count > 0) {
+        report.status = "partial";
+    } else {
+        report.status = all_failures_timeout ? "timeout" : "partial";
+    }
+    report.elapsed_ms = elapsed_ms(start);
+    return report;
+}
+
+void resolve_dsos(NativeStackReport* report) {
+    if (report == nullptr) {
+        return;
+    }
+    // Reason: resolve every frame's pc to (dso, dso_offset) so offline tools can
+    // symbolize. dso_offset = map.offset + (pc - map.start), so the DSO's load
+    // base plus dso_offset equals pc.
+    // Reference: docs/phase2-design.md "Common API"; offset formula per case
+    // `KnownChainResolved` in docs/phase2-test-plan.md.
+    const std::vector<MemoryMap> maps = load_memory_maps();
+    for (ThreadStack& thread : report->threads) {
+        for (Frame& frame : thread.frames) {
+            const MemoryMap* map = find_map_for_pc(maps, frame.pc);
+            if (map == nullptr) {
+                frame.dso.clear();
+                frame.dso_offset = 0;
+                frame.dso_resolved = false;
+                continue;
+            }
+            frame.dso = map->path;
+            frame.dso_offset = map->offset + (static_cast<uint64_t>(frame.pc) - map->start);
+            frame.dso_resolved = true;
+        }
+    }
+}
+
+std::string serialize(const NativeStackReport& report) {
+    // Reason: build the agreed JSON contract. EasyJson builds; tests parse with
+    // rapidjson. Frame objects carry only pc/dso/dso_offset -- no symbol fields.
+    // Reference: docs/phase2-test-plan.md case `Schema`.
+    EasyJson root;
+    root["collector"] = report.collector;
+    root["status"] = report.status;
+    root["timeout_ms"] = report.timeout_ms;
+    root["max_frames_per_thread"] = report.max_frames;
+    root["max_copied_stack_bytes"] = report.max_stack_bytes;
+    root["elapsed_ms"] = report.elapsed_ms;
+    if (report.target_tid.has_value()) {
+        root["target_tid"] = report.target_tid.value();
+    }
+    if (!report.error_reason.empty()) {
+        root["error_reason"] = report.error_reason;
+    }
+
+    root.Set("threads", EasyJson::kArray);
+    EasyJson threads = root.Get("threads");
+    for (const ThreadStack& thread : report.threads) {
+        EasyJson entry = threads.PushBack(EasyJson::kObject);
+        entry["tid"] = thread.tid;
+        entry["status"] = thread.status;
+        entry["truncated"] = thread.truncated;
+        if (thread.handler_time_ns >= 0) {
+            entry["handler_time_ns"] = thread.handler_time_ns;
+        }
+        if (!thread.error_reason.empty()) {
+            entry["error_reason"] = thread.error_reason;
+        }
+        entry.Set("frames", EasyJson::kArray);
+        EasyJson frames = entry.Get("frames");
+        for (const Frame& frame : thread.frames) {
+            EasyJson out = frames.PushBack(EasyJson::kObject);
+            out["pc"] = hex_u64(frame.pc);
+            out["dso"] = frame.dso;
+            out["dso_offset"] = hex_u64(frame.dso_offset);
+        }
+    }
+    return root.ToString();
+}
+
+void set_unresponsive_tid_for_test(int64_t tid) {
+    s_unresponsive_tid.store(tid, std::memory_order_release);
+}
+
+DumpLockGuard::DumpLockGuard(std::unique_lock<std::timed_mutex> lock) : _lock(std::move(lock)) {}
+
+DumpLockGuard::~DumpLockGuard() = default;
+
+// Reason: holds the single-dump gate for the lifetime of the guard so a
+// concurrent collect deterministically hits the bounded-wait timeout. Test-only.
+DumpLockGuard hold_dump_lock_for_test() {
+    return DumpLockGuard(std::unique_lock<std::timed_mutex>(s_dump_mutex));
+}
+
+} // namespace doris::native_stack
