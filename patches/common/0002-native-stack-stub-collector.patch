+#include <chrono>
+
+#include "service/http/action/native_stack.h"
+
+// The per-variant collect step. The common build ships this stub; each variant
+// patch (fp-walk, ck-phdr-unwind, ...) rewrites only this file with its real
+// collector, while every other file in the seam stays put.
+// Reference: docs/phase2-design.md "Common API" -> stub collect().
+namespace doris::native_stack {
+namespace {
+
+// Reason: the stub proves the response shape and the single-dump gate without
+// real signaling -- every live thread reports `ok` with no frames. run_collection
+// owns the gate, tid selection, and aggregation, so the stub only fills status.
+void stub_capture(int64_t /*tid*/, const CollectOptions& /*opts*/,
+                  std::chrono::steady_clock::time_point /*deadline*/, ThreadStack* out) {
+    out->status = "ok";
+}
+
+} // namespace
+
+NativeStackReport collect_native_stacks(const CollectOptions& opts) {
+    return run_collection(opts, "stub", stub_capture);
+}
+
+} // namespace doris::native_stack
