From ed356489ec09a25facce48dd0d1a0f759bbebb98 Mon Sep 17 00:00:00 2001
From: mira <mira@example.invalid>
Date: Sat, 30 May 2026 03:23:19 +0800
Subject: [PATCH 4/5] (be) register native stack debug HTTP route

Register NativeStackAction at GET /api/debug/native_stack with ADMIN privilege.
---
 be/src/service/http_service.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/be/src/service/http_service.cpp b/be/src/service/http_service.cpp
index 93a50a81cc1..4a3d121bcab 100644
--- a/be/src/service/http_service.cpp
+++ b/be/src/service/http_service.cpp
@@ -58,6 +58,7 @@
 #include "service/http/action/load_stream_action.h"
 #include "service/http/action/meta_action.h"
 #include "service/http/action/metrics_action.h"
+#include "service/http/action/native_stack_action.h"
 #include "service/http/action/pad_rowset_action.h"
 #include "service/http/action/pipeline_task_action.h"
 #include "service/http/action/pprof_actions.h"
@@ -190,6 +191,12 @@ Status HttpService::start() {
     _ev_http_server->register_handler(HttpMethod::GET, "/api/be_process_thread_num",
                                       be_proc_thread_action);
 
+    // Register the Phase 2 native stack debug action.
+    NativeStackAction* native_stack_action =
+            _pool.add(new NativeStackAction(_env, TPrivilegeHier::GLOBAL, TPrivilegeType::ADMIN));
+    _ev_http_server->register_handler(HttpMethod::GET, "/api/debug/native_stack",
+                                      native_stack_action);
+
     // Register BE LoadStream action
     LoadStreamAction* load_stream_action = _pool.add(new LoadStreamAction(_env));
     _ev_http_server->register_handler(HttpMethod::GET, "/api/load_streams", load_stream_action);
