+#include "service/http/action/native_stack_action.h"
+
+#include <string>
+
+#include "service/http/action/native_stack.h"
+#include "service/http/http_channel.h"
+#include "service/http/http_headers.h"
+#include "service/http/http_request.h"
+#include "service/http/http_status.h"
+#include "util/easy_json.h"
+
+namespace doris {
+namespace {
+constexpr char kJsonContentType[] = "application/json";
+} // namespace
+
+NativeStackAction::NativeStackAction(ExecEnv* exec_env, TPrivilegeHier::type hier,
+                                     TPrivilegeType::type type)
+        : HttpHandlerWithAuth(exec_env, hier, type) {}
+
+void NativeStackAction::handle(HttpRequest* req) {
+    req->add_output_header(HttpHeaders::CONTENT_TYPE, kJsonContentType);
+
+    // 1. Parse and validate query params. This is the only bad_request path; on
+    //    rejection no collection runs. Query-string args live in query_params(),
+    //    not param() (which only carries path-template params for this route).
+    native_stack::CollectOptions opts;
+    std::string error_reason;
+    if (!native_stack::parse_collect_options(req->query_params(), &opts, &error_reason)) {
+        EasyJson root;
+        root["status"] = "bad_request";
+        root["error_reason"] = error_reason;
+        HttpChannel::send_reply(req, HttpStatus::BAD_REQUEST, root.ToString());
+        return;
+    }
+
+    // 2. Collect raw PCs (the only per-variant step), resolve DSOs from
+    //    /proc/self/maps, and serialize the agreed JSON contract.
+    native_stack::NativeStackReport report = native_stack::collect_native_stacks(opts);
+    native_stack::resolve_dsos(&report);
+    HttpChannel::send_reply(req, HttpStatus::OK, native_stack::serialize(report));
+}
+
+} // namespace doris
