+#pragma once
+
+#include "service/http/http_handler_with_auth.h"
+
+namespace doris {
+
+class HttpRequest;
+
+// Reason: the thin HTTP front for the native-stack seam. `handle` parses query
+// params, then runs collect -> resolve_dsos -> serialize and writes the JSON.
+// All logic lives in the common free functions (namespace doris::native_stack),
+// so the action carries no per-variant code.
+// Spec: docs/phase2-design.md "Common API".
+class NativeStackAction : public HttpHandlerWithAuth {
+public:
+    NativeStackAction(ExecEnv* exec_env, TPrivilegeHier::type hier, TPrivilegeType::type type);
+    ~NativeStackAction() override = default;
+
+    void handle(HttpRequest* req) override;
+};
+
+} // namespace doris
