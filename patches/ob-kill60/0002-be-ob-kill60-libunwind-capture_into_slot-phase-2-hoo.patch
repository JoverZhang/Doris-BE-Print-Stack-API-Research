+// Reason: the Doris libunwind archive exposes only the local-only
+// `_ULx86_64_*` symbols. The define remaps `<libunwind.h>` to those.
+// Spec: docs/design/ob.md "Decisions".
+#define UNW_LOCAL_ONLY
+
+#include <libunwind.h>
+#include <poll.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+
+#include "service/http/action/print_stack_capture.h"
+#include "service/http/action/print_stack_globals.h"
+
+namespace doris::print_stack {
+namespace {
+
+// Reason: seed from the interrupted thread's saved context and walk
+// the chain. `UNW_INIT_SIGNAL_FRAME` tells libunwind the context came
+// from a signal handler so the first IP read returns the interrupted PC.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_libunwind.c:55-82
+//   (`get_stack_trace_inplace` is the unwind loop shape).
+size_t walk_signal_frame(const ucontext_t& uc, uintptr_t* out, size_t cap) {
+    unw_context_t ctx;
+    std::memcpy(&ctx, &uc, sizeof(ctx));
+
+    unw_cursor_t cursor;
+    if (unw_init_local2(&cursor, &ctx, UNW_INIT_SIGNAL_FRAME) != 0) {
+        return 0;
+    }
+
+    size_t n = 0;
+    do {
+        if (n >= cap) {
+            break;
+        }
+        unw_word_t ip = 0;
+        if (unw_get_reg(&cursor, UNW_REG_IP, &ip) != 0 || ip == 0) {
+            break;
+        }
+        out[n++] = static_cast<uintptr_t>(ip);
+    } while (unw_step(&cursor) > 0);
+
+    return n;
+}
+
+} // namespace
+
+// Reason: variant capture. Body runs inside the signal handler. ob-kill60
+// ships no `dl_iterate_phdr` override; the libc implementation takes the
+// loader lock, which is not async-signal-safe. Risk inherited deliberately
+// so the report's comparison against ck-phdr-unwind stays clean.
+// Spec: docs/architecture.md "Layer 3d"; docs/design/ob.md "Decisions".
+void capture_into_slot(const ucontext_t& uc, StackCaptureSlot* out) {
+    out->status = ThreadStackStatus::CaptureFailed;
+    out->frame_count = walk_signal_frame(uc, out->pcs.data(), kMaxSignalFrames);
+    out->status = ThreadStackStatus::OK;
+}
+
+// Reason: phase-2 release wait. Block in the signal handler until the
+// coordinator writes the matching sequence on g_handler_release_pipe_rw.
+// Bounded by kPipeReadTimeoutMs so a coordinator that errors mid-read
+// does not hang the handler indefinitely. Non-matching reads (left over
+// from a prior dump's late hooks) are drained.
+// Spec: docs/design/ob.md "Steps".
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:365
+//   (OB's `wait_readable(fd2_[0])`).
+void variant_wait_for_release(int seq) {
+    int remaining_ms = kPipeReadTimeoutMs;
+    while (true) {
+        pollfd pfd {g_handler_release_pipe_rw[0], POLLIN, 0};
+        int rc = ::poll(&pfd, 1, remaining_ms);
+
+        if (rc < 0 && errno == EINTR) {
+            if (--remaining_ms <= 0) {
+                return;
+            }
+            continue;
+        }
+        if (rc <= 0) {
+            return;
+        }
+
+        int got = 0;
+        ssize_t n = ::read(g_handler_release_pipe_rw[0], &got, sizeof(got));
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n != static_cast<ssize_t>(sizeof(got))) {
+            return;
+        }
+        if (got == seq) {
+            return;
+        }
+        // Stale wakeup from a prior dump's coordinator; drain and keep
+        // waiting for our own sequence.
+    }
+}
+
+// Reason: phase-2 release notify. The coordinator calls this from
+// capture_one after the slot copy. One write of the sequence wakes
+// the handler's poll loop above.
+// Spec: docs/design/ob.md "Steps".
+void variant_after_slot_read(int seq) {
+    ssize_t res = ::write(g_handler_release_pipe_rw[1], &seq, sizeof(seq));
+    (void)res;
+}
+
+} // namespace doris::print_stack
