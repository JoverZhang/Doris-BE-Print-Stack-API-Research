+// "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+// KIND, either express or implied.  See the License for the
+// specific language governing permissions and limitations
+// under the License.
+// This file is derived from
+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.cpp
+// , ob_signal_handlers.cpp, and ob_libunwind.c, modified by Doris for the
+// ob-kill60 native stack collector.
+
+#include "common/ob_signal_handler.h"
+
+#ifndef UNW_LOCAL_ONLY
+#define UNW_LOCAL_ONLY
+#endif
+#include <libunwind.h>
+
+#include <errno.h>
+#include <unistd.h>
+
+namespace doris::ob_kill60 {
+
+ObSigHandlerCtx g_sig_handler_ctx_;
+
+// Reason: TAS spin-loop with PAUSE hint, signal-safe (no allocation, no
+// futex). The coordinator holds this for the whole per-thread exchange.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:97-102
+void ObSigHandlerCtx::lock() {
+    while (__atomic_test_and_set(&lock_, __ATOMIC_ACQ_REL)) {
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#elif defined(__aarch64__)
+        asm volatile("yield");
+#endif
+    }
+}
+
+void ObSigHandlerCtx::unlock() {
+    __atomic_clear(&lock_, __ATOMIC_RELEASE);
+}
+
+// Reason: non-blocking try_lock for the HTTP coordinator to report busy
+// when another dump is in flight, mirroring OB's spin policy but without
+// blocking the HTTP thread.
+bool ObSigHandlerCtx::try_lock() {
+    return !__atomic_test_and_set(&lock_, __ATOMIC_ACQ_REL);
+}
+
+// Reason: stamp the anti-spoof token under the lock so the worker handler
+// always observes a coherent req_id.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:90-95
+void ObSigHandlerCtx::atomic_set_req_id(int64_t req_id) {
+    lock();
+    req_id_ = req_id;
+    unlock();
+}
+
+// Reason: top-level signal dispatcher. Routes MP_SIG to the worker capture
+// path; drops every other signal (Doris's failure handler owns
+// SIGSEGV/SIGABRT/etc., so we MUST NOT raise the default here as OB does).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:103-120
+extern "C" void ob_signal_handler(int sig, siginfo_t* si, void* /*context*/) {
+    if (sig != kMpSig || si == nullptr) {
+        return;
+    }
+
+    // 1. Anti-spoof: reject any sival_ptr that does not match the current
+    //    req_id. Mirrors OB ob_signal_handler:113-115.
+    int64_t req_id = reinterpret_cast<int64_t>(si->si_value.sival_ptr);
+    auto& ctx = g_sig_handler_ctx_;
+    if (ctx.req_id_ != req_id || req_id == 0) {
+        return;
+    }
+
+    // 2. Drop signals delivered to the wrong tid (a stray MP_SIG from an
+    //    earlier request that re-fires after the coordinator advanced).
+    int64_t self_tid = static_cast<int64_t>(syscall(SYS_gettid));
+    if (ctx.target_tid_ != self_tid) {
+        return;
+    }
+
+    // 3. Capture PCs into the shared ctx buffer. Worker-side prepare phase
+    //    in OB's ObSigBTOnlyProcessor::prepare (calls safe_backtrace).
+    //    Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_processor.cpp:51-68
+    int saved_errno = errno;
+    ctx.frame_count_ = 0;
+    ctx.truncated_ = false;
+    int captured = 0;
+    int rc = safe_backtrace(ctx.frames_, kMaxSignalFrames, &captured);
+    if (rc == 0) {
+        ctx.frame_count_ = captured;
+        ctx.truncated_ = (captured >= kMaxSignalFrames);
+    }
+
+    // 4. Notify the coordinator that prepare is done by writing the ack
+    //    (mirrors OB ob_signal_worker.cpp:358-360). On write failure the
+    //    coordinator will time out on its own poll.
+    int ack = rc;
+    ssize_t n = ::write(ctx.fd_[1], &ack, sizeof(ack));
+    static_cast<void>(n);
+
+    // 5. Wait for the coordinator's process-done write on fd2_, then post
+    //    the exit-ack. Bounded by the coordinator's timeout — if the
+    //    coordinator times out it will close ctx.fd2_[0] (read returns 0)
+    //    and we exit cleanly.
+    //    Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:362-385
+    int peer_ack = 0;
+    while (true) {
+        ssize_t r = ::read(ctx.fd2_[0], &peer_ack, sizeof(peer_ack));
+        if (r == sizeof(peer_ack)) {
+            break;
+        }
+        if (r == 0) {
+            break; // pipe closed by coordinator timeout
+        }
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        break;
+    }
+
+    int exit_ack = peer_ack;
+    n = ::write(ctx.fd_[1], &exit_ack, sizeof(exit_ack));
+    static_cast<void>(n);
+    errno = saved_errno;
+}
+
+// Reason: install ob_signal_handler for MP_SIG only. Doris BE already
+// installs a failure handler for SIGSEGV/SIGABRT/SIGBUS/SIGFPE/SIGILL/
+// SIGTERM via doris::signal::InstallFailureSignalHandler at
+// be/src/common/signal_handler.h, so we do NOT widen SIG_SET to those.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:73-86
+int install_ob_signal_handler() {
+    struct sigaction sa {};
+    sa.sa_flags = SA_SIGINFO | SA_RESTART | SA_NODEFER | SA_ONSTACK;
+    sa.sa_sigaction = ob_signal_handler;
+    sigemptyset(&sa.sa_mask);
+    if (sigaction(kMpSig, &sa, nullptr) == -1) {
+        return -1;
+    }
+    return 0;
+}
+
+// Reason: signal-safe libunwind PC walk. Mirrors OB safe_backtrace_ +
+// get_stack_trace_inplace + get_frame_info.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_libunwind.c:26-99
+int safe_backtrace(uintptr_t* frames, int max_frames, int* count) {
+    *count = 0;
+    if (max_frames <= 0) {
+        return 0;
+    }
+
+    unw_context_t context;
+    if (unw_getcontext(&context) < 0) {
+        return -1;
+    }
+
+    unw_cursor_t cursor;
+    if (unw_init_local(&cursor, &context) < 0) {
+        return -1;
+    }
+
+    int n = 0;
+    while (n < max_frames) {
+        unw_word_t ip = 0;
+        if (unw_get_reg(&cursor, UNW_REG_IP, &ip) < 0) {
+            return -1;
+        }
+        // Reason: bias the IP one byte back for normal call frames so the PC
+        // falls inside the calling instruction (OB does the same to handle
+        // noreturn functions). Signal frames keep the exact IP.
+        // Reference: <ob>/deps/oblib/src/lib/signal/ob_libunwind.c:84-98
+        int is_signal_frame = unw_is_signal_frame(&cursor);
+        if (is_signal_frame < 0) {
+            return -1;
+        }
+        frames[n++] = static_cast<uintptr_t>(ip) - (is_signal_frame == 0 ? 1 : 0);
+
+        int r = unw_step(&cursor);
+        if (r < 0) {
+            return -1;
+        }
+        if (r == 0) {
+            break;
+        }
+    }
+    *count = n;
+    return 0;
+}
+
+} // namespace doris::ob_kill60
