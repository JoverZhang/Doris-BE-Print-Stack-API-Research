+// This file is derived from
+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.h
+// and ob_signal_handlers.{h,cpp} and modified by Doris for the ob-kill60
+// native stack collector.
+
+#pragma once
+
+#include <signal.h>
+
+#include <atomic>
+#include <cstdint>
+
+namespace doris::ob_kill60 {
+
+// Reason: MP_SIG (multi-purpose signal) is the realtime-adjacent signal the
+// coordinator sends to interrupt every worker thread. OceanBase uses SIGURG
+// because POSIX leaves the default action as "ignore"; Doris BE does not
+// use SIGURG elsewhere (grep be/src/), so we keep the same choice.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:25
+constexpr int kMpSig = SIGURG;
+
+// Reason: maximum number of PCs the worker captures into one ctx buffer. OB
+// caps at 100 in ob_libunwind.c; we follow that so the buffer stays bounded.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_libunwind.c:19
+constexpr int kMaxSignalFrames = 100;
+
+// Reason: shared context the coordinator hands to each worker handler in
+// turn. Mirrors OceanBase ObSigHandlerCtx.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:111-127
+struct ObSigHandlerCtx {
+    ObSigHandlerCtx() = default;
+
+    // Reason: TAS spin-lock the coordinator holds for the whole per-thread
+    // exchange so concurrent HTTP requests serialize on the shared ctx.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:97-107
+    void lock();
+    void unlock();
+    bool try_lock();
+
+    // Reason: req_id is the anti-spoof token the coordinator stamps into
+    // si_value.sival_ptr; the handler rejects any signal whose req_id does
+    // not match. Lock during the swap so the handler observes a coherent
+    // value. Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:90-95
+    void atomic_set_req_id(int64_t req_id);
+
+    // fd_[0/1] = worker -> coordinator (prepare-ack + exit-ack).
+    // fd_[1]   = write end inside the worker handler.
+    // fd2_[0/1]= coordinator -> worker (process-done signal).
+    // fd2_[1]  = write end inside the coordinator after processing.
+    // Lifecycle: pipe2(O_CLOEXEC) per request, closed by the coordinator.
+    // Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:120-121
+    int fd_[2] = {-1, -1};
+    int fd2_[2] = {-1, -1};
+
+    // Reason: PC buffer the worker fills via libunwind in the signal handler
+    // and the coordinator reads after the prepare-ack. Worker-only writes;
+    // coordinator-only reads. No allocation, no locking inside the handler.
+    uintptr_t frames_[kMaxSignalFrames] = {};
+    int frame_count_ = 0;
+    bool truncated_ = false;
+
+    // Reason: tid of the thread currently being interrupted; used so the
+    // worker handler can ignore stray signals delivered to the wrong thread.
+    int64_t target_tid_ = 0;
+
+    int64_t lock_ = 0;
+    int64_t req_id_ = 0;
+};
+
+// Reason: single shared instance — the coordinator processes one worker at
+// a time under the spin-lock, exactly as OceanBase does.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:109
+extern ObSigHandlerCtx g_sig_handler_ctx_;
+
+// Reason: top-level signal dispatcher; routes MP_SIG to the per-request
+// handler and drops every other signal. Anti-spoof check on req_id.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:103-120
+extern "C" void ob_signal_handler(int sig, siginfo_t* si, void* context);
+
+// Reason: register ob_signal_handler for MP_SIG only. Doris already owns
+// SIGSEGV/SIGABRT/SIGBUS/SIGFPE/SIGILL/SIGTERM via
+// doris::signal::InstallFailureSignalHandler, so we narrow the OB
+// SIG_SET to MP_SIG to avoid stomping the failure handler.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_handlers.cpp:73-86
+int install_ob_signal_handler();
+
+// Reason: signal-safe libunwind PC walk. Worker handler calls this to fill
+// ctx.frames_/frame_count_ before posting the prepare-ack.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_libunwind.c:26-53
+int safe_backtrace(uintptr_t* frames, int max_frames, int* count);
+
+} // namespace doris::ob_kill60
