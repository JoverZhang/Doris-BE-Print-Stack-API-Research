From 5a518ed6b0ed2e6de7caa22b8019b3f6c0863a23 Mon Sep 17 00:00:00 2001
From: mira <mira@example.invalid>
Date: Sun, 31 May 2026 20:26:03 +0800
Subject: [PATCH 1/4] (be) ob-kill60 enable lock-free dl_iterate_phdr override

The ClickHouse-style override was vendored upstream (commit 96a46302e8c)
but kept commented out because jemalloc's heap profile defaults to a
libgcc backtracer that re-enters dl_iterate_phdr. The variant's
handler-side libunwind reaches dl_iterate_phdr during unw_step; the
libc version takes the loader lock and is not async-signal-safe, so
re-enabling the cached walk is the precondition for a safe handler.

The cold path still falls through to the original libc function until
updatePHDRCache() runs (patch 2), so re-enabling the symbol is safe in
every variant: only ob-kill60 populates the cache in this branch.

Profiling defaults to OFF in the Tier 1 test build, so the prebuilt
thirdparty jemalloc (libgcc backtracer) is safe under this round's
gate. The Tier 2 prerequisite (jemalloc rebuilt with
--enable-prof-libunwind) lives in the build-system patch +
build-facts.md.

This patch is duplicated verbatim across the libunwind variants
(ck-phdr-unwind, ob-kill60, snapshot-remote-unwind). Isolation matters
more than DRY this round; promoting to patches/common/ is a follow-up
task once all three libunwind variants are green.

Reference: <ck>/base/base/phdr_cache.cpp:57-75.
---
 be/src/common/phdr_cache.cpp | 32 ++++++++++++++++++++++----------
 1 file changed, 22 insertions(+), 10 deletions(-)

diff --git a/be/src/common/phdr_cache.cpp b/be/src/common/phdr_cache.cpp
index e0f5ff43fed..d4161443c8c 100644
--- a/be/src/common/phdr_cache.cpp
+++ b/be/src/common/phdr_cache.cpp
@@ -74,15 +74,28 @@ std::atomic<PHDRCache*> phdr_cache {};
 
 } // namespace
 
-// Jemalloc heap profile follows libgcc's way of backtracing by default.
-// rewrites dl_iterate_phdr will cause Jemalloc to fail to run after enable profile.
-
-// TODO, two solutions:
-// 1. Jemalloc specifies GNU libunwind as the prof backtracing way, but my test failed,
-//    `--enable-prof-libunwind` not work: https://github.com/jemalloc/jemalloc/issues/2504
-// 2. ClickHouse/libunwind solves Jemalloc profile backtracing, but the branch of ClickHouse/libunwind
-//    has been out of touch with GNU libunwind and LLVM libunwind, which will leave the fate to others.
-/*
+// Reason: ELF-interposes libc `dl_iterate_phdr` with a lock-free walk over
+// the cached PHDRs. The handler-side libunwind path in ob-kill60 reaches
+// `dl_iterate_phdr` during `unw_step`; the libc version takes the loader
+// lock and is not async-signal-safe, so a handler that calls it while
+// another thread holds the lock deadlocks. The cached walk avoids the lock
+// entirely. The override stays disabled when ob-kill60 is not the linked
+// variant: in that build the cache is never populated (`updatePHDRCache`
+// is not called or returns early), and the override's cold path falls
+// through to the original libc function.
+//
+// jemalloc's heap-profile backtracer reaches the loader through libgcc
+// (`_Unwind_Backtrace` -> `_Unwind_Find_FDE` -> `dl_iterate_phdr`). With
+// the override active and profiling on, jemalloc reenters the cache
+// callback while holding its own internal locks; the proven mitigation is
+// to build jemalloc with `--enable-prof-libunwind` so its profiler uses
+// libunwind directly. Profiling defaults to OFF in the Tier 1 test build,
+// so the prebuilt thirdparty jemalloc (libgcc backtracer) is safe under
+// this round's gate; the rebuild is the Tier 2 prerequisite tracked in
+// `build-system` patch + `build-facts.md`.
+// Spec: docs/phase2-design.md "jemalloc compatibility".
+// Reference: <ck>/base/base/phdr_cache.cpp:57-75 (the lock-free override
+// this code mirrors verbatim).
 extern "C"
 #ifndef __clang__
         [[gnu::visibility("default")]] [[gnu::externally_visible]]
@@ -104,7 +117,6 @@ extern "C"
     }
     return result;
 }
-*/
 
 extern "C" {
 #ifdef ADDRESS_SANITIZER
