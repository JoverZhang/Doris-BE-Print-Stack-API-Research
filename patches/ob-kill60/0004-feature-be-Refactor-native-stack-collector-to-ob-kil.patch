+std::string outcome_status(ThreadOutcome outcome) {
+    switch (outcome) {
+    case ThreadOutcome::OK:
+        return "ok";
+    case ThreadOutcome::SKIPPED_SELF:
+        return "skipped_self";
+    case ThreadOutcome::SIGNAL_FAILED:
