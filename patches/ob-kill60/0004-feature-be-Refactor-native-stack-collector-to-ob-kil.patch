+// Reason: turn the OB-cached /proc/self/maps text into typed entries the
+// coordinator can binary-search. Mirrors the per-line shape OB parses
+// (range, perms, offset, dev, inode, path) but only keeps executable rows
+// since ObProcMaps::load_maps() already filtered them. Reference:
+// <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:62-86
+std::vector<MemoryMap> parse_proc_maps(const char* buf, int64_t len) {
+    std::vector<MemoryMap> maps;
+    int64_t pos = 0;
+    while (pos < len) {
+        const char* line_begin = buf + pos;
+        const char* line_end = line_begin;
+        while (line_end < buf + len && *line_end != '\n') {
+            ++line_end;
+        }
+        std::string line(line_begin, line_end - line_begin);
+        pos = (line_end - buf) + 1;
+
+        // Find range "start-end perms offset dev inode path".
+        size_t dash = line.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+        size_t sp1 = line.find(' ', dash);
+        if (sp1 == std::string::npos) {
+            continue;
+        }
+        size_t sp2 = line.find(' ', sp1 + 1);
+        if (sp2 == std::string::npos) {
+            continue;
+        }
+        size_t sp3 = line.find(' ', sp2 + 1);
+        if (sp3 == std::string::npos) {
+            continue;
+        }
+
+        MemoryMap map;
+        if (!parse_hex_uintptr(line.data(), line.data() + dash, &map.start) ||
+            !parse_hex_uintptr(line.data() + dash + 1, line.data() + sp1, &map.end) ||
+            !parse_hex_uintptr(line.data() + sp2 + 1, line.data() + sp3, &map.offset) ||
+            map.start >= map.end) {
+            continue;
+        }
+
+        // Path follows the last token; skip dev + inode then take the rest.
+        size_t sp4 = line.find(' ', sp3 + 1);
+        if (sp4 == std::string::npos) {
+            continue;
+        }
+        size_t path_start = line.find_first_not_of(' ', sp4 + 1);
+        if (path_start != std::string::npos) {
+            map.path = line.substr(path_start);
+        }
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
