+// Reason: thin wrapper around the rt_tgsigqueueinfo + tgkill fallback. OB
+// only uses rt_tgsigqueueinfo; we keep the older tgkill path documented in
+// Phase 2 plan line 56 for kernels missing SYS_rt_tgsigqueueinfo. The
+// fallback cannot carry the req_id token so the handler will drop it via
+// the anti-spoof check — surface that via TGKILL_FALLBACK_USED.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:304-310
+bool send_capture_signal(pid_t pid, int64_t tid, int64_t req_id, ThreadResult* result) {
+    siginfo_t si {};
+    si.si_code = SI_QUEUE;
+    si.si_value.sival_ptr = reinterpret_cast<void*>(req_id);
+    long rc = syscall(SYS_rt_tgsigqueueinfo, pid, static_cast<pid_t>(tid),
+                      ob_kill60::kMpSig, &si);
+    if (rc == 0) {
+        return true;
+    }
+    result->signal_errno = errno;
+
+    long fb = syscall(SYS_tgkill, pid, static_cast<pid_t>(tid), ob_kill60::kMpSig);
+    if (fb == 0) {
+        result->outcome = ThreadOutcome::TGKILL_FALLBACK_USED;
+        return true;
+    }
+    result->tgkill_errno = errno;
+    result->outcome = ThreadOutcome::SIGNAL_FAILED;
+    return false;
+}
+
+// Reason: poll the read end for `timeout_ms` and consume one int ack.
+// Mirrors OB wait_readable + read. Returns true if ack arrived; false on
+// timeout or pipe error.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:78-92
+bool wait_ack(int read_fd, int timeout_ms, int* ack) {
+    struct pollfd pfd {};
+    pfd.fd = read_fd;
+    pfd.events = POLLIN;
+    while (true) {
+        int r = ::poll(&pfd, 1, timeout_ms);
+        if (r > 0 && (pfd.revents & POLLIN)) {
+            ssize_t n = ::read(read_fd, ack, sizeof(*ack));
+            return n == static_cast<ssize_t>(sizeof(*ack));
+        }
+        if (r == 0) {
+            return false; // timeout
+        }
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        return false;
+    }
+}
+
+// Reason: drives one worker thread through the two-phase exchange. Mirrors
+// OB task_process — open both pipes, send signal, wait prepare-ack, run
+// processor->process (here: copy frames out of the ctx), notify worker via
+// fd2_, wait exit-ack. The coordinator holds g_sig_handler_ctx_.lock() for
+// the whole call.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:280-347
+void task_process_one(pid_t pid, int64_t tid, int timeout_ms, ThreadResult* result) {
+    auto& ctx = ob_kill60::g_sig_handler_ctx_;
+    auto start = std::chrono::steady_clock::now();
+
+    // 1. Stamp req_id and target tid under the lock so the handler observes
+    //    coherent values. atomic_set_req_id mirrors OB :294.
+    int64_t req_id = s_req_id_counter.fetch_add(1, std::memory_order_acq_rel) + 1;
+    if (req_id == 0) {
+        req_id = s_req_id_counter.fetch_add(1, std::memory_order_acq_rel) + 1;
+    }
+    ctx.atomic_set_req_id(req_id);
+    ctx.target_tid_ = tid;
+    ctx.frame_count_ = 0;
+    ctx.truncated_ = false;
+
+    // 2. Open per-request pipes (DEFER closes them, OB :287-292).
+    if (::pipe2(ctx.fd_, O_CLOEXEC) != 0 || ::pipe2(ctx.fd2_, O_CLOEXEC) != 0) {
+        result->outcome = ThreadOutcome::SIGNAL_FAILED;
+        result->signal_errno = errno;
+        if (ctx.fd_[0] != -1) ::close(ctx.fd_[0]);
+        if (ctx.fd_[1] != -1) ::close(ctx.fd_[1]);
+        if (ctx.fd2_[0] != -1) ::close(ctx.fd2_[0]);
+        if (ctx.fd2_[1] != -1) ::close(ctx.fd2_[1]);
+        ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+        ctx.atomic_set_req_id(0);
+        return;
+    }
+
+    bool fallback = false;
+    // 3. Send MP_SIG carrying req_id in sival_ptr (OB :304-309).
+    if (!send_capture_signal(pid, tid, req_id, result)) {
+        ::close(ctx.fd_[0]); ::close(ctx.fd_[1]);
+        ::close(ctx.fd2_[0]); ::close(ctx.fd2_[1]);
+        ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+        ctx.atomic_set_req_id(0);
+        result->elapsed_us = elapsed_us(start);
+        return;
+    }
+    if (result->outcome == ThreadOutcome::TGKILL_FALLBACK_USED) {
+        fallback = true; // handler will reject; surface as TIMEOUT below.
+    }
+
+    // 4. Wait for prepare-ack (50 ms in OB :315). Use the request budget so
+    //    a tight timeout does not silently truncate the handler.
+    int ack = 0;
+    if (wait_ack(ctx.fd_[0], timeout_ms, &ack)) {
+        // 5. Read PCs out of the shared ctx (this is what
+        //    ObSigBTOnlyProcessor::process does on the worker side; in our
+        //    inline model the coordinator copies directly because there is
+        //    no per-thread file descriptor).
+        result->frame_count = ctx.frame_count_;
+        result->truncated = ctx.truncated_;
+        int n = std::min<int>(ctx.frame_count_, ob_kill60::kMaxSignalFrames);
+        for (int i = 0; i < n; ++i) {
+            result->frames[i] = ctx.frames_[i];
+        }
+        result->outcome = ThreadOutcome::OK;
+
+        // 6. Notify worker that processing is done (OB :330-332).
+        int peer_ack = ack;
+        ssize_t w = ::write(ctx.fd2_[1], &peer_ack, sizeof(peer_ack));
+        static_cast<void>(w);
+
+        // 7. Wait exit-ack so the worker has cleanly left the handler before
+        //    we close the pipes and move on (OB :334-343).
+        int exit_ack = 0;
+        wait_ack(ctx.fd_[0], timeout_ms, &exit_ack);
+    } else {
+        result->outcome = fallback ? ThreadOutcome::TGKILL_FALLBACK_USED
+                                   : ThreadOutcome::TIMEOUT;
+    }
+
+    ::close(ctx.fd_[0]); ::close(ctx.fd_[1]);
+    ::close(ctx.fd2_[0]); ::close(ctx.fd2_[1]);
+    ctx.fd_[0] = ctx.fd_[1] = ctx.fd2_[0] = ctx.fd2_[1] = -1;
+    ctx.atomic_set_req_id(0);
+    result->elapsed_us = elapsed_us(start);
+}
