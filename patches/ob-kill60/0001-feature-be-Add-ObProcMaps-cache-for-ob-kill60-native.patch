+// https://github.com/oceanbase/oceanbase/blob/v4.5.0_CE/deps/oblib/src/lib/signal/ob_signal_struct.h
+// (class ObProcMaps) and modified by Doris for the ob-kill60 native stack
+// collector.
+
+#pragma once
+
+#include <cstdint>
+
+namespace doris::ob_kill60 {
+
+// Reason: caches /proc/self/maps so the coordinator can compute DSO offsets
+// without re-reading the file per request. Mirrors OceanBase ObProcMaps.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.h:87-107
+class ObProcMaps {
+public:
+    static ObProcMaps& get_instance() {
+        static ObProcMaps the_one;
+        return the_one;
+    }
+
+    // Reason: reload the cache; called from the HTTP coordinator before each
+    // dump so dlopen()'d shared objects show up. Reference:
+    // <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:52-88
+    void load_maps();
+
+    const char* get_maps(int64_t& len) const {
+        len = _pos;
+        return _buf;
+    }
+
+private:
+    ObProcMaps() = default;
+
+    // Reason: OB uses an 8 KiB fixed buffer; keep the same cap so the
+    // coordinator pass is bounded and signal-safe.
+    char _buf[8192] {};
+    int64_t _pos = 0;
+};
+
+} // namespace doris::ob_kill60
