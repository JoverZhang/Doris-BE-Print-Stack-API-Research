 be/src/common/ob_proc_maps.h   | 57 ++++++++++++++++++++++++
 2 files changed, 138 insertions(+)
 create mode 100644 be/src/common/ob_proc_maps.cpp
 create mode 100644 be/src/common/ob_proc_maps.h

