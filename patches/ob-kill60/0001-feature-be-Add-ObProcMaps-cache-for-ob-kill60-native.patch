+// (ObProcMaps::load_maps) and modified by Doris for the ob-kill60 native
+// stack collector.
+
+#include "common/ob_proc_maps.h"
+
+#include <cstdio>
+#include <cstring>
+#include <unistd.h>
+
+namespace doris::ob_kill60 {
+
+// Reason: parse /proc/self/maps, keep only executable mappings, and store
+// them in a fixed buffer the coordinator can scan after the worker dump.
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_struct.cpp:52-88
+void ObProcMaps::load_maps() {
+    // 1. Reset the cache so a re-load reflects the current process layout.
+    _pos = 0;
+
+    // 2. Open /proc/<pid>/maps; tolerate failure (collector reports DSO miss).
+    char fn[64];
+    snprintf(fn, sizeof(fn), "/proc/%d/maps", getpid());
+    FILE* file = std::fopen(fn, "rt");
+    if (file == nullptr) {
+        return;
+    }
+
+    // 3. For each line, drop non-executable mappings and append the rest
+    //    verbatim. Skip parsing entries with fewer than six tokens (OB does
+    //    the same to avoid mis-classifying odd kernel entries).
+    char line[1024];
+    while (std::fgets(line, sizeof(line), file) != nullptr) {
+        int len = static_cast<int>(std::strlen(line));
+        if (len > 0 && line[len - 1] == '\n') {
+            line[--len] = '\0';
+        }
+
+        // strtok_r mutates the line, so snapshot the buffer length first.
+        int64_t n = std::snprintf(_buf + _pos, sizeof(_buf) - _pos, "%s\n", line);
+
+        char* tokens[8] = {};
+        int token_cnt = 0;
+        char* saveptr = nullptr;
+        for (char* value = strtok_r(line, " ", &saveptr); value != nullptr && token_cnt < 8;
+             value = strtok_r(nullptr, " ", &saveptr)) {
+            tokens[token_cnt++] = value;
+        }
+        if (token_cnt < 6) {
+            continue;
+        }
+        const char* perms = tokens[1];
+        if (std::strlen(perms) == 4 && perms[2] != 'x') {
+            continue;
+        }
+        if (n < 0 || static_cast<size_t>(n) >= sizeof(_buf) - static_cast<size_t>(_pos)) {
+            break;
+        }
+        _pos += n;
+    }
+
+    std::fclose(file);
+}
+
+} // namespace doris::ob_kill60
