+
+ThreadCaptureSlot* find_slot_from_signal(DumpSession* session, siginfo_t* info, int64_t tid) {
+    if (info != nullptr && info->si_code == SI_QUEUE && info->si_value.sival_ptr != nullptr) {
+        const uintptr_t raw = reinterpret_cast<uintptr_t>(info->si_value.sival_ptr);
+        const uintptr_t begin = reinterpret_cast<uintptr_t>(session->slots);
+        const uintptr_t end = begin + session->slot_count * sizeof(ThreadCaptureSlot);
+        if (raw >= begin && raw < end && (raw - begin) % sizeof(ThreadCaptureSlot) == 0) {
+            auto* slot = reinterpret_cast<ThreadCaptureSlot*>(raw);
+            if (slot->tid == tid) {
+                return slot;
+            }
+        }
+    }
+    return find_slot_for_tid(session, tid);
+}
+
+void capture_with_libunwind(ThreadCaptureSlot* slot, DumpSession* session, void* raw_context) {
+#if defined(USE_UNWIND) && defined(__linux__) && defined(__x86_64__)
+    auto* signal_context = static_cast<ucontext_t*>(raw_context);
+    unw_cursor_t cursor;
+    int result = unw_init_local2(&cursor, reinterpret_cast<unw_context_t*>(signal_context),
+                                 UNW_INIT_SIGNAL_FRAME);
+    slot->unwind_init_result = result;
+    if (result < 0) {
+        slot->unwind_step_result = result;
+        slot->state.store(SLOT_UNWIND_FAILED, std::memory_order_release);
+        return;
+    }
+
+    int frame_count = 0;
+    int last_step = 0;
+    while (frame_count < session->max_frames) {
+        unw_word_t ip = 0;
+        result = unw_get_reg(&cursor, UNW_REG_IP, &ip);
+        if (result < 0) {
+            last_step = result;
+            break;
+        }
+        if (ip != 0) {
+            slot->frames[static_cast<size_t>(frame_count)] = static_cast<uintptr_t>(ip);
+            ++frame_count;
+        }
+        if (frame_count >= session->max_frames) {
+            break;
+        }
+
+        result = unw_step(&cursor);
+        if (result <= 0) {
+            last_step = result;
+            break;
+        }
+    }
+
+    slot->frame_count = frame_count;
+    slot->truncated = frame_count >= session->max_frames;
+    slot->unwind_step_result = last_step;
+    slot->state.store(frame_count == 0 && last_step < 0 ? SLOT_UNWIND_FAILED : SLOT_DONE,
+                      std::memory_order_release);
+#else
+    slot->unwind_init_result = -1;
+    slot->state.store(SLOT_UNSUPPORTED, std::memory_order_release);
+#endif
+}
+
+void native_stack_signal_handler(int, siginfo_t* info, void* raw_context) {
+    const int64_t handler_start_ns = monotonic_ns_for_signal();
+    DumpSession* session = s_active_session.load(std::memory_order_acquire);
+    if (session == nullptr) {
+        return;
+    }
+
+    const int64_t tid = static_cast<int64_t>(syscall(SYS_gettid));
+    ThreadCaptureSlot* slot = find_slot_from_signal(session, info, tid);
+    if (slot == nullptr) {
+        return;
+    }
+    if (slot->state.load(std::memory_order_acquire) != SLOT_PENDING) {
+        return;
+    }
+
+    capture_with_libunwind(slot, session, raw_context);
+    const int64_t handler_end_ns = monotonic_ns_for_signal();
+    if (handler_start_ns > 0 && handler_end_ns >= handler_start_ns) {
+        slot->handler_time_ns.store(handler_end_ns - handler_start_ns, std::memory_order_relaxed);
+    }
+}
+
+void install_signal_handler_once() {
+    std::call_once(s_signal_install_once, [] {
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            s_signal_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack signal handler: " << std::strerror(errno);
+        }
+    });
+}
+
+void mark_signal_failure(ThreadCaptureSlot* slot, int error_number) {
+    slot->signal_errno = error_number;
+    slot->state.store(SLOT_SIGNAL_FAILED, std::memory_order_release);
+}
+
+bool send_rt_tgsigqueueinfo(pid_t pid, ThreadCaptureSlot* slot) {
+#ifdef SYS_rt_tgsigqueueinfo
+    siginfo_t info {};
+    info.si_signo = native_stack_signal_number();
+    info.si_code = SI_QUEUE;
+    info.si_pid = pid;
+    info.si_uid = getuid();
+    info.si_value.sival_ptr = slot;
+    const long result = syscall(SYS_rt_tgsigqueueinfo, pid, static_cast<pid_t>(slot->tid),
+                                native_stack_signal_number(), &info);
+    if (result == 0) {
+        slot->signal_method = SIGNAL_METHOD_RT_TGSIGQUEUEINFO;
+        return true;
+    }
+    slot->rt_signal_errno = errno;
+#else
+    slot->rt_signal_errno = ENOSYS;
+#endif
+    return false;
+}
+
+void send_signal_with_fallback(pid_t pid, ThreadCaptureSlot* slot) {
+    if (send_rt_tgsigqueueinfo(pid, slot)) {
+        return;
+    }
+
+    slot->signal_method = SIGNAL_METHOD_TGKILL_FALLBACK;
+    const long result =
+            syscall(SYS_tgkill, pid, static_cast<pid_t>(slot->tid), native_stack_signal_number());
+    if (result != 0) {
+        mark_signal_failure(slot, errno);
+    }
+}
+
+void collect_thread_frames(ThreadCaptureSlot* slots, size_t slot_count, int max_frames,
+                           const RequestOptions& options,
+                           std::chrono::steady_clock::time_point start) {
+    DumpSession session;
+    session.slots = slots;
+    session.slot_count = slot_count;
+    session.max_frames = max_frames;
+
+    s_active_session.store(&session, std::memory_order_release);
+    const pid_t pid = getpid();
+    for (size_t i = 0; i < slot_count; ++i) {
+        if (slots[i].state.load(std::memory_order_acquire) != SLOT_PENDING) {
+            continue;
+        }
+        send_signal_with_fallback(pid, &slots[i]);
+    }
+
+    const auto deadline = start + std::chrono::milliseconds(options.timeout_ms);
+    while (std::chrono::steady_clock::now() < deadline) {
+        bool all_done = true;
+        for (size_t i = 0; i < slot_count; ++i) {
+            if (slots[i].state.load(std::memory_order_acquire) == SLOT_PENDING) {
+                all_done = false;
+                break;
+            }
+        }
+        if (all_done) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    s_active_session.store(nullptr, std::memory_order_release);
+    for (size_t i = 0; i < slot_count; ++i) {
+        int expected = SLOT_PENDING;
+        slots[i].state.compare_exchange_strong(expected, SLOT_TIMEOUT, std::memory_order_acq_rel);
+    }
+}
+
+const char* signal_method_name(int method) {
+    switch (method) {
+    case SIGNAL_METHOD_RT_TGSIGQUEUEINFO:
+        return "rt_tgsigqueueinfo";
+    case SIGNAL_METHOD_TGKILL_FALLBACK:
+        return "tgkill_fallback";
+    default:
+        return "none";
+    }
+}
+
+std::string slot_status(const ThreadCaptureSlot& slot) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_DONE:
+        return "ok";
+    case SLOT_SIGNAL_FAILED:
+        return slot.signal_errno == ESRCH ? "exited_thread" : "signal_failed";
+    case SLOT_TIMEOUT:
+        return "timeout";
+    case SLOT_UNSUPPORTED:
+        return "unsupported_arch";
+    case SLOT_SIGNAL_BLOCKED:
+        return "signal_blocked";
+    case SLOT_UNWIND_FAILED:
+        return "unwind_failed";
+    default:
+        return "pending";
+    }
+}
+
+std::string slot_error_reason(const ThreadCaptureSlot& slot) {
+    switch (slot.state.load(std::memory_order_acquire)) {
+    case SLOT_DONE:
+        if (slot.frame_count == 0) {
+            return "libunwind returned no PCs";
+        }
+        if (slot.unwind_step_result < 0) {
+            return "libunwind step failed after collecting PCs";
+        }
+        return "";
+    case SLOT_SIGNAL_FAILED:
+        if (slot.rt_signal_errno != 0) {
+            return std::string("rt_tgsigqueueinfo failed: ") + std::strerror(slot.rt_signal_errno) +
+                   "; tgkill failed: " + std::strerror(slot.signal_errno);
+        }
+        return std::string("tgkill failed: ") + std::strerror(slot.signal_errno);
+    case SLOT_TIMEOUT:
+        return "thread did not run native stack signal handler before timeout";
+    case SLOT_UNSUPPORTED:
+        return "libunwind collector requires Linux x86_64 with USE_UNWIND";
+    case SLOT_SIGNAL_BLOCKED:
+        return "thread blocks the native stack signal";
+    case SLOT_UNWIND_FAILED:
+        return "libunwind failed in the signal handler";
+    default:
+        return "unexpected pending state";
+    }
+}
