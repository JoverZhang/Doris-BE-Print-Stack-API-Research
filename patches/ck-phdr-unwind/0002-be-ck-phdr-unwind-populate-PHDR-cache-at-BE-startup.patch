From f7a3ee8629960e0a21e815b8643fd9b06c24a5e1 Mon Sep 17 00:00:00 2001
From: "Mira (mira/mira)" <hey2missmira@gmail.com>
Date: Thu, 4 Jun 2026 08:36:06 +0000
Subject: [PATCH 2/4] (be) ck-phdr-unwind populate PHDR cache at BE startup

Call `updatePHDRCache()` in `doris_main` before `BackendOptions::init` so the lock-free `dl_iterate_phdr` override (patch 1) sees a populated cache by the time any BE worker thread that may run the print_stack signal handler exists. The call sits at the existing upstream-anchored line between `MemInfo::debug_string()` and `BackendOptions::init()`.

Spec: docs/design/ck.md "Decisions".

Co-Authored-By: jover <joverzh@gmail.com>
---
 be/src/service/doris_main.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/be/src/service/doris_main.cpp b/be/src/service/doris_main.cpp
index 7102d326a19..e70f515f60a 100644
--- a/be/src/service/doris_main.cpp
+++ b/be/src/service/doris_main.cpp
@@ -48,6 +48,7 @@
 
 #include "cloud/cloud_backend_service.h"
 #include "cloud/config.h"
+#include "common/phdr_cache.h"
 #include "common/stack_trace.h"
 #include "runtime/memory/mem_tracker_limiter.h"
 #include "storage/tablet/tablet_schema_cache.h"
@@ -587,10 +588,12 @@ int main(int argc, char** argv) {
     LOG(INFO) << doris::DiskInfo::debug_string();
     LOG(INFO) << doris::MemInfo::debug_string();
 
-    // PHDR speed up exception handling, but exceptions from dynamically loaded libraries (dlopen)
-    // will work only after additional call of this function.
-    // rewrites dl_iterate_phdr will cause Jemalloc to fail to run after enable profile. see #
-    // updatePHDRCache();
+    // Reason: populate the PHDR cache before any BE worker thread that
+    // may run the print_stack signal handler exists. The handler's
+    // `unw_step` reaches `dl_iterate_phdr`; with a populated cache the
+    // override serves callbacks without taking the loader lock.
+    // Spec: docs/design/ck.md "Decisions".
+    updatePHDRCache();
     if (!doris::BackendOptions::init()) {
         exit(-1);
     }
