From ae5cc1519bde5ef569f75bb6d1fad0f418093bd2 Mon Sep 17 00:00:00 2001
From: "Mira (mira/mira)" <hey2missmira@gmail.com>
Date: Thu, 4 Jun 2026 08:40:39 +0000
Subject: [PATCH 4/4] (be) ck-phdr-unwind build-system jemalloc with libunwind
 backtracer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add `be/cmake/build-jemalloc-prof-libunwind.sh` to rebuild jemalloc with `--enable-prof-libunwind` plus the flag set `thirdparty/build-thirdparty.sh` `build_jemalloc_doris()` uses (`--with-jemalloc-prefix=je`, `--with-install-suffix=_doris`, `--enable-prof`, `--disable-cxx`, `--disable-libdl`, `--disable-shared`). The script verifies `backtrace_method = libunwind` in `config.log` and aborts on mismatch — jemalloc/jemalloc#2504 lets libunwind detection silently fall back to libgcc, and the verify step is the only safety net.

The archive lives at `${PROJECT_ROOT}/.tmp/jemalloc-prof-libunwind/install/lib/libjemalloc_doris.a`. `PROJECT_ROOT` is the harness root (parent of `repos/source/doris-master`), exported by `scripts/in-container`; the script derives it from its own location when unset. `phase2-reset` operates only inside `$DORIS_REPO`, so the archive survives resets.

Edit `be/cmake/thirdparty.cmake`: replace the prebuilt `add_thirdparty(jemalloc ...)` with an IMPORTED static target pointing at the locally-built archive. No CMake option — one configuration. The block calls `message(FATAL_ERROR ...)` with the exact helper command if the archive is missing.

Spec: docs/design/ck.md "Decisions".

Co-Authored-By: jover <joverzh@gmail.com>
---
 be/cmake/build-jemalloc-prof-libunwind.sh | 93 +++++++++++++++++++++++
 be/cmake/thirdparty.cmake                 | 26 ++++++-
 2 files changed, 118 insertions(+), 1 deletion(-)
 create mode 100755 be/cmake/build-jemalloc-prof-libunwind.sh

diff --git a/be/cmake/build-jemalloc-prof-libunwind.sh b/be/cmake/build-jemalloc-prof-libunwind.sh
new file mode 100755
index 00000000000..76474a265e1
--- /dev/null
+++ b/be/cmake/build-jemalloc-prof-libunwind.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+# Reason: build a `libjemalloc_doris.a` whose heap-profile backtracer
+# uses `unw_backtrace` instead of libgcc's `_Unwind_Backtrace`. The
+# libgcc path re-enters `dl_iterate_phdr` through `_Unwind_Find_FDE`,
+# which deadlocks against the lock-free override under profiling load.
+# The archive lives at the harness project root `.tmp/` so it survives
+# `phase2-reset` (reset operates only inside `$DORIS_REPO`).
+# Spec: docs/design/ck.md "Decisions".
+# Reference: <ck>'s contrib/jemalloc-cmake configures jemalloc with the
+# same `--enable-prof-libunwind` flag.
+set -euo pipefail
+
+# Resolve the harness project root (parent of repos/source/doris-master).
+# `scripts/in-container` and `scripts/phase2/*` export PROJECT_ROOT; when
+# absent (e.g. running from `just phase2-shell`), derive it from the
+# script's own location.
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+: "${PROJECT_ROOT:=$(cd "${SCRIPT_DIR}/../../../../.." && pwd)}"
+
+ARCHIVE_DIR="${PROJECT_ROOT}/.tmp/jemalloc-prof-libunwind"
+INSTALL_DIR="${ARCHIVE_DIR}/install"
+ARCHIVE_LIB="${INSTALL_DIR}/lib/libjemalloc_doris.a"
+
+# Reason: helper is idempotent so `phase2-bootstrap` can call it on every
+# variant apply without paying for a rebuild after the first run.
+if [[ -f "${ARCHIVE_LIB}" ]]; then
+    echo "build-jemalloc-prof-libunwind: ${ARCHIVE_LIB} exists; skipping rebuild."
+    exit 0
+fi
+
+# Reason: pin matches `thirdparty/vars.sh` `JEMALLOC_DORIS_*`.
+JEMALLOC_VERSION="${JEMALLOC_VERSION:-5.3.0}"
+JEMALLOC_TARBALL="jemalloc-${JEMALLOC_VERSION}.tar.bz2"
+JEMALLOC_URL="${JEMALLOC_URL:-https://github.com/jemalloc/jemalloc/releases/download/${JEMALLOC_VERSION}/${JEMALLOC_TARBALL}}"
+
+TP_INSTALL="${DORIS_THIRDPARTY:-/var/local/thirdparty}/installed"
+
+SRC_DIR="${ARCHIVE_DIR}/src"
+SRC_JEMALLOC="${SRC_DIR}/jemalloc-${JEMALLOC_VERSION}"
+
+mkdir -p "${SRC_DIR}" "${INSTALL_DIR}"
+
+# 1. Fetch and unpack the jemalloc source tarball if not already present.
+#    `--no-same-owner` keeps tar from trying to chown to the tarball's
+#    stored uid/gid; rootless containers cannot honor that and tar fails
+#    the whole extraction.
+if [[ ! -f "${SRC_JEMALLOC}/configure" ]]; then
+    echo "Fetching ${JEMALLOC_URL}"
+    curl -fsSL "${JEMALLOC_URL}" -o "${SRC_DIR}/${JEMALLOC_TARBALL}"
+    tar --no-same-owner -xjf "${SRC_DIR}/${JEMALLOC_TARBALL}" -C "${SRC_DIR}"
+fi
+
+# 2. Configure with the same flag set as `thirdparty/build-thirdparty.sh`
+#    `build_jemalloc_doris()`, plus `--enable-prof-libunwind`. CPPFLAGS
+#    and LDFLAGS point the configure check at the thirdparty libunwind
+#    so detection does not silently fall back to libgcc.
+#    `LIBS=-llzma` is appended after `-lunwind` in autoconf's link
+#    check; the thirdparty libunwind is built with `-llzma` (for
+#    compressed ELF debug sections) and conftest's `-lunwind` alone
+#    leaves `lzma_*` symbols undefined, which makes the detection fail.
+cd "${SRC_JEMALLOC}"
+CFLAGS="${CFLAGS:--O3 -fno-omit-frame-pointer -fPIC -g}" \
+CPPFLAGS="-I${TP_INSTALL}/include" \
+LDFLAGS="-L${TP_INSTALL}/lib64 -L${TP_INSTALL}/lib" \
+LIBS="-llzma" \
+./configure \
+    --prefix="${INSTALL_DIR}" \
+    --with-install-suffix="_doris" \
+    --with-jemalloc-prefix=je \
+    --enable-prof \
+    --enable-prof-libunwind \
+    --disable-cxx \
+    --disable-libdl \
+    --disable-shared
+
+# 3. Build and install.
+make -j "$(nproc)"
+make install
+
+# 4. Verify the backtracer choice. jemalloc/jemalloc#2504: detection can
+#    silently fall back to libgcc. The verify step is the only safety net.
+#    jemalloc 5.3.0 records the choice in `config.log` as one of three
+#    `result:` lines: `prof-libunwind : 1` (libunwind), `prof-libgcc : 1`
+#    (libgcc fallback), or `prof-gcc : 1` (gcc builtins). The `result:`
+#    prefix lives at the start of the line.
+if ! grep -qE "result: prof-libunwind +: 1$" config.log; then
+    echo "ERROR: prof-libunwind != 1 in config.log;" \
+         "libunwind detection failed (jemalloc/jemalloc#2504)." >&2
+    grep -E "result: prof-(libunwind|libgcc|gcc) +:" config.log >&2 || true
+    exit 1
+fi
+
+echo "build-jemalloc-prof-libunwind: built ${ARCHIVE_LIB}; prof-libunwind = 1 confirmed."
diff --git a/be/cmake/thirdparty.cmake b/be/cmake/thirdparty.cmake
index 1dba907307d..dcdc196705f 100644
--- a/be/cmake/thirdparty.cmake
+++ b/be/cmake/thirdparty.cmake
@@ -80,7 +80,31 @@ add_thirdparty(crypto)
 add_thirdparty(openssl LIBNAME "lib/libssl.a")
 add_thirdparty(leveldb)
 if (USE_JEMALLOC)
-    add_thirdparty(jemalloc LIBNAME "lib/libjemalloc_doris.a")
+    # Reason: link the locally-built `libjemalloc_doris.a` whose
+    # heap-profile backtracer uses `unw_backtrace` instead of libgcc's
+    # `_Unwind_Backtrace`. The libgcc path re-enters `dl_iterate_phdr`
+    # through `_Unwind_Find_FDE` and deadlocks against the lock-free
+    # override under profiling load. Build the archive first via
+    # `be/cmake/build-jemalloc-prof-libunwind.sh`; the archive lives at
+    # the harness project root `.tmp/` so `phase2-reset` does not touch
+    # it.
+    # Spec: docs/design/ck.md "Decisions".
+    if (DEFINED ENV{PROJECT_ROOT})
+        set(_phase2_project_root "$ENV{PROJECT_ROOT}")
+    else()
+        get_filename_component(_phase2_project_root
+            "${CMAKE_SOURCE_DIR}/../../../.." ABSOLUTE)
+    endif()
+    set(_phase2_jemalloc_lib
+        "${_phase2_project_root}/.tmp/jemalloc-prof-libunwind/install/lib/libjemalloc_doris.a")
+    if (NOT EXISTS "${_phase2_jemalloc_lib}")
+        message(FATAL_ERROR
+            "ck-phdr-unwind: ${_phase2_jemalloc_lib} is missing; "
+            "run be/cmake/build-jemalloc-prof-libunwind.sh first.")
+    endif()
+    add_library(jemalloc STATIC IMPORTED)
+    set_target_properties(jemalloc PROPERTIES
+        IMPORTED_LOCATION "${_phase2_jemalloc_lib}")
 else()
     add_thirdparty(tcmalloc WHOLELIBPATH ${GPERFTOOLS_HOME}/lib/libtcmalloc.a NOTADD)
 endif()
