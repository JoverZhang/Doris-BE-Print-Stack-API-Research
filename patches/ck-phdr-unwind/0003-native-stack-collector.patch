+struct MemoryMap {
+    uintptr_t start = 0;
+    uintptr_t end = 0;
+    uintptr_t offset = 0;
+    std::string path;
+};
+
+std::string trim_left_spaces(std::string value) {
+    const size_t first = value.find_first_not_of(' ');
+    if (first == std::string::npos) {
+        return "";
+    }
+    return value.substr(first);
+}
+
+// Reason: snapshots /proc/self/maps once per request so each PC can be turned
+// into <dso, dso_offset> for the API response.
+std::vector<MemoryMap> load_memory_maps() {
+    std::vector<MemoryMap> maps;
+    std::ifstream input("/proc/self/maps");
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream iss(line);
+        std::string range;
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> range >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+        const size_t dash = range.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+
+        MemoryMap map;
+        if (!parse_hex_uintptr(range.substr(0, dash), &map.start) ||
+            !parse_hex_uintptr(range.substr(dash + 1), &map.end) ||
+            !parse_hex_uintptr(offset_hex, &map.offset) || map.start >= map.end) {
+            continue;
+        }
+
+        std::string path;
+        std::getline(iss, path);
+        map.path = trim_left_spaces(path);
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
+
+std::string hex_uintptr(uintptr_t value) {
+    std::ostringstream out;
+    out << "0x" << std::hex << value;
+    return out.str();
+}
+
+// Reason: thin syscall wrapper. Mirrors ck so the sender can pass a sequence
+// number through `siginfo_t.si_value.sival_int`.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:114-118
+int rt_tgsigqueueinfo(pid_t tgid, pid_t tid, int sig, siginfo_t* info) {
+#ifdef SYS_rt_tgsigqueueinfo
+    return static_cast<int>(syscall(SYS_rt_tgsigqueueinfo, tgid, tid, sig, info));
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+}
+
+// Reason: fallback when `rt_tgsigqueueinfo` is unavailable. ck does not need
+// this fallback; Phase 2 keeps it because Doris targets older kernels too.
+int tgkill(pid_t tgid, pid_t tid, int sig) {
+    return static_cast<int>(syscall(SYS_tgkill, tgid, tid, sig));
+}
+
+// Reason: walks the stack in the signal context with libunwind and writes
+// each PC into the global capture buffer.
+// IMPORTANT: this runs in a signal handler. No allocations, no locks, no
+// logging, no syscalls except libunwind's own. ck enforces the same rule
+// with `DENY_ALLOCATIONS_IN_SCOPE`; Doris has no equivalent macro, so the
+// invariant is checked by inspection and reinforced by this comment.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:120-183
+void capture_frames_in_signal_context(void* raw_context) {
+#if defined(USE_UNWIND) && defined(__linux__) && defined(__x86_64__)
+    auto* signal_context = static_cast<ucontext_t*>(raw_context);
+    unw_cursor_t cursor;
+    int init_result = unw_init_local2(
+            &cursor, reinterpret_cast<unw_context_t*>(signal_context), UNW_INIT_SIGNAL_FRAME);
+    s_capture_unwind_init.store(init_result, std::memory_order_release);
+    if (init_result < 0) {
+        s_capture_unwind_step.store(init_result, std::memory_order_release);
+        s_capture_frame_count.store(0, std::memory_order_release);
+        s_capture_truncated.store(false, std::memory_order_release);
+        return;
+    }
+
+    size_t frame_count = 0;
+    int last_step = 0;
+    while (frame_count < kMaxSignalFrames) {
+        unw_word_t ip = 0;
+        int result = unw_get_reg(&cursor, UNW_REG_IP, &ip);
+        if (result < 0) {
+            last_step = result;
+            break;
+        }
+        if (ip != 0) {
+            s_capture_frames[frame_count] = static_cast<uintptr_t>(ip);
+            ++frame_count;
+        }
+        if (frame_count >= kMaxSignalFrames) {
+            break;
+        }
+        result = unw_step(&cursor);
+        if (result <= 0) {
+            last_step = result;
+            break;
+        }
+    }
+    s_capture_frame_count.store(frame_count, std::memory_order_release);
+    s_capture_truncated.store(frame_count >= kMaxSignalFrames, std::memory_order_release);
+    s_capture_unwind_step.store(last_step, std::memory_order_release);
+#else
+    (void)raw_context;
+    s_capture_frame_count.store(0, std::memory_order_release);
+    s_capture_truncated.store(false, std::memory_order_release);
+    s_capture_unwind_init.store(-1, std::memory_order_release);
+    s_capture_unwind_step.store(-1, std::memory_order_release);
+#endif
+}
+
+// Reason: the SIGRTMIN handler. Mirrors ck: anti-spoof on `si_pid`, sequence
+// check, single-handler latch, capture frames, write notification to the
+// pipe. Restores errno on every exit path.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:120-183
+void signal_handler(int, siginfo_t* info, void* context) {
+    // No allocations, no locks, no logging in signal context.
+    int saved_errno = errno;
+
+    // Reason: reject signals from outside this process (manual `kill` from a
+    // foreign uid would otherwise let an attacker inject sequence numbers).
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:128-129
+    if (info->si_pid != s_server_pid.load(std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+
+    // Reason: drop signals delivered after the sender moved on to the next
+    // thread. Without this check a late handler would overwrite the buffer
+    // for a thread we are no longer reading.
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:132-133
+    int notification_num = info->si_value.sival_int;
+    if (notification_num != s_sequence_num.load(std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+
+    // Reason: single-handler latch closes the race where two delayed handlers
+    // could both pass the sequence check.
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:143-145
+    bool expected = false;
+    if (!s_signal_latch.compare_exchange_strong(expected, true, std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+
+    // Reason: capture the stack from the saved signal context.
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:162-163
+    capture_frames_in_signal_context(context);
+
+    // Reason: store the notification number after capture so the sender can
+    // confirm via `data_ready_num` that the buffer it is about to read
+    // matches the request it just sent.
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:173
+    s_data_ready_num.store(notification_num, std::memory_order_release);
+
+    // Reason: notify the sender via the pipe; the actual notification number
+    // travels through the pipe so the sender can drain stale notifications.
+    // Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:175-178
+    ssize_t write_res =
+            ::write(s_notification_pipe_write, &notification_num, sizeof(notification_num));
+    (void)write_res; // signal-safe; ignore failure
+
+    errno = saved_errno;
+    s_signal_latch.store(false, std::memory_order_release);
+}
+
+// Reason: poll the pipe for a notification matching the current sequence
+// number. EINTR retries decrement the budget so we cannot wait forever.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:186-229
+bool wait_for_notification(int timeout_ms) {
+    while (true) {
+        if (s_notification_pipe_read < 0) {
+            return false;
+        }
+        pollfd poll_fd {s_notification_pipe_read, POLLIN, 0};
+        int poll_res = poll(&poll_fd, 1, timeout_ms);
+        if (poll_res < 0) {
+            if (errno == EINTR) {
+                if (--timeout_ms <= 0) {
+                    return false;
+                }
+                continue;
+            }
+            return false;
+        }
+        if (poll_res == 0) {
+            return false;
+        }
+
+        int notification_num = 0;
+        ssize_t read_res = ::read(s_notification_pipe_read, &notification_num,
+                                  sizeof(notification_num));
+        if (read_res < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+
+        if (read_res == sizeof(notification_num)) {
+            if (notification_num == s_sequence_num.load(std::memory_order_relaxed)) {
+                return true;
+            }
+            // Drain delayed notifications and keep waiting.
+            continue;
+        }
+
+        return false;
+    }
+}
+
+// Reason: install the signal handler and open the notification pipe once per
+// BE process. ck does the equivalent setup in the storage ctor.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:740-758
+void install_signal_handler_once() {
+    std::call_once(s_signal_install_once, [] {
+        int pipe_fds[2] = {-1, -1};
+        if (pipe2(pipe_fds, O_CLOEXEC) != 0) {
+            LOG(ERROR) << "failed to open notification pipe for native stack collector: "
+                       << std::strerror(errno);
+            return;
+        }
+        s_notification_pipe_read = pipe_fds[0];
+        s_notification_pipe_write = pipe_fds[1];
+
+        s_server_pid.store(getpid(), std::memory_order_release);
+
+        struct sigaction sa {};
+        sa.sa_sigaction = signal_handler;
+        sa.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigemptyset(&sa.sa_mask) != 0 ||
+            sigaddset(&sa.sa_mask, kStackTraceServiceSignal) != 0) {
+            LOG(ERROR) << "failed to initialize sigaction mask: " << std::strerror(errno);
+            return;
+        }
+        if (sigaction(kStackTraceServiceSignal, &sa, nullptr) != 0) {
+            LOG(ERROR) << "failed to install native stack signal handler: "
+                       << std::strerror(errno);
+            return;
+        }
+        s_signal_installed.store(true, std::memory_order_release);
+    });
+}
