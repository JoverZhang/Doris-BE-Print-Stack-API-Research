+// Reason: reads `/proc/<tid>/status` to check whether the target thread blocks
+// the service signal. ck's same check skips the signal-send when blocked so
+// the wait does not time out for nothing.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:294-327
+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
