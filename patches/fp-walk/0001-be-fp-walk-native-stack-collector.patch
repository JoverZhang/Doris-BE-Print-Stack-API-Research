-// Reason: the per-variant collect step. The common build ships this stub;
-// each variant patch (fp-walk, ck-phdr-unwind, ...) rewrites only this file
-// with its real collector, so every other file in the seam stays put.
-// Spec: docs/phase2-design.md "Common API" -> stub collect().
+// Reason: the fp-walk variant of the common collector seam. The per-thread
+// capture interrupts the target with a queued realtime signal, then walks
+// the saved-RBP chain from `ucontext_t` inside the handler. fp-walk runs
+// no libunwind and overrides no `dl_iterate_phdr`, so the allocator path
+// never collides with the handler.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
 namespace doris::native_stack {
 namespace {
 
-// Reason: the stub proves the response shape and the single-dump gate
-// without real signaling — every live thread reports `ok` with no frames.
-// `run_collection` owns the gate, tid selection, and aggregation, so the
-// stub only fills status.
-void stub_capture(int64_t /*tid*/, const CollectOptions& /*opts*/,
-                  std::chrono::steady_clock::time_point /*deadline*/, ThreadStack* out) {
-    out->status = "ok";
+// Reason: a runaway frame walk would block the handler indefinitely. This
+// cap stops the walk and sizes each slot's frame array.
+// Local: fp-walk-specific cap.
+constexpr int kMaxSignalFrames = 1024;
+
+// Reason: the slot ring size. Per-sequence slots prevent a late handler
+// at seq=K from clobbering the next dump's writes at seq=K+1. A ring of N
+// slots keyed by `seq % N` tolerates up to N-1 simultaneous late handlers
+// before the next coordinator arming returns `slot_busy` instead of
+// reusing an in-use slot. N=4 covers normal contention; pathologically
+// stuck handlers (signal delivered but thread descheduled for seconds)
+// will still leak their slot until they finally exit.
+// Local: fp-walk-specific bound; no CK or OB precedent.
+constexpr int kSlotRingSize = 4;
+
+// Reason: budget for waiting on a late handler to drain after a per-thread
+// timeout. Bounded so a stuck handler does not extend the whole dump's
+// wall clock; the slot is reported leaked after this.
+// Local: fp-walk-specific cadence.
+constexpr int64_t kHandlerDrainBudgetMs = 50;
+
+// Reason: a realtime signal queues rather than coalesces, and `SI_QUEUE`
+// lets the sender attach a request token in `si_value`. SIGRTMIN+6 is the
+// only realtime slot the BE uses for stack dumps. CK uses `sival_int`; OB
+// uses `sival_ptr`. fp-walk follows OB so the token is wide enough for a
+// 64-bit monotonic sequence.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:131-134
+//   (sequence check on `sival_int`).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:304-309
+//   (queued `SI_QUEUE` with `sival_ptr` request id).
+int native_stack_signal_number() {
+    return SIGRTMIN + 6;
+}
+
+int64_t monotonic_ns() {
+    timespec ts {};
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return 0;
+    }
+    return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + static_cast<int64_t>(ts.tv_nsec);
+}
+
+// Reason: the slot's state machine. The coordinator owns the IDLE→PENDING
+// transition (arm) and the WALKING/DONE→IDLE transition (release). The
+// handler owns PENDING→WALKING (entry) and WALKING→DONE / WALKING→IDLE
+// (publish or drop). Per-slot state is what makes the per-sequence ring
+// safe: a coordinator can only arm a slot in IDLE, so a slot held by a
+// late WALKING handler is never re-armed under it.
+// Local: fp-walk-specific state machine.
+enum SlotState : int {
+    SLOT_IDLE = 0,
+    SLOT_PENDING = 1,
+    SLOT_WALKING = 2,
+    SLOT_DONE = 3,
+};
+
+// Reason: one capture slot. With per-sequence ring slots the handler at
+// seq=K writes to its own slot; the next coordinator arming uses a
+// different slot (or returns `slot_busy` if the ring is exhausted). This
+// closes the mid-walk frame-write race that a single shared slot left
+// open.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:103
+//   (the single global `stack_trace`; CK serializes via a pipe-based wait
+//   that drains delayed notifications, which fp-walk does not).
+struct CaptureSlot {
+    // Reason: the request token. A handler whose `seq` does not match
+    // this value drops at entry. The coordinator sets it on arm and
+    // clears it to 0 on disarm.
+    std::atomic<uint64_t> expected_seq {0};
+    // Reason: the slot's state machine field. See SlotState above.
+    std::atomic<int> state {SLOT_IDLE};
+    int max_frames = 0;
+    uintptr_t max_stack_bytes = 0;
+    uintptr_t frames[kMaxSignalFrames] {};
+    int frame_count = 0;
+    bool truncated = false;
+    std::atomic<int64_t> handler_ns {0};
+};
+
+// Reason: the per-sequence slot ring. Slots live for the process
+// lifetime, so a late handler that reaches the write step never
+// dereferences a dangling pointer. A coordinator arming at seq=K targets
+// `g_slots[(K-1) % N]` so seqs K and K+1 cannot collide.
+// Local: fp-walk-specific storage; see kSlotRingSize.
+CaptureSlot g_slots[kSlotRingSize];
+
+// Reason: a monotonic sequence number that rides in the signal payload as
+// the dump's request token. The handler matches it against the slot's
+// `expected_seq` before writing. CK uses `sequence_num` the same way; OB
+// calls it `req_id`.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:131-134
+//   (handler checks `sival_int` against `sequence_num`).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:293-307
+//   (atomic `req_id` queued as `sival_ptr`).
+std::atomic<uint64_t> g_seq {0};
+
+std::once_flag g_install_once;
+std::atomic<bool> g_installed {false};
+
+// Reason: cached page size, populated alongside handler install. The
+// in-handler `page_is_mapped` check needs this to round an RBP down to
+// its page base before calling `mincore`. `sysconf` is not in the POSIX
+// async-signal-safe list, so we read it once at install time and only
+// touch the cached atomic from the handler.
+// Local: fp-walk-specific cache for the junk-RBP guard.
+std::atomic<long> g_page_size {0};
+
+// Reason: test-only hook. When the handler enters and the running
+// thread's tid matches this value, the handler busy-waits in WALKING
+// until the value is cleared. The
+// LateHandlerCannotCorruptNextDumpUnderLoad case uses this to hold one
+// slot in WALKING deterministically, so the per-sequence ring's CAS
+// rejection is exercised by subsequent arms.
+// Local: test hook; cleared by `pause_handler_for_tid_for_test(0)`.
+std::atomic<int64_t> g_pause_handler_for_tid {0};
+
+CaptureSlot& slot_for_seq(uint64_t seq) {
+    return g_slots[(seq - 1) % kSlotRingSize];
+}
+
+// Reason: refuse to dereference an RBP whose page is unmapped. `mincore`
+// returns -1 with errno=ENOMEM if any byte in `[addr, addr + length)`
+// lies in unmapped memory; we treat any non-zero return as "do not
+// touch". This is the codex-flagged junk-RBP guard: a corrupt or hostile
+// RBP that points outside the address space's mapped regions never gets
+// dereferenced.
+// NOTE: this does NOT reject PROT_NONE pages (stack guard pages, etc.).
+// `mincore` reports those as mapped-but-not-resident, so a `*rbp` into a
+// guard page still crashes. A `sigsetjmp`/`siglongjmp` fault trampoline
+// would close that residual case; deferred.
+// Local: fp-walk-specific safety check.
+bool page_is_mapped(uintptr_t addr) {
+    const long page_size = g_page_size.load(std::memory_order_acquire);
+    if (page_size <= 0) {
+        return false;
+    }
+    const uintptr_t mask = static_cast<uintptr_t>(page_size) - 1;
+    const uintptr_t page_base = addr & ~mask;
+    // The walk reads 16 bytes at `rbp`; round the length up so a read
+    // straddling a page boundary checks both pages.
+    constexpr uintptr_t kReadBytes = static_cast<uintptr_t>(2U * sizeof(uintptr_t));
+    const uintptr_t span = (addr + kReadBytes) - page_base;
+    const uintptr_t length = (span + mask) & ~mask;
+    unsigned char vec[2] = {0, 0};
+    return mincore(reinterpret_cast<void*>(page_base),
+                   static_cast<size_t>(length), vec) == 0;
+}
+
+bool parse_hex_u64(const std::string& value, uint64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uint64_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: a thread that blocks the collector signal would never run the
+// handler. Report it as `signal_blocked` so the dump distinguishes it
+// from a slow thread that should time out.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:294-326
+//   (CK's `isSignalBlocked` reads `SigBlk:` from /proc the same way).
+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
+
+// Reason: a corrupt or hostile RBP would otherwise let the handler read
+// past the stack and crash the process. Every read must stay aligned and
+// inside the half-open window `[initial_rbp, initial_rbp +
+// max_stack_bytes)`, anchored at the RBP captured from `ucontext_t`.
+//
+// NOTE: this bound trusts that the captured `initial_rbp` is itself a
+// valid stack pointer. A junk `initial_rbp` (e.g. signal interrupts a
+// function prologue or jitted code without the saved-frame convention)
+// will pass this check and the first deref will crash the BE. Validating
+// `initial_rbp` against `/proc/self/task/<tid>/stat` + `/proc/self/maps`
+// requires either parsing in the handler (unsafe — heap/locks) or
+// pre-fetching in the coordinator (the obvious version returned ranges
+// that did not always contain the captured RBP for pthread-allocated
+// stacks). A follow-up will use mincore() or sigsetjmp/siglongjmp to
+// close this; until then case 14 only verifies the bounds-against-anchor
+// path, not the junk-RBP rejection.
+// Local: fp-walk-specific safety check.
+bool rbp_can_read(uintptr_t initial_rbp, uintptr_t rbp, uintptr_t max_stack_bytes) {
+    constexpr uintptr_t kReadBytes = static_cast<uintptr_t>(2U * sizeof(uintptr_t));
+    if (initial_rbp == 0 || rbp < initial_rbp || max_stack_bytes < kReadBytes) {
+        return false;
+    }
+    if (rbp - initial_rbp > max_stack_bytes - kReadBytes) {
+        return false;
+    }
+    return rbp % alignof(uintptr_t) == 0;
+}
+
+// Reason: the realtime-signal handler. It validates the sender and the
+// request token, transitions the slot from PENDING to WALKING, walks the
+// RBP chain (bounded by the user's max_stack_bytes anchored at the
+// captured RBP), records handler time, then publishes DONE or releases
+// the slot if the dump moved on. The CAS into WALKING is the safety
+// hand-off: a coordinator can never re-arm a slot whose state is
+// WALKING, so the handler's mid-walk frame writes cannot land in the
+// next dump's payload.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:123,128-134,180
+//   (errno save/restore, `si_pid` sender check, `sival_int` token check).
+void native_stack_signal_handler(int /*sig*/, siginfo_t* info, void* raw_context) {
+    const int saved_errno = errno;
+
+    // 1. Ignore any signal this process did not queue for a dump.
+    if (info == nullptr || info->si_code != SI_QUEUE || info->si_pid != getpid()) {
+        errno = saved_errno;
+        return;
+    }
+    // 2. Drop a handler whose request token no longer matches the live dump.
+    const uint64_t seq = reinterpret_cast<uintptr_t>(info->si_value.sival_ptr);
+    if (seq == 0) {
+        errno = saved_errno;
+        return;
+    }
+    CaptureSlot& slot = slot_for_seq(seq);
+    if (seq != slot.expected_seq.load(std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+    // 3. Claim the slot for WALKING. Fail closed if the coordinator
+    //    already transitioned it away (e.g. timeout drove PENDING -> IDLE).
+    int expected_state = SLOT_PENDING;
+    if (!slot.state.compare_exchange_strong(expected_state, SLOT_WALKING,
+                                            std::memory_order_acq_rel)) {
+        errno = saved_errno;
+        return;
+    }
+    // 3a. Test hook: pause this handler in WALKING if its tid matches
+    //     the requested pause-tid. Atomic load is signal-safe. The
+    //     LateHandlerCannotCorruptNextDumpUnderLoad case uses this to
+    //     hold the slot so subsequent arms exercise the ring's CAS
+    //     rejection. The check costs one atomic load when no test is
+    //     pausing; the cost is acceptable for the safety it unlocks.
+    const int64_t pause_tid = g_pause_handler_for_tid.load(std::memory_order_acquire);
+    if (pause_tid != 0) {
+        const int64_t self_tid = static_cast<int64_t>(syscall(SYS_gettid));
+        if (self_tid == pause_tid) {
+            while (g_pause_handler_for_tid.load(std::memory_order_acquire) == pause_tid) {
+                // Busy-wait; the test clears the flag from another thread.
+            }
+        }
+    }
+
+    const int64_t start_ns = monotonic_ns();
+#if defined(__x86_64__)
+    auto* context = static_cast<ucontext_t*>(raw_context);
+    uintptr_t pc = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RIP]);
+    uintptr_t rbp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RBP]);
+    // Reason: capture the starting RBP once so the bounds check measures
+    // against a fixed anchor as `rbp` walks up the chain.
+    const uintptr_t initial_rbp = rbp;
+    const int max_frames = slot.max_frames;
+    const uintptr_t max_stack_bytes = slot.max_stack_bytes;
+
+    int n = 0;
+    // 4. The interrupted instruction pointer is frame 0.
+    if (pc != 0 && n < max_frames) {
+        slot.frames[n++] = pc;
+    }
+    // 5. Walk the saved-RBP chain: [rbp] is the caller's rbp; [rbp+8] is
+    //    its return pc. `rbp_can_read` enforces alignment and the
+    //    max_stack_bytes window from the anchor; `page_is_mapped` then
+    //    refuses to dereference an unmapped page (the codex-flagged
+    //    junk-RBP guard).
+    while (n < max_frames && rbp_can_read(initial_rbp, rbp, max_stack_bytes) &&
+           page_is_mapped(rbp)) {
+        const uintptr_t next_rbp = *reinterpret_cast<const uintptr_t*>(rbp);
+        const uintptr_t ret = *reinterpret_cast<const uintptr_t*>(rbp + sizeof(uintptr_t));
+        if (ret != 0) {
+            slot.frames[n++] = ret;
+        }
+        if (next_rbp <= rbp || !rbp_can_read(initial_rbp, next_rbp, max_stack_bytes) ||
+            !page_is_mapped(next_rbp)) {
+            break;
+        }
+        rbp = next_rbp;
+    }
+    slot.frame_count = n;
+    slot.truncated = n >= max_frames && rbp_can_read(initial_rbp, rbp, max_stack_bytes) &&
+                     page_is_mapped(rbp);
+#else
+    slot.frame_count = 0;
+#endif
+    const int64_t end_ns = monotonic_ns();
+    if (start_ns > 0 && end_ns >= start_ns) {
+        slot.handler_ns.store(end_ns - start_ns, std::memory_order_relaxed);
+    }
+
+    // 6. Publish DONE if the dump still wants us; otherwise release the
+    //    slot so a future coordinator can reclaim it. Either way we leave
+    //    state != WALKING so the coordinator's drain loop can break.
+    if (seq == slot.expected_seq.load(std::memory_order_acquire)) {
+        slot.state.store(SLOT_DONE, std::memory_order_release);
+    } else {
+        slot.state.store(SLOT_IDLE, std::memory_order_release);
+    }
+    errno = saved_errno;
+}
+
+void install_handler_once() {
+    std::call_once(g_install_once, [] {
+        const long page_size = sysconf(_SC_PAGESIZE);
+        g_page_size.store(page_size > 0 ? page_size : 4096,
+                          std::memory_order_release);
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            g_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack signal handler: " << std::strerror(errno);
+        }
+    });
+}
+
+// Reason: the per-thread `CaptureFn` `run_collection` drives. Claims a
+// per-sequence slot, queues the signal, polls the slot until the handler
+// publishes or the deadline expires, then copies the frames out. On
+// timeout it drains briefly so a late handler can transition out of
+// WALKING before the slot is reported leaked.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:381-384
+//   (sequential per-thread signaling).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:293-309
+//   (fresh `req_id`, queue `SI_QUEUE` with `sival_ptr` token).
+void fp_walk_capture(int64_t tid, const CollectOptions& opts,
+                     std::chrono::steady_clock::time_point deadline, ThreadStack* out) {
+    // 0. Defense-in-depth deadline guard. `run_collection` is supposed
+    //    to short-circuit expired deadlines before reaching here, but a
+    //    direct caller (or a future orchestration change) that skipped
+    //    the guard would otherwise queue a signal the wait loop has no
+    //    time to receive — creating exactly the stale-handler hazard
+    //    the per-sequence slot was added to defend against.
+    if (std::chrono::steady_clock::now() >= deadline) {
+        out->status = "timeout";
+        out->error_reason = "dump deadline expired before signaling this thread";
+        return;
+    }
+
+    // 1. A thread that blocks the signal is reported as such, not as a timeout.
+    if (is_signal_blocked(tid, native_stack_signal_number())) {
+        out->status = "signal_blocked";
+        out->error_reason = "thread blocks the native stack signal";
+        return;
+    }
+    install_handler_once();
+    if (!g_installed.load(std::memory_order_acquire)) {
+        out->status = "signal_failed";
+        out->error_reason = "native stack signal handler is unavailable";
+        return;
+    }
+
+    // 2. Claim a per-sequence slot via CAS IDLE -> PENDING. Failure means a
+    //    late handler from seq-N still holds this slot.
+    const uint64_t seq = g_seq.fetch_add(1, std::memory_order_relaxed) + 1;
+    CaptureSlot& slot = slot_for_seq(seq);
+    int expected_state = SLOT_IDLE;
+    if (!slot.state.compare_exchange_strong(expected_state, SLOT_PENDING,
+                                            std::memory_order_acq_rel)) {
+        out->status = "slot_busy";
+        out->error_reason = "fp-walk slot held by a late handler from a prior dump";
+        return;
+    }
+    slot.max_frames = static_cast<int>(std::min<int64_t>(opts.max_frames, kMaxSignalFrames));
+    slot.max_stack_bytes = static_cast<uintptr_t>(opts.max_stack_bytes);
+    slot.frame_count = 0;
+    slot.truncated = false;
+    slot.handler_ns.store(0, std::memory_order_relaxed);
+    // Reason: the release on expected_seq publishes all the slot setup
+    // above so the handler's acquire load on expected_seq sees a fully
+    // initialized slot.
+    slot.expected_seq.store(seq, std::memory_order_release);
+
+    // 3. Queue the signal with the token in si_value (SI_QUEUE, this process).
+    siginfo_t info {};
+    info.si_signo = native_stack_signal_number();
+    info.si_code = SI_QUEUE;
+    info.si_pid = getpid();
+    info.si_uid = getuid();
+    info.si_value.sival_ptr = reinterpret_cast<void*>(static_cast<uintptr_t>(seq));
+    const long rc = syscall(SYS_rt_tgsigqueueinfo, getpid(), static_cast<pid_t>(tid),
+                            native_stack_signal_number(), &info);
+    if (rc != 0) {
+        const int err = errno;
+        // Disarm so a still-queued late signal (rare with ESRCH path) gates out.
+        slot.expected_seq.store(0, std::memory_order_release);
+        int from = SLOT_PENDING;
+        slot.state.compare_exchange_strong(from, SLOT_IDLE, std::memory_order_acq_rel);
+        out->status = err == ESRCH ? "exited_thread" : "signal_failed";
+        out->error_reason = std::string("rt_tgsigqueueinfo failed: ") + std::strerror(err);
+        return;
+    }
+
+    // 4. Wait for the handler to publish DONE, or for the dump deadline.
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (slot.state.load(std::memory_order_acquire) == SLOT_DONE) {
+            break;
+        }
+        // Reason: the coordinator must wait for the handler to publish.
+        // 200 microseconds polls often enough to keep the next thread
+        // moving without burning a core on a busy yield. CK waits on a
+        // pipe; OB waits with `wait_readable`; fp-walk polls so the wait
+        // stays signal-safe-symmetric with the handler's atomic publish.
