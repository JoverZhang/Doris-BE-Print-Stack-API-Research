+#include <thread>
 
 #include "service/http/action/native_stack.h"
 
-// Reason: the per-variant collect step. The common build ships this stub;
-// each variant patch (fp-walk, ck-phdr-unwind, ...) rewrites only this file
-// with its real collector, so every other file in the seam stays put.
-// Spec: docs/phase2-design.md "Common API" -> stub collect().
+// Reason: the fp-walk variant of the common collector seam. The per-thread
+// capture interrupts the target with a queued realtime signal, then walks the
+// saved-RBP chain from `ucontext_t` inside the handler. fp-walk runs no
+// libunwind and overrides no `dl_iterate_phdr`, so the allocator path never
+// collides with the handler.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
 namespace doris::native_stack {
 namespace {
 
-// Reason: the stub proves the response shape and the single-dump gate
-// without real signaling — every live thread reports `ok` with no frames.
-// run_collection owns the gate, tid selection, and aggregation, so the stub
-// only fills status.
-void stub_capture(int64_t /*tid*/, const CollectOptions& /*opts*/,
-                  std::chrono::steady_clock::time_point /*deadline*/, ThreadStack* out) {
-    out->status = "ok";
+// Reason: a runaway frame walk would block the handler indefinitely. This
+// cap stops the walk and sizes the global slot's frame array.
+// Local: fp-walk-specific cap.
+constexpr int kMaxSignalFrames = 1024;
+
+// Reason: a realtime signal queues rather than coalesces, and `SI_QUEUE` lets
+// the sender attach a request token in `si_value`. SIGRTMIN+6 is the only
+// realtime slot the BE uses for stack dumps. CK uses `sival_int`; OB uses
+// `sival_ptr`. fp-walk follows OB so the token is wide enough for a 64-bit
+// monotonic sequence.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:131-134
+//   (sequence check on `sival_int`).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:304-309
+//   (queued `SI_QUEUE` with `sival_ptr` request id).
+int native_stack_signal_number() {
+    return SIGRTMIN + 6;
+}
+
+int64_t monotonic_ns() {
+    timespec ts {};
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        return 0;
+    }
+    return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + static_cast<int64_t>(ts.tv_nsec);
+}
+
+enum SlotState : int { SLOT_IDLE = 0, SLOT_PENDING = 1, SLOT_DONE = 2 };
+
+// Reason: the handler needs somewhere to publish its captured frames. One
+// never-freed global slot is enough because the coordinator drives one
+// capture at a time; CK's `StackTrace stack_trace{NoCapture{}}` is the same
+// shape. NOTE: this struct alone does NOT make the handoff race-free against
+// a late handler that returns after its dump's deadline -- see
+// `native_stack_signal_handler` and `fp_walk_capture` for the token gate,
+// and thread #2 for the planned per-sequence slot that hardens it.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:103
+//   (the single global `stack_trace`).
+struct CaptureSlot {
+    // Reason: the token gates against late-handler writes from a finished dump.
+    // A non-matching seq aborts before any write to this slot.
+    std::atomic<uint64_t> expected_seq {0};
+    std::atomic<int> state {SLOT_IDLE};
+    int max_frames = 0;
+    uintptr_t max_stack_bytes = 0;
+    uintptr_t frames[kMaxSignalFrames] {};
+    int frame_count = 0;
+    bool truncated = false;
+    std::atomic<int64_t> handler_ns {0};
+};
+
+// Reason: the never-freed global slot referenced above. Lives for the
+// process lifetime, so a late handler that reaches the write step never
+// dereferences a dangling pointer -- the worst case is overwriting the
+// next dump's payload, which thread #2 hardens.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:103,381-384
+//   (single global slot; CK signals one thread at a time for the same reason).
+CaptureSlot g_slot;
+
+// Reason: a monotonic sequence number that rides in the signal payload as
+// the dump's request token. The handler matches it against `expected_seq`
+// before writing. CK uses `sequence_num` the same way; OB calls it `req_id`.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:131-134
+//   (handler checks `sival_int` against `sequence_num`).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:293-307
+//   (atomic `req_id` queued as `sival_ptr`).
+std::atomic<uint64_t> g_seq {0};
+
+std::once_flag g_install_once;
+std::atomic<bool> g_installed {false};
+
+bool parse_hex_u64(const std::string& value, uint64_t* parsed) {
+    try {
+        size_t consumed = 0;
+        unsigned long long result = std::stoull(value, &consumed, 16);
+        if (consumed != value.size()) {
+            return false;
+        }
+        *parsed = static_cast<uint64_t>(result);
+        return true;
+    } catch (const std::exception&) {
+        return false;
+    }
+}
+
+// Reason: a thread that blocks the collector signal would never run the
+// handler. Report it as `signal_blocked` so the dump distinguishes it from
+// a slow thread that should time out.
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:294-326
+//   (CK's `isSignalBlocked` reads `SigBlk:` from /proc the same way).
+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
+
+// Reason: a corrupt or hostile RBP chain would otherwise read past the
+// stack and could crash the process. Every read must stay aligned and
+// inside the window `[initial_rbp, initial_rbp + max_stack_bytes)`.
+// NOTE: this bounds reads against the captured `initial_rbp` from
+// `ucontext_t`. If `initial_rbp` is itself outside the thread's mapped
+// stack (a signal that interrupts a function prologue, jitted code, or a
+// corrupted frame) the first read can still crash. Thread #2 will validate
+// `initial_rbp` against `/proc/self/maps` before the walk.
+// Local: fp-walk-specific safety check.
+bool rbp_can_read(uintptr_t initial_rbp, uintptr_t rbp, uintptr_t max_stack_bytes) {
+    constexpr uintptr_t kReadBytes = static_cast<uintptr_t>(2U * sizeof(uintptr_t));
+    if (initial_rbp == 0 || rbp < initial_rbp || max_stack_bytes < kReadBytes) {
+        return false;
+    }
+    if (rbp - initial_rbp > max_stack_bytes - kReadBytes) {
+        return false;
+    }
+    return rbp % alignof(uintptr_t) == 0;
+}
+
+// Reason: the realtime-signal handler. It validates the sender and the
+// request token, walks the RBP chain into the global slot, records handler
+// time, and restores `errno`. The double token check (entry and pre-publish)
+// is the spec's mechanism for dropping a late handler whose dump has already
+// timed out.
+//
+// NOTE: the double check does NOT prove no late-handler corruption of the
+// next dump's slot. The walk loop writes into `g_slot.frames[]` before the
+// re-check; if the next dump arms the slot while this handler is still
+// walking, those mid-walk writes can clobber the new dump's payload even
+// though the SLOT_DONE store is suppressed. Thread #2 addresses this with
+// a per-sequence slot.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:123,128-134,180
+//   (errno save/restore, `si_pid` sender check, `sival_int` token check).
+void native_stack_signal_handler(int /*sig*/, siginfo_t* info, void* raw_context) {
+    const int saved_errno = errno;
+
+    // 1. Ignore any signal this process did not queue for a dump.
+    if (info == nullptr || info->si_code != SI_QUEUE || info->si_pid != getpid()) {
+        errno = saved_errno;
+        return;
+    }
+    // 2. Drop a handler whose request token no longer matches the live dump.
+    const uint64_t seq = reinterpret_cast<uintptr_t>(info->si_value.sival_ptr);
+    if (seq != g_slot.expected_seq.load(std::memory_order_acquire)) {
+        errno = saved_errno;
+        return;
+    }
+
+    const int64_t start_ns = monotonic_ns();
+#if defined(__x86_64__)
+    auto* context = static_cast<ucontext_t*>(raw_context);
+    uintptr_t pc = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RIP]);
+    uintptr_t rbp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RBP]);
+    // Reason: capture the starting RBP once so the bounds check measures
+    // against a fixed anchor as `rbp` walks up the chain.
+    const uintptr_t initial_rbp = rbp;
+    const int max_frames = g_slot.max_frames;
+    const uintptr_t max_stack_bytes = g_slot.max_stack_bytes;
+
+    int n = 0;
+    // 3. The interrupted instruction pointer is frame 0.
+    if (pc != 0 && n < max_frames) {
+        g_slot.frames[n++] = pc;
+    }
+    // 4. Walk the saved-RBP chain: [rbp] is the caller's rbp; [rbp+8] is its
+    //    return pc. Bounded by `rbp_can_read` and `kMaxSignalFrames`.
+    while (n < max_frames && rbp_can_read(initial_rbp, rbp, max_stack_bytes)) {
+        const uintptr_t next_rbp = *reinterpret_cast<const uintptr_t*>(rbp);
+        const uintptr_t ret = *reinterpret_cast<const uintptr_t*>(rbp + sizeof(uintptr_t));
+        if (ret != 0) {
+            g_slot.frames[n++] = ret;
+        }
+        if (next_rbp <= rbp || !rbp_can_read(initial_rbp, next_rbp, max_stack_bytes)) {
+            break;
+        }
+        rbp = next_rbp;
+    }
+    g_slot.frame_count = n;
+    g_slot.truncated = n >= max_frames && rbp_can_read(initial_rbp, rbp, max_stack_bytes);
+#else
+    g_slot.frame_count = 0;
+#endif
+    const int64_t end_ns = monotonic_ns();
+    if (start_ns > 0 && end_ns >= start_ns) {
+        g_slot.handler_ns.store(end_ns - start_ns, std::memory_order_relaxed);
+    }
+
+    // 5. Re-check the token before publishing SLOT_DONE: if the dump moved
+    //    on while we walked, suppress the state store. The earlier writes
+    //    to `frames[]` and `frame_count` are NOT suppressed; thread #2
+    //    will fix this by giving each sequence its own slot.
+    if (seq == g_slot.expected_seq.load(std::memory_order_acquire)) {
+        g_slot.state.store(SLOT_DONE, std::memory_order_release);
+    }
+    errno = saved_errno;
+}
+
+void install_handler_once() {
+    std::call_once(g_install_once, [] {
+        struct sigaction action {};
+        sigemptyset(&action.sa_mask);
+        action.sa_sigaction = native_stack_signal_handler;
+        action.sa_flags = SA_SIGINFO | SA_RESTART;
+        if (sigaction(native_stack_signal_number(), &action, nullptr) == 0) {
+            g_installed.store(true, std::memory_order_release);
+        } else {
+            LOG(ERROR) << "failed to install native stack signal handler: " << std::strerror(errno);
+        }
+    });
+}
+
+// Reason: the per-thread `CaptureFn` `run_collection` drives. Arms the global
+// slot with a fresh token, queues the signal, polls until the handler
+// publishes or the deadline expires, and copies the frames out.
+//
+// The coordinator drives one capture at a time, so only one signal is ever
+// in flight. NOTE: this alone does NOT make the handoff safe against a late
+// handler that lands after this call returns -- the next call will re-arm
+// the same slot. The token gate in the handler suppresses the late
+// SLOT_DONE store but not the mid-walk frame writes. Thread #2 hardens
+// this; thread #3 documents the gap.
+// Spec: docs/phase2-design.md "Variant Mechanics -> fp-walk".
+// Reference: <ck>/src/Storages/System/StorageSystemStackTrace.cpp:381-384
+//   (sequential per-thread signaling).
+// Reference: <ob>/deps/oblib/src/lib/signal/ob_signal_worker.cpp:293-309
+//   (fresh `req_id`, queue `SI_QUEUE` with `sival_ptr` token).
+void fp_walk_capture(int64_t tid, const CollectOptions& opts,
+                     std::chrono::steady_clock::time_point deadline, ThreadStack* out) {
+    // 1. A thread that blocks the signal is reported as such, not as a timeout.
+    if (is_signal_blocked(tid, native_stack_signal_number())) {
+        out->status = "signal_blocked";
+        out->error_reason = "thread blocks the native stack signal";
+        return;
+    }
+    install_handler_once();
+    if (!g_installed.load(std::memory_order_acquire)) {
+        out->status = "signal_failed";
+        out->error_reason = "native stack signal handler is unavailable";
+        return;
+    }
+
+    // 2. Arm the slot with a fresh request token before signaling.
+    const uint64_t seq = g_seq.fetch_add(1, std::memory_order_relaxed) + 1;
+    g_slot.max_frames = static_cast<int>(std::min<int64_t>(opts.max_frames, kMaxSignalFrames));
+    g_slot.max_stack_bytes = static_cast<uintptr_t>(opts.max_stack_bytes);
+    g_slot.frame_count = 0;
+    g_slot.truncated = false;
+    g_slot.handler_ns.store(0, std::memory_order_relaxed);
+    g_slot.state.store(SLOT_PENDING, std::memory_order_release);
+    g_slot.expected_seq.store(seq, std::memory_order_release);
+
+    // 3. Queue the signal with the token in si_value (SI_QUEUE, this process).
+    siginfo_t info {};
+    info.si_signo = native_stack_signal_number();
+    info.si_code = SI_QUEUE;
+    info.si_pid = getpid();
+    info.si_uid = getuid();
+    info.si_value.sival_ptr = reinterpret_cast<void*>(static_cast<uintptr_t>(seq));
+    const long rc = syscall(SYS_rt_tgsigqueueinfo, getpid(), static_cast<pid_t>(tid),
+                            native_stack_signal_number(), &info);
+    if (rc != 0) {
+        const int err = errno;
+        g_slot.expected_seq.store(0, std::memory_order_release);
+        out->status = err == ESRCH ? "exited_thread" : "signal_failed";
+        out->error_reason = std::string("rt_tgsigqueueinfo failed: ") + std::strerror(err);
+        return;
+    }
+
+    // 4. Wait for the handler to publish, or for the dump deadline.
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (g_slot.state.load(std::memory_order_acquire) == SLOT_DONE) {
+            break;
+        }
+        // Reason: the coordinator must wait for the handler to publish.
+        // 200 microseconds polls often enough to keep the next thread moving
+        // without burning a core on a busy yield. CK waits on a pipe; OB
+        // waits with `wait_readable`; fp-walk polls so the wait stays
+        // signal-safe-symmetric with the handler's atomic publish.
+        // Local: fp-walk-specific cadence. No CK or OB precedent.
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+
+    // 5. Read the frames, or disarm the token so a late handler drops on
+    //    its entry check.
+    if (g_slot.state.load(std::memory_order_acquire) == SLOT_DONE) {
+        out->frames.reserve(static_cast<size_t>(g_slot.frame_count));
+        for (int i = 0; i < g_slot.frame_count; ++i) {
+            Frame frame;
+            frame.pc = g_slot.frames[i];
+            out->frames.push_back(frame);
+        }
+        out->truncated = g_slot.truncated;
+        out->handler_time_ns = g_slot.handler_ns.load(std::memory_order_relaxed);
+        out->status = "ok";
+    } else {
+        g_slot.expected_seq.store(0, std::memory_order_release);
+        out->status = "timeout";
+        out->error_reason = "thread did not run the native stack handler before the deadline";
+    }
 }
 
 } // namespace
 
 NativeStackReport collect_native_stacks(const CollectOptions& opts) {
-    return run_collection(opts, "stub", stub_capture);
+    return run_collection(opts, "fp-walk", fp_walk_capture);
 }
 
 } // namespace doris::native_stack
