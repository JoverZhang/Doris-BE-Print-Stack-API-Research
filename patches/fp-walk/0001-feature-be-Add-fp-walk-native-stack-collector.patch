+bool is_signal_blocked(int64_t tid, int signal_number) {
+    if (signal_number <= 0 || signal_number > 64) {
+        return false;
+    }
+
+    std::ifstream status("/proc/self/task/" + std::to_string(tid) + "/status");
+    std::string line;
+    while (std::getline(status, line)) {
+        constexpr char kSigBlkPrefix[] = "SigBlk:";
+        if (line.rfind(kSigBlkPrefix, 0) != 0) {
+            continue;
+        }
+
+        std::istringstream iss(line.substr(sizeof(kSigBlkPrefix) - 1));
+        std::string hex_mask;
+        if (!(iss >> hex_mask)) {
+            return false;
+        }
+        uint64_t mask = 0;
+        if (!parse_hex_u64(hex_mask, &mask)) {
+            return false;
+        }
+        return (mask & (uint64_t {1} << (signal_number - 1))) != 0;
+    }
+    return false;
+}
+
+std::string trim_left_spaces(std::string value) {
+    const size_t first = value.find_first_not_of(' ');
+    if (first == std::string::npos) {
+        return "";
+    }
+    return value.substr(first);
+}
+
+std::vector<MemoryMap> load_memory_maps() {
+    std::vector<MemoryMap> maps;
+    std::ifstream input("/proc/self/maps");
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream iss(line);
+        std::string range;
+        std::string perms;
+        std::string offset_hex;
+        std::string dev;
+        std::string inode;
+        if (!(iss >> range >> perms >> offset_hex >> dev >> inode)) {
+            continue;
+        }
+        const size_t dash = range.find('-');
+        if (dash == std::string::npos) {
+            continue;
+        }
+
+        MemoryMap map;
+        if (!parse_hex_uintptr(range.substr(0, dash), &map.start) ||
+            !parse_hex_uintptr(range.substr(dash + 1), &map.end) ||
+            !parse_hex_uintptr(offset_hex, &map.offset) || map.start >= map.end) {
+            continue;
+        }
+
+        std::string path;
+        std::getline(iss, path);
+        map.path = trim_left_spaces(path);
+        maps.emplace_back(std::move(map));
+    }
+    return maps;
+}
+
+const MemoryMap* find_map_for_pc(const std::vector<MemoryMap>& maps, uintptr_t pc) {
+    for (const MemoryMap& map : maps) {
+        if (pc >= map.start && pc < map.end) {
+            return &map;
+        }
+    }
+    return nullptr;
+}
+
+std::string hex_uintptr(uintptr_t value) {
+    std::ostringstream out;
+    out << "0x" << std::hex << value;
+    return out.str();
+}
