alloy_pyroscope_ebpf_metrics:
# HELP pyroscope_ebpf_active_targets Current number of active targets being tracked by the ebpf component
# TYPE pyroscope_ebpf_active_targets gauge
pyroscope_ebpf_active_targets{component_id="pyroscope.ebpf.target",component_path="/"} 0
# HELP pyroscope_ebpf_debug_info_upload_bytes_total Total number of bytes uploaded to the debug info endpoint
# TYPE pyroscope_ebpf_debug_info_upload_bytes_total counter
pyroscope_ebpf_debug_info_upload_bytes_total{component_id="pyroscope.write.local",component_path="/"} 0
# HELP pyroscope_ebpf_pprof_bytes_total Total number of pprof profiles collected by the ebpf component
# TYPE pyroscope_ebpf_pprof_bytes_total counter
pyroscope_ebpf_pprof_bytes_total{component_id="pyroscope.ebpf.target",component_path="/",service_name="scheme-ebpf-shared-profile-target"} 7217
# HELP pyroscope_ebpf_pprof_samples_total Total number of pprof profiles collected by the ebpf component
# TYPE pyroscope_ebpf_pprof_samples_total counter
pyroscope_ebpf_pprof_samples_total{component_id="pyroscope.ebpf.target",component_path="/",service_name="scheme-ebpf-shared-profile-target"} 7217
# HELP pyroscope_ebpf_pprofs_dropped_total Total number of pprof profiles dropped by the ebpf component
# TYPE pyroscope_ebpf_pprofs_dropped_total counter
pyroscope_ebpf_pprofs_dropped_total{component_id="pyroscope.ebpf.target",component_path="/"} 0
# HELP pyroscope_ebpf_pprofs_total Total number of pprof profiles collected by the ebpf component
# TYPE pyroscope_ebpf_pprofs_total counter
pyroscope_ebpf_pprofs_total{component_id="pyroscope.ebpf.target",component_path="/",service_name="scheme-ebpf-shared-profile-target"} 3
# HELP pyroscope_ebpf_profiling_sessions_failing_total Total number of profiling sessions failed to complete by the ebpf component
# TYPE pyroscope_ebpf_profiling_sessions_failing_total counter
pyroscope_ebpf_profiling_sessions_failing_total{component_id="pyroscope.ebpf.target",component_path="/"} 0
# HELP pyroscope_ebpf_profiling_sessions_total Total number of profiling sessions started by the ebpf component
# TYPE pyroscope_ebpf_profiling_sessions_total counter
pyroscope_ebpf_profiling_sessions_total{component_id="pyroscope.ebpf.target",component_path="/"} 1
# HELP pyroscope_write_sent_profiles_total Total number of profiles sent to Pyroscope.
# TYPE pyroscope_write_sent_profiles_total counter
pyroscope_write_sent_profiles_total{component_id="pyroscope.write.local",component_path="/",endpoint="http://127.0.0.1:4040"} 3

