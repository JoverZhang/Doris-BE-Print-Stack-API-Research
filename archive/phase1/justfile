set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set positional-arguments := true

root := justfile_directory() + "/../.."

default:
    @just --list

validate:
    cd "{{root}}" && just repos-check
    cd "{{root}}" && cmake --preset debug >/dev/null
    cd "{{root}}" && cmake --build --preset debug --target stacktrace_minimal_impls stacktrace_risk_cases

cmake-configure:
    cd "{{root}}" && cmake --preset debug

cmake-build:
    cd "{{root}}" && cmake --build --preset debug --target stacktrace_minimal_impls

all-minimal:
    cd "{{root}}" && just phase1 cmake-build
    cd "{{root}}" && ./archive/phase1/schemes/ck-system-stack-trace/minimal_impl/default/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/ck-system-stack-trace/minimal_impl/fp-build/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/inprocess-minidump/minimal_impl/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/ob-observer-kill60/minimal_impl/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/ob-open-obstack-ptrace/minimal_impl/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/ebpf-perf-bpftrace/minimal_impl/run.sh
    cd "{{root}}" && ./archive/phase1/schemes/ebpf-alloy-pyroscope/minimal_impl/run.sh

risk-unwind-without-phdr-cache:
    cd "{{root}}" && ./archive/phase1/risk_cases/ck_unwind_without_phdr_cache/run.sh

ck-system-stack-trace:
    cd "{{root}}" && ./archive/phase1/schemes/ck-system-stack-trace/run.sh

ck-query-profiler-trace-log:
    cd "{{root}}" && ./archive/phase1/schemes/ck-query-profiler-trace-log/run.sh

inprocess-minidump:
    cd "{{root}}" && ./archive/phase1/schemes/inprocess-minidump/run.sh

ob-observer-kill60:
    cd "{{root}}" && ./archive/phase1/schemes/ob-observer-kill60/run.sh

ob-open-obstack-ptrace:
    cd "{{root}}" && ./archive/phase1/schemes/ob-open-obstack-ptrace/run.sh

ebpf-perf-bpftrace:
    cd "{{root}}" && ./archive/phase1/schemes/ebpf-perf-bpftrace/run.sh

ebpf-alloy-pyroscope:
    cd "{{root}}" && ./archive/phase1/schemes/ebpf-alloy-pyroscope/run.sh

doris-poc-snapshot-unwind:
    cd "{{root}}" && ./archive/phase1/schemes/doris-poc-snapshot-unwind/run.sh

doris-poc-build:
    cd "{{root}}" && ./archive/phase1/schemes/doris-poc-snapshot-unwind/build.sh

all-evidence:
    cd "{{root}}" && \
      if [[ "$${RUN_HEAVY_EVIDENCE:-0}" != "1" ]]; then \
        echo "Refusing to rerun heavyweight Phase 1 evidence by default."; \
        echo "Use RUN_HEAVY_EVIDENCE=1 just phase1 all-evidence when you explicitly want CK/OB/eBPF project runs."; \
        exit 2; \
      fi
    cd "{{root}}" && just phase1 ck-system-stack-trace
    cd "{{root}}" && just phase1 ck-query-profiler-trace-log
    cd "{{root}}" && just phase1 inprocess-minidump
    cd "{{root}}" && just phase1 ob-observer-kill60
    cd "{{root}}" && just phase1 ob-open-obstack-ptrace
    cd "{{root}}" && just phase1 ebpf-perf-bpftrace
    cd "{{root}}" && just phase1 ebpf-alloy-pyroscope

all-phase1:
    @echo "all-phase1 runs archived lightweight repo-owned minimal implementations only."
    @echo "Use RUN_HEAVY_EVIDENCE=1 just phase1 all-evidence for heavyweight source-project evidence reruns."
    cd "{{root}}" && just phase1 all-minimal

vm-create:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/create.sh

vm-start:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/start.sh

vm-start-bg:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/start_bg.sh

vm-wait-ssh:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/wait_ssh.sh

vm-ssh *args:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/ssh.sh "$@"

vm-stop:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/stop.sh

vm-destroy:
    cd "{{root}}" && ./archive/phase1/vm/ubuntu-24.04/destroy.sh
