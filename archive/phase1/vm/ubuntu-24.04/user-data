#cloud-config
# Reference template. create.sh generates user-data.generated with a real SSH key.
users:
  - name: repro
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - REPLACE_WITH_PUBLIC_KEY
ssh_pwauth: false
write_files:
  - path: /etc/sysctl.d/99-stacktrace-repro.conf
    permissions: "0644"
    content: |
      kernel.perf_event_paranoid=-1
      kernel.kptr_restrict=0
package_update: true
packages:
  - build-essential
  - git
  - curl
  - ca-certificates
  - linux-tools-generic
  - linux-tools-common
  - bpftrace
  - clang
  - llvm
  - elfutils
  - jq
  - just
runcmd:
  - sysctl --system
