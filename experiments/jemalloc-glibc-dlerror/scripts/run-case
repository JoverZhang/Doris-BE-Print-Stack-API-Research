#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$script_dir/.." && pwd)
results="$root/results"

die() {
    echo "$*" >&2
    exit 2
}

usage() {
    die "usage: scripts/run-case <case> <ubuntu-version> <backend> <profiling> <expected>"
}

validate_args() {
    [[ $# -eq 5 ]] || usage

    case_id=$1
    image=$2
    backend=$3
    profiling=$4
    expected=$5
    timeout_seconds=${TIMEOUT_SECONDS:-8}

    case "$case_id" in
        A|B|C|D) ;;
        *) die "case must be A, B, C, or D" ;;
    esac
    case "$image" in
        20.04|24.04) ;;
        *) die "ubuntu version must be 20.04 or 24.04" ;;
    esac
    case "$backend" in
        libgcc|llvm-libunwind) ;;
        *) die "backend must be libgcc or llvm-libunwind" ;;
    esac
    case "$profiling" in
        on|off) ;;
        *) die "profiling must be on or off" ;;
    esac
    case "$expected" in
        deadlock|completed) ;;
        *) die "expected must be deadlock or completed" ;;
    esac
}

prepare_paths() {
    build_dir="$root/.build/cmake-$image"
    prefix="$build_dir/deps/jemalloc-$backend"
    wrapper="$build_dir/out/$backend/libphdr_wrap.so"
    repro="$build_dir/out/$backend/repro"
    raw_dir="$results/raw/$case_id"
    bt_file="$raw_dir/gdb-bt.txt"

    [[ -x "$repro" && -f "$wrapper" && -f "$prefix/lib/libjemalloc.so" ]] ||
        die "missing build artifacts for backend=$backend in ubuntu:$image"
}

prepare_raw_dir() {
    rm -rf "$raw_dir"
    mkdir -p "$raw_dir"
}

malloc_conf() {
    if [[ "$profiling" == on ]]; then
        echo "prof:true,prof_active:true,lg_prof_sample:0,prof_prefix:$raw_dir/jeprof"
    else
        echo "prof:false"
    fi
}

run_repro_with_timeout() {
    local pid deadline timed_out conf

    conf=$(malloc_conf)
    set +e
    env LD_PRELOAD="$wrapper:$prefix/lib/libjemalloc.so" MALLOC_CONF="$conf" \
        "$repro" >"$raw_dir/stdout.log" 2>"$raw_dir/stderr.log" &
    pid=$!
    deadline=$((SECONDS + timeout_seconds))
    timed_out=0
    while kill -0 "$pid" 2>/dev/null; do
        (( SECONDS < deadline )) || { timed_out=1; break; }
        sleep 0.1
    done

    if (( timed_out == 1 )); then
        gdb -batch -p "$pid" -ex "set pagination off" -ex "thread apply all bt" >"$bt_file" 2>&1
        kill -TERM "$pid" 2>/dev/null
        sleep 0.2
        kill -KILL "$pid" 2>/dev/null
        wait "$pid" >/dev/null 2>&1
        rc=124
        observed=deadlock
    else
        wait "$pid"
        rc=$?
        [[ "$rc" == 0 ]] && observed=completed || observed="failed($rc)"
    fi
    set -e
}

detect_stack_shape() {
    stack_shape=no
    if [[ -f "$bt_file" ]] && grep -q "malloc_init_hard" "$bt_file" \
        && grep -q "_Unwind_Backtrace" "$bt_file" \
        && grep -q "dl_iterate_phdr" "$bt_file" \
        && grep -Eq "dlsym|_dlerror_run" "$bt_file"; then
        stack_shape=yes
    fi
    return 0
}

decide_verdict() {
    verdict=fail
    [[ "$expected" == deadlock && "$observed" == deadlock && "$stack_shape" == yes ]] && verdict=pass
    [[ "$expected" == completed && "$observed" == completed ]] && verdict=pass
    return 0
}

write_case_summary() {
    local summary="$results/$case_id.md"

    cat >"$summary" <<EOF
# Case $case_id
- image: ubuntu:$image
- jemalloc backend: $backend
- profiling: $profiling
- expected: $expected
- observed: $observed
- exit code: $rc
- stack shape: $stack_shape
- verdict: $verdict
- raw logs: results/raw/$case_id/
EOF
    if [[ "$stack_shape" == yes ]]; then
        echo "- stack excerpt:" >>"$summary"
        grep -E "malloc_init_hard|prof_boot|prof_unwind_init|_Unwind_Backtrace|dl_iterate_phdr|dlsym|_dlerror_run|calloc|malloc" "$bt_file" \
            | sed -n '1,14p' | sed 's/^/  - /' >>"$summary"
    fi
}

print_case_result() {
    printf '%s|%s|%s|%s\n' "$case_id" "$expected" "$observed" "$verdict"
}

main() {
    validate_args "$@"
    prepare_paths
    prepare_raw_dir
    run_repro_with_timeout
    detect_stack_shape
    decide_verdict
    write_case_summary
    print_case_result
    [[ "$verdict" == pass ]]
}

main "$@"
