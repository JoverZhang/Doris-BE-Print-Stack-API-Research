#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$script_dir/.." && pwd)
jobs=${BUILD_JOBS:-$(nproc)}
cc_cmd=${CC:-cc}

jemalloc_src="$root/deps/jemalloc"
libunwind_src="$root/deps/libunwind"

die() {
    echo "$*" >&2
    exit 2
}

usage() {
    die "usage: scripts/build <jemalloc|libunwind|repro> <ubuntu-version> [backend]"
}

require_image() {
    case "${1:-}" in
        20.04|24.04) ;;
        *) die "ubuntu version must be 20.04 or 24.04" ;;
    esac
}

require_backend() {
    case "${1:-}" in
        libgcc|libunwind) ;;
        *) die "backend must be libgcc or libunwind" ;;
    esac
}

require_jemalloc_source() {
    [[ -x "$jemalloc_src/autogen.sh" ]] ||
        die "missing jemalloc submodule: $jemalloc_src"
}

require_libunwind_source() {
    [[ -f "$libunwind_src/configure.ac" ]] ||
        die "missing libunwind submodule: $libunwind_src"
}

build_dir() {
    echo "$root/.build/ubuntu-$1"
}

checked_build_dir() {
    require_image "$1"
    build_dir "$1"
}

verify_jemalloc_log() {
    local log=$1 prof_libunwind=$2 prof_libgcc=$3

    grep -q "prof[[:space:]]*: 1" "$log"
    grep -q "prof-libunwind[[:space:]]*: $prof_libunwind" "$log"
    grep -q "prof-libgcc[[:space:]]*: $prof_libgcc" "$log"
}

copy_source() {
    local src=$1 dest=$2

    rm -rf "$dest"
    mkdir -p "$dest"
    cp -R "$src/." "$dest/"
}

build_libunwind() {
    local image=$1 build prefix src_copy log

    require_libunwind_source
    build=$(checked_build_dir "$image")
    prefix="$build/deps/libunwind"
    src_copy="$build/src/libunwind"
    log="$build/logs/libunwind/configure.log"

    [[ -f "$prefix/lib/libunwind.a" && -f "$prefix/include/libunwind.h" ]] && return

    echo "build libunwind for ubuntu:$image"
    rm -rf "$prefix"
    mkdir -p "$(dirname "$log")"
    copy_source "$libunwind_src" "$src_copy"

    (
        cd "$src_copy"
        autoreconf -i
        CFLAGS="-O2 -fPIC" ./configure --prefix="$prefix" \
            --enable-static --disable-shared \
            --disable-documentation --disable-tests \
            --disable-minidebuginfo --disable-zlibdebuginfo | tee "$log"
    )
    make -C "$src_copy" -j "$jobs"
    make -C "$src_copy" install
    test -f "$prefix/lib/libunwind.a"
    test -f "$prefix/include/libunwind.h"
}

build_jemalloc() {
    local image=$1 backend=$2 build prefix src_copy log
    local libunwind_prefix archive
    local prof_libunwind prof_libgcc
    local configure_env=()
    local configure_args=()

    require_backend "$backend"
    require_jemalloc_source
    build=$(checked_build_dir "$image")
    prefix="$build/deps/jemalloc-$backend"
    src_copy="$build/src/jemalloc-$backend"
    log="$build/logs/$backend/jemalloc-configure.log"

    case "$backend" in
        libgcc)
            prof_libunwind=0
            prof_libgcc=1
            configure_args=(--disable-prof-gcc --disable-prof-libunwind)
            ;;
        libunwind)
            require_libunwind_source
            libunwind_prefix="$build/deps/libunwind"
            archive="$libunwind_prefix/lib/libunwind.a"
            [[ -f "$archive" ]] ||
                die "missing libunwind; run: scripts/build libunwind $image"
            prof_libunwind=1
            prof_libgcc=0
            configure_env=(
                "CPPFLAGS=-I$libunwind_prefix/include"
                "LDFLAGS=-L$libunwind_prefix/lib"
            )
            configure_args=(
                --disable-prof-gcc
                --enable-prof-libunwind
                --disable-prof-libgcc
                --with-static-libunwind="$archive"
            )
            ;;
    esac

    if [[ -f "$prefix/lib/libjemalloc.so" ]]; then
        verify_jemalloc_log "$log" "$prof_libunwind" "$prof_libgcc"
        return
    fi

    echo "build jemalloc for ubuntu:$image backend:$backend"
    rm -rf "$prefix"
    mkdir -p "$(dirname "$log")"
    copy_source "$jemalloc_src" "$src_copy"

    (
        cd "$src_copy"
        env "${configure_env[@]}" ./autogen.sh \
            --prefix="$prefix" \
            --enable-prof --enable-shared --disable-static \
            "${configure_args[@]}" | tee "$log"
    )
    make -C "$src_copy" -j "$jobs" build_lib_shared
    make -C "$src_copy" install_lib install_include
    verify_jemalloc_log "$log" "$prof_libunwind" "$prof_libgcc"
}

build_repro() {
    local image=$1 backend=$2 build out

    require_backend "$backend"
    build=$(checked_build_dir "$image")
    out="$build/out/$backend"

    echo "build repro for ubuntu:$image backend:$backend"
    mkdir -p "$out"
    "$cc_cmd" -fPIC -shared "$root/src/phdr_wrap.c" -o "$out/libphdr_wrap.so" -ldl
    "$cc_cmd" "$root/src/repro.c" -o "$out/repro"
}

cmd=${1:-}
shift || true

case "$cmd" in
    jemalloc)
        [[ $# -eq 2 ]] || usage
        build_jemalloc "$1" "$2"
        ;;
    libunwind)
        [[ $# -eq 1 ]] || usage
        build_libunwind "$1"
        ;;
    repro)
        [[ $# -eq 2 ]] || usage
        build_repro "$1" "$2"
        ;;
    *)
        usage
        ;;
esac
