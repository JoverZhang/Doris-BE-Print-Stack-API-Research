set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
    @just --list

case-A:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/container.sh
    image=$(build_image 20.04)
    # 1. Build jemalloc with profiling support and the libgcc unwind backend.
    run_in_image "$image" bash ./scripts/build jemalloc 20.04 libgcc
    # 2. Build the demo executable and dl_iterate_phdr wrapper.
    run_in_image "$image" bash ./scripts/build repro 20.04 libgcc
    # 3. Run with profiling on and capture the timeout/gdb result.
    run_in_image "$image" bash ./scripts/run-case A 20.04 libgcc on deadlock

case-B:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/container.sh
    image=$(build_image 20.04)
    # 1. Build the same libgcc-backed jemalloc as Case A.
    run_in_image "$image" bash ./scripts/build jemalloc 20.04 libgcc
    # 2. Build the same demo executable and wrapper as Case A.
    run_in_image "$image" bash ./scripts/build repro 20.04 libgcc
    # 3. Run with profiling off and capture the completion result.
    run_in_image "$image" bash ./scripts/run-case B 20.04 libgcc off completed

case-C:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/container.sh
    image=$(build_image 20.04)
    # 1. Build LLVM libunwind from the local submodule.
    run_in_image "$image" bash ./scripts/build llvm-libunwind 20.04
    # 2. Add the unw_backtrace compatibility object expected by jemalloc.
    run_in_image "$image" bash ./scripts/build libunwind-jemalloc-archive 20.04
    # 3. Build jemalloc with profiling support and the LLVM libunwind backend.
    run_in_image "$image" bash ./scripts/build jemalloc 20.04 llvm-libunwind
    # 4. Build the demo executable and dl_iterate_phdr wrapper.
    run_in_image "$image" bash ./scripts/build repro 20.04 llvm-libunwind
    # 5. Run with profiling on and capture the completion result.
    run_in_image "$image" bash ./scripts/run-case C 20.04 llvm-libunwind on completed

case-D:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/container.sh
    image=$(build_image 24.04)
    # 1. Build jemalloc with profiling support and the libgcc unwind backend.
    run_in_image "$image" bash ./scripts/build jemalloc 24.04 libgcc
    # 2. Build the demo executable and dl_iterate_phdr wrapper.
    run_in_image "$image" bash ./scripts/build repro 24.04 libgcc
    # 3. Run with profiling on under the newer glibc image and capture the result.
    run_in_image "$image" bash ./scripts/run-case D 24.04 libgcc on completed

matrix:
    #!/usr/bin/env bash
    set -euo pipefail
    just case-A
    just case-B
    just case-C
    just case-D
    printf '\n| Case | Expected | Observed | Verdict |\n'
    printf '|---|---|---|---|\n'
    for case_id in A B C D; do \
        expected=$(sed -n 's/^- expected: //p' "results/$case_id.md"); \
        observed=$(sed -n 's/^- observed: //p' "results/$case_id.md"); \
        verdict=$(sed -n 's/^- verdict: //p' "results/$case_id.md"); \
        printf '| %s | %s | %s | %s |\n' "$case_id" "$expected" "$observed" "$verdict"; \
    done

clean:
    rm -rf .build results/raw results/*.md
    mkdir -p results
    touch results/.gitkeep
