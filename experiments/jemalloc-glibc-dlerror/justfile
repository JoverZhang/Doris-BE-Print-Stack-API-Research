set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
    @just --list

build-jemalloc backend:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/lib/common.sh
    source scripts/lib/container.sh
    image=$(build_image 20.04)
    run_in_image "$image" bash ./scripts/build-jemalloc "{{backend}}"

case case_id:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/lib/common.sh
    source scripts/lib/container.sh
    read -r image backend profiling expected <<<"$(case_row "{{case_id}}")"
    tag=$(build_image "$image")
    run_in_image "$tag" bash ./scripts/build-jemalloc "$backend" >/dev/null
    run_in_image "$tag" bash ./scripts/run-case "{{case_id}}"

matrix:
    #!/usr/bin/env bash
    set -euo pipefail
    just case A
    just case B
    just case C
    just case D
    printf '\n| Case | Expected | Observed | Verdict |\n'
    printf '|---|---|---|---|\n'
    for case_id in A B C D; do \
        expected=$(sed -n 's/^- expected: //p' "results/$case_id.md"); \
        observed=$(sed -n 's/^- observed: //p' "results/$case_id.md"); \
        verdict=$(sed -n 's/^- verdict: //p' "results/$case_id.md"); \
        printf '| %s | %s | %s | %s |\n' "$case_id" "$expected" "$observed" "$verdict"; \
    done

clean:
    rm -rf .build .cache .deps results/raw results/*.md
    mkdir -p results
    touch results/.gitkeep
