      "preLaunchTask": "cmake: build minimal impls"
    },
    {
      "name": "CK no-FP unwind control",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/schemes/ck-system-stack-trace/minimal_impl/fp-build/build/fp_vs_unwind.no_fp",
      "args": [],
      "cwd": "${workspaceFolder}/schemes/ck-system-stack-trace/minimal_impl/fp-build",
      "preLaunchTask": "cmake: build minimal impls"
    },
    {
      "name": "OB kill -60 minimal",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/schemes/ob-observer-kill60/minimal_impl/build/observer_kill60_minimal",
      "args": [],
      "cwd": "${workspaceFolder}/schemes/ob-observer-kill60/minimal_impl",
