{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: build minimal impls",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug --target stacktrace_minimal_impls",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
